---
// fasteignaverd/index.astro — yfirlit allra 197 matssvæða HMS með Karp-miðgildi sl. 12 mán (kaupskrá) og
// opinberu meðalverði/breytingu fasteignamats 2027. Hver röð → /fasteignaverd/<slug>/. Sjá [slug].astro.
import Layout from '../../layouts/Layout.astro';
import MS from '../../../public/gogn/hms/matssvaedi_2027.json';
import ZS from '@gogn/matssvaedi_solur.json';
import { slugify, groupThousands } from '@lib/format.mjs';

const Z = ZS.byZone || {};
const rows = Object.entries(MS.svaedi).filter(([, v]) => v && v.heiti).map(([nr, v]) => ({ nr, heiti: v.heiti, slug: slugify(v.heiti), m2f: v.m2_fjol, m2s: v.m2_ser, brf: v.br_fjol, brs: v.br_ser, z: Z[nr] || null }))
  .sort((a, b) => ((b.z ? b.z.n12 : 0) - (a.z ? a.z.n12 : 0)) || a.heiti.localeCompare(b.heiti, 'is'));
const medSolum = rows.filter((r) => r.z && r.z.n12 > 0).length;
const pcS = (v) => (v == null ? '–' : (v >= 0 ? '+' : '−') + (Math.abs(v) * 100).toFixed(1).replace('.', ',') + '%');
const title = 'Fasteignaverð eftir matssvæðum HMS — 197 svæði | Karp';
const desc = `Fasteignaverð í öllum ${rows.length} matssvæðum HMS: miðgildi verðs á fermetra úr þinglýstum kaupum síðustu 12 mánaða (kaupskrá HMS), opinbert meðalverð og breyting fasteignamats 2027 per svæði.`;
---
<Layout title={title} description={desc} canonical="https://karp.is/fasteignaverd/">
  <main data-pg="fasteignaverd">
    <p class="kicker"><a href="/fasteignir/">Fasteignaverð</a> · Matssvæði HMS</p>
    <h1>Fasteignaverð eftir matssvæðum</h1>
    <p>HMS skiptir landinu í <strong>{rows.length} matssvæði íbúðarhúsnæðis</strong> þar sem verðlag er talið einsleitt. Hér er hvert svæði með <strong>lifandi miðgildi</strong> verðs á fermetra úr þinglýstum kaupum síðustu 12 mánaða (kaupskrá HMS, {medSolum} svæði með sölur) og <strong>opinberu meðalverði og breytingu fasteignamats 2027</strong>. Smelltu á svæði fyrir nýjustu sölur.</p>
    <div class="tw">
      <table>
        <thead><tr><th class="l">Matssvæði</th><th>Karp fjölbýli<br><small>þús/m² · 12 mán</small></th><th>Karp sérbýli<br><small>þús/m² · 12 mán</small></th><th>Sölur<br><small>12 mán</small></th><th>HMS 2027<br><small>fjölb. / sérb. þús/m²</small></th><th>Mat 2027<br><small>fjölb. / sérb.</small></th></tr></thead>
        <tbody>
          {rows.map((r) => (
            <tr>
              <td class="l"><a href={`/fasteignaverd/${r.slug}/`}>{r.heiti}</a></td>
              <td class="num">{r.z && r.z.medFjol ? groupThousands(r.z.medFjol) : '–'}</td>
              <td class="num">{r.z && r.z.medSer ? groupThousands(r.z.medSer) : '–'}</td>
              <td class="num">{r.z ? groupThousands(r.z.n12) : 0}</td>
              <td class="num">{r.m2f ? groupThousands(r.m2f) : '–'} / {r.m2s ? groupThousands(r.m2s) : '–'}</td>
              <td class="num"><span class={(r.brf || 0) >= 0 ? 'up' : 'dn'}>{pcS(r.brf)}</span> / <span class={(r.brs || 0) >= 0 ? 'up' : 'dn'}>{pcS(r.brs)}</span></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="note">ⓘ Karp-miðgildi = miðgildi kaupverðs á m² í þinglýstum kaupum sl. 12 mán, varpað á matssvæði út frá staðsetningu (heimilisföng við svæðamörk geta lent röngum megin). HMS-tölur = opinbert meðalverð á m² og breyting fasteignamats 2026→2027 úr útgáfu HMS um fasteignamat 2027. Raðað eftir fjölda sala.</p>
  </main>
</Layout>

<style>
  main[data-pg="fasteignaverd"] { max-width: 1080px; margin: 0 auto; padding: 18px 16px 48px; }
  main[data-pg="fasteignaverd"] .kicker { color: var(--faint); font-size: 12px; letter-spacing: .4px; text-transform: uppercase; }
  main[data-pg="fasteignaverd"] .kicker a { color: inherit; }
  main[data-pg="fasteignaverd"] .tw { overflow-x: auto; margin-top: 12px; }
  main[data-pg="fasteignaverd"] table { width: 100%; border-collapse: collapse; font-size: 13.5px; }
  main[data-pg="fasteignaverd"] th, main[data-pg="fasteignaverd"] td { padding: 6px 8px; border-bottom: 1px solid rgba(255,255,255,.07); text-align: right; white-space: nowrap; }
  main[data-pg="fasteignaverd"] th small { font-weight: 400; color: var(--faint); }
  main[data-pg="fasteignaverd"] th.l, main[data-pg="fasteignaverd"] td.l { text-align: left; white-space: normal; }
  main[data-pg="fasteignaverd"] td.l a { color: var(--ink); text-decoration: none; } main[data-pg="fasteignaverd"] td.l a:hover { text-decoration: underline; }
  main[data-pg="fasteignaverd"] .up { color: #46e08a; } main[data-pg="fasteignaverd"] .dn { color: #ff6d7a; }
  main[data-pg="fasteignaverd"] .note { font-size: 12.5px; color: var(--muted); line-height: 1.5; }
</style>
