---
// Eitt stafhólf úr fyrirtækjaskránni — hér verða prófílarnir loks skríðanlegir.
// Hver færsla er tengill með FÉLAGSNAFNINU sem akkerisexta á /fyrirtaeki/<kt>/;
// það er einmitt merkið sem vantaði (sjá skýringu í index.astro og fyrirtaeki-slod.mjs).
import Layout from '../../../layouts/Layout.astro';
import SKRA from '@gogn/felagaskra.json';
import { HOLF, holfTitill, stafHolf, felagSlod, ktTolur } from '../../../lib/fyrirtaeki-slod.mjs';

// ⚠ Astro hoistar getStaticPaths og keyrir hana í eigin gildissviði — hún nær í
// innflutning (SKRA, HOLF, stafHolf) en EKKI í aðrar frontmatter-breytur. Þess vegna
// er hópunin reiknuð hér inni og `virk` sent áfram sem prop fyrir stafa-flakkið.
export function getStaticPaths() {
  const hopar = {};
  for (const f of SKRA.felog || []) (hopar[stafHolf(f.nafn)] ||= []).push(f);
  // Aðeins hólf sem eiga félög — tómt hólf væri þunn síða og ekkert annað.
  const virk = HOLF.filter((h) => hopar[h] && hopar[h].length);
  return virk.map((h) => ({ params: { staf: h }, props: { radir: hopar[h], virk } }));
}

const { staf } = Astro.params;
const { radir, virk } = Astro.props;

const titill = holfTitill(staf);
const i = virk.indexOf(staf);
const fyrri = i > 0 ? virk[i - 1] : null;
const naesta = i >= 0 && i < virk.length - 1 ? virk[i + 1] : null;

const ktSnid = (kt) => (String(kt).length === 10 ? String(kt).slice(0, 6) + '-' + String(kt).slice(6) : kt);
const heiti = staf === '0-9' ? 'Félög sem byrja á tölustaf' : staf === 'annad' ? 'Félög með önnur upphafstákn' : `Félög sem byrja á ${titill}`;
const lysing = `${radir.length.toLocaleString('is-IS')} íslensk félög — ${heiti.toLowerCase()}. Kennitala, ársreikningur, endanlegir eigendur og umfjöllun á Karp.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: heiti,
  description: lysing,
  url: `https://karp.is/fyrirtaeki/skra/${staf}/`,
  inLanguage: 'is',
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Forsíða', item: 'https://karp.is/' },
      { '@type': 'ListItem', position: 2, name: 'Fyrirtæki', item: 'https://karp.is/fyrirtaeki/' },
      { '@type': 'ListItem', position: 3, name: 'Fyrirtækjaskrá', item: 'https://karp.is/fyrirtaeki/skra/' },
      { '@type': 'ListItem', position: 4, name: titill, item: `https://karp.is/fyrirtaeki/skra/${staf}/` },
    ],
  },
};
---

<Layout title={`${heiti} | Fyrirtækjaskrá Karps`} description={lysing} canonical={`https://karp.is/fyrirtaeki/skra/${staf}/`} jsonLd={jsonLd}>
  <main class="fskra" data-pg="fyrirtaeki-skra-staf">
    <nav class="fskra-brod" aria-label="Brauðmylsna">
      <a href="/">Forsíða</a> <span aria-hidden="true">›</span>
      <a href="/fyrirtaeki/">Fyrirtæki</a> <span aria-hidden="true">›</span>
      <a href="/fyrirtaeki/skra/">Fyrirtækjaskrá</a> <span aria-hidden="true">›</span>
      <span aria-current="page">{titill}</span>
    </nav>

    <h1>{heiti}</h1>
    <p class="fskra-lead"><strong>{radir.length.toLocaleString('is-IS')}</strong> félög. Smelltu á nafn til að opna prófílinn — grunnskrá, ársreikninga, eigendur og umfjöllun.</p>

    <ul class="fskra-listi">
      {radir.map((f) => (
        <li>
          <a href={felagSlod(f.kt)}>{f.nafn}</a>
          <span class="fskra-kt">{ktSnid(ktTolur(f.kt))}</span>
        </li>
      ))}
    </ul>

    <nav class="fskra-nav" aria-label="Fleiri stafir">
      {fyrri ? <a href={`/fyrirtaeki/skra/${fyrri}/`}>← {holfTitill(fyrri)}</a> : <span></span>}
      <a href="/fyrirtaeki/skra/">Allir stafir</a>
      {naesta ? <a href={`/fyrirtaeki/skra/${naesta}/`}>{holfTitill(naesta)} →</a> : <span></span>}
    </nav>
  </main>

  <style is:global>
    .fskra-listi { list-style: none; padding: 0; margin: 0 0 30px; columns: 2; column-gap: 34px; }
    .fskra-listi li { break-inside: avoid; display: flex; align-items: baseline; justify-content: space-between; gap: 10px; padding: 6px 0; border-bottom: 1px solid rgba(255,255,255,.06); }
    .fskra-listi a { color: #e9eef6; text-decoration: none; font-size: 14.5px; }
    .fskra-listi a:hover { color: #19d3c5; text-decoration: underline; }
    .fskra-kt { font-size: 11.5px; color: #7e8ca6; white-space: nowrap; font-variant-numeric: tabular-nums; }
    .fskra-nav { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding-top: 6px; }
    .fskra-nav a { color: #19d3c5; text-decoration: none; font-size: 14px; }
    .fskra-nav a:hover { text-decoration: underline; }
    @media (max-width: 640px) { .fskra-listi { columns: 1; } }
  </style>
</Layout>
