  @keyframes lk-kt-breytt { 0% { opacity: .3; transform: scale(.97); } 55% { opacity: 1; transform: scale(1.05); filter: drop-shadow(0 0 7px rgba(246,177,59,.85)); } 100% { opacity: 1; transform: scale(1); } }
