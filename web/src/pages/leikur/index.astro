---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="RÁS-Leikurinn — þjóðhagfræði-hermir" desc="Turn-based kennsluleikur í þjóðhagfræði fyrir Ísland.">
  <main data-pg="leikur"><div id="leikur-root">Hleð…</div></main>
</Layout>
<script>
  import { mountLeikur } from '@lib/leikur/client.mjs';
  mountLeikur(document.getElementById('leikur-root'));
</script>
<style>
  main[data-pg="leikur"] { max-width: 980px; margin: 0 auto; padding: 24px 16px 80px; color: var(--ink, #e8ecf3); }
  main[data-pg="leikur"] :global(h1) { font-size: 26px; margin: 0 0 8px; }
  main[data-pg="leikur"] :global(h2) { font-size: 17px; margin: 0 0 10px; }
  main[data-pg="leikur"] :global(.lk-btn) { background: #f6b13b; color: #12161f; border: 0; border-radius: 8px; padding: 9px 16px; font-weight: 700; cursor: pointer; }
  main[data-pg="leikur"] :global(.lk-btn:disabled) { opacity: .45; cursor: not-allowed; }
  main[data-pg="leikur"] :global(.lk-card) { border: 1px solid var(--line, #2a2f3a); border-radius: 12px; padding: 16px; margin: 12px 0; background: rgba(255,255,255,.03); }
  main[data-pg="leikur"] :global(.lk-lb-row) { display: flex; justify-content: space-between; gap: 12px; padding: 6px 0; border-top: 1px solid rgba(255,255,255,.06); }
  main[data-pg="leikur"] :global(.lk-lb-row:first-of-type) { border-top: 0; }
  main[data-pg="leikur"] :global(.lk-opt) { display: inline-block; padding: 6px 10px; margin: 3px; border: 1px solid var(--line, #2a2f3a); border-radius: 8px; cursor: pointer; font-size: 13.5px; }
  main[data-pg="leikur"] :global(.lk-opt.sel) { outline: 2px solid #f6b13b; background: rgba(246,177,59,.12); }
  main[data-pg="leikur"] :global(input) { background: #12161f; color: var(--ink, #e8ecf3); border: 1px solid var(--line, #2a2f3a); border-radius: 8px; }
</style>
