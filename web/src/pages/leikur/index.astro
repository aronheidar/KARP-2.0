---
import Layout from '../../layouts/Layout.astro';
import BASELINE from '@gogn/roads/baseline.json';
import { SCENARIO, MANDATE, ROUNDS } from '@lib/leikur/game-config.mjs';
const MODEL = {
  levers: Object.entries(BASELINE.levers).map(([k, v]) => ({ key: k, label: v.label })),
  shocks: Object.entries(BASELINE.shocks).map(([k, v]) => ({ key: k, label: v.label })),
  outcomes: Object.entries(BASELINE.outcomes).map(([k, v]) => ({ key: k, label: v.label })),
  defaultScenario: SCENARIO, defaultMandate: MANDATE, rounds: ROUNDS,
};
---
<Layout title="RÁS-Leikurinn — þjóðhagfræði-hermir" desc="Turn-based kennsluleikur í þjóðhagfræði fyrir Ísland." bare={true}>
  <main data-pg="leikur">
    <script type="application/json" id="leikur-model" set:html={JSON.stringify(MODEL)}></script>
    <div id="leikur-root">Hleð…</div>
  </main>
</Layout>
<script>
  import { mountLeikur } from '@lib/leikur/client.mjs';
  mountLeikur(document.getElementById('leikur-root'));
</script>
<style>
  main[data-pg="leikur"] { max-width: 1440px; margin: 0 auto; padding: 20px 20px 80px; color: var(--ink, #e8ecf3); }
  main[data-pg="leikur"] :global(h1) { font-size: 26px; margin: 0 0 8px; }
  main[data-pg="leikur"] :global(h2) { font-size: 17px; margin: 0 0 10px; }
  main[data-pg="leikur"] :global(.lk-btn) { background: #f6b13b; color: #12161f; border: 0; border-radius: 8px; padding: 9px 16px; font-weight: 700; cursor: pointer; }
  main[data-pg="leikur"] :global(.lk-btn:disabled) { opacity: .45; cursor: not-allowed; }
  main[data-pg="leikur"] :global(.lk-card) { border: 1px solid var(--line, #2a2f3a); border-radius: 12px; padding: 16px; margin: 12px 0; background: rgba(255,255,255,.03); }
  main[data-pg="leikur"] :global(.lk-lb-row) { display: flex; justify-content: space-between; gap: 12px; padding: 6px 0; border-top: 1px solid rgba(255,255,255,.06); }
  main[data-pg="leikur"] :global(.lk-lb-row:first-of-type) { border-top: 0; }
  main[data-pg="leikur"] :global(.lk-opt) { display: inline-block; padding: 6px 10px; margin: 3px; border: 1px solid var(--line, #2a2f3a); border-radius: 8px; cursor: pointer; font-size: 13.5px; }
  main[data-pg="leikur"] :global(.lk-opt.sel) { outline: 2px solid #f6b13b; background: rgba(246,177,59,.12); }
  main[data-pg="leikur"] :global(input) { background: #12161f; color: var(--ink, #e8ecf3); border: 1px solid var(--line, #2a2f3a); border-radius: 8px; }
  main[data-pg="leikur"] :global(.lk-muted) { color: var(--muted, #9fb0c8); }
  main[data-pg="leikur"] :global(.lk-tbl) { width: 100%; border-collapse: collapse; font-size: 13px; margin: 6px 0 14px; }
  main[data-pg="leikur"] :global(.lk-tbl th), main[data-pg="leikur"] :global(.lk-tbl td) { border-bottom: 1px solid rgba(255,255,255,.08); padding: 5px 8px; text-align: left; }
  main[data-pg="leikur"] :global(.lk-tbl th) { color: var(--muted, #9fb0c8); font-weight: 600; }
  main[data-pg="leikur"] :global(.lk-charts) { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 12px; }
  main[data-pg="leikur"] :global(.lk-charts svg) { max-width: 100%; height: auto; }
  main[data-pg="leikur"] :global(.lk-swatch) { display: inline-block; width: 10px; height: 10px; border-radius: 2px; margin-right: 4px; vertical-align: middle; }
  main[data-pg="leikur"] :global(.lk-ed-round) { border: 1px solid var(--line, #2a2f3a); border-radius: 8px; padding: 10px; margin: 8px 0; }
  main[data-pg="leikur"] :global(select) { background: #12161f; color: var(--ink, #e8ecf3); border: 1px solid var(--line, #2a2f3a); border-radius: 8px; padding: 6px; }
  main[data-pg="leikur"] :global(.lk-err) { color: #e78284; font-size: 13px; }
  main[data-pg="leikur"] :global(.lk-role-banner) { background: rgba(185,140,255,.12); border: 1px solid #b98cff55; border-radius: 10px; padding: 10px 14px; margin: 12px 0; }
  main[data-pg="leikur"] :global(.lk-kpi-w) { display: inline-block; background: #b98cff33; color: #d9c6ff; border-radius: 5px; padding: 0 5px; font-size: 11px; font-weight: 700; margin-left: 4px; }
  main[data-pg="leikur"] :global(.lk-tabs) { display: flex; flex-wrap: wrap; gap: 6px; margin: 4px 0 12px; }
  main[data-pg="leikur"] :global(.lk-tab) { display: inline-flex; align-items: center; gap: 6px; padding: 8px 13px; border: 1px solid var(--line, #2a2f3a); border-radius: 10px; cursor: pointer; font-size: 13.5px; font-weight: 600; background: rgba(255,255,255,.03); }
  main[data-pg="leikur"] :global(.lk-tab:hover) { background: rgba(255,255,255,.07); }
  main[data-pg="leikur"] :global(.lk-tab.sel) { border-color: #f6b13b; background: rgba(246,177,59,.16); color: #f6b13b; box-shadow: 0 0 0 1px #f6b13b inset; }
  main[data-pg="leikur"] :global(.lk-tab-ic) { font-size: 17px; }
  main[data-pg="leikur"] :global(.lk-newtools) { background: rgba(84,208,138,.12); border: 1px solid #54d08a55; border-radius: 10px; padding: 8px 14px; margin: 0 0 10px; font-size: 13.5px; color: #8fe3b3; }
  /* S6 áhorfenda-sýn */
  main[data-pg="leikur"] :global(.lk-watch-head) { margin: 0 0 14px; }
  main[data-pg="leikur"] :global(.lk-watch-title) { font-size: 30px; margin: 8px 0 4px; }
  main[data-pg="leikur"] :global(.lk-watch-board) { display: flex; flex-direction: column; gap: 9px; }
  main[data-pg="leikur"] :global(.lk-watch-row) { display: flex; align-items: center; gap: 12px; }
  main[data-pg="leikur"] :global(.lk-watch-rank) { font-size: 20px; width: 34px; text-align: center; flex: 0 0 auto; }
  main[data-pg="leikur"] :global(.lk-watch-name) { flex: 0 0 170px; font-weight: 700; font-size: 15px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  main[data-pg="leikur"] :global(.lk-watch-bar) { flex: 1; height: 22px; background: rgba(255,255,255,.06); border-radius: 6px; overflow: hidden; }
  main[data-pg="leikur"] :global(.lk-watch-fill) { height: 100%; border-radius: 6px; transition: width .3s; }
  main[data-pg="leikur"] :global(.lk-watch-score) { font-size: 18px; font-weight: 800; width: 64px; text-align: right; flex: 0 0 auto; }
  main[data-pg="leikur"] :global(.lk-slider-row) { margin: 8px 0; }
  main[data-pg="leikur"] :global(.lk-slider-row label) { display: block; font-size: 13px; margin-bottom: 2px; }
  main[data-pg="leikur"] :global(.lk-slider-row input[type=range]) { width: 100%; accent-color: #f6b13b; }
  main[data-pg="leikur"] :global(.lk-val) { font-weight: 700; color: #cbd3e1; }
  main[data-pg="leikur"] :global(.lk-val.moved) { color: #f6b13b; }
  main[data-pg="leikur"] :global(.lk-studio-grid) { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 2px 12px; }
  main[data-pg="leikur"] :global(.lk-og) { display: flex; justify-content: space-between; gap: 8px; font-size: 12px; padding: 2px 0; border-bottom: 1px solid rgba(255,255,255,.05); }
  main[data-pg="leikur"] :global(.lk-lock-big) { width: 100%; font-size: 16px; padding: 14px; }
  /* Tímalínu-borði 2000–2032 */
  main[data-pg="leikur"] :global(.lk-ribbon) { display: flex; gap: 4px; margin: 4px 0 14px; overflow-x: auto; }
  main[data-pg="leikur"] :global(.lk-term) { flex: 1 1 0; min-width: 54px; text-align: center; padding: 8px 2px; border-radius: 8px; border: 1px solid var(--line, #2a2f3a); background: rgba(255,255,255,.02); }
  main[data-pg="leikur"] :global(.lk-term.past) { opacity: .55; }
  main[data-pg="leikur"] :global(.lk-term.now) { border-color: #f6b13b; background: rgba(246,177,59,.14); box-shadow: 0 0 0 1px #f6b13b inset; }
  main[data-pg="leikur"] :global(.lk-term.future) { opacity: .32; }
  main[data-pg="leikur"] :global(.lk-term.end) { flex: 0 0 46px; opacity: .5; }
  main[data-pg="leikur"] :global(.lk-term-ic) { display: block; font-size: 16px; height: 20px; }
  main[data-pg="leikur"] :global(.lk-term-y) { display: block; font-size: 11px; color: var(--muted, #9fb0c8); font-weight: 700; margin-top: 2px; }
  /* Kjörtímabils-haus */
  main[data-pg="leikur"] :global(.lk-term-head) { margin: 0 0 10px; }
  main[data-pg="leikur"] :global(.lk-term-badge) { display: inline-block; font-size: 12px; font-weight: 700; color: #f6b13b; background: rgba(246,177,59,.12); border-radius: 999px; padding: 3px 12px; }
  main[data-pg="leikur"] :global(.lk-term-title) { font-size: 24px; margin: 8px 0 4px; }
  main[data-pg="leikur"] :global(.lk-term-text) { color: var(--muted, #9fb0c8); font-size: 14px; margin: 0; max-width: 760px; }
  /* Aðal-rist: gröf vinstri, stýringar hægri (sticky) */
  main[data-pg="leikur"] :global(.lk-studio-main) { display: grid; grid-template-columns: minmax(0,1fr) 380px; gap: 16px; align-items: start; }
  main[data-pg="leikur"] :global(.lk-studio-controls) { position: sticky; top: 64px; }
  @media (max-width: 900px) { main[data-pg="leikur"] :global(.lk-studio-main) { grid-template-columns: 1fr; } main[data-pg="leikur"] :global(.lk-studio-controls) { position: static; } }
  /* Þjóðarhagur-mælir */
  main[data-pg="leikur"] :global(.lk-gauge-card) { display: flex; align-items: center; gap: 16px; }
  main[data-pg="leikur"] :global(.lk-gauge) { flex: 0 0 auto; }
  /* Markmiðs-mælar */
  main[data-pg="leikur"] :global(.lk-goalmeters) { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 12px; }
  main[data-pg="leikur"] :global(.lk-goalmeter) { }
  main[data-pg="leikur"] :global(.lk-gm-top) { display: flex; justify-content: space-between; font-size: 13px; }
  main[data-pg="leikur"] :global(.lk-gm-bar) { height: 8px; background: rgba(255,255,255,.08); border-radius: 6px; margin: 4px 0; overflow: hidden; }
  main[data-pg="leikur"] :global(.lk-gm-fill) { height: 100%; border-radius: 6px; transition: width .15s; }
  main[data-pg="leikur"] :global(.lk-gm-sub) { display: flex; justify-content: space-between; font-size: 11px; }
  /* Útkomu-hitakort */
  main[data-pg="leikur"] :global(.lk-heat) { display: grid; grid-template-columns: repeat(auto-fill, minmax(130px, 1fr)); gap: 5px; }
  main[data-pg="leikur"] :global(.lk-heat-tile) { display: flex; flex-direction: column; gap: 1px; padding: 6px 8px; border-radius: 7px; font-size: 11px; }
  main[data-pg="leikur"] :global(.lk-heat-tile span) { color: var(--muted, #9fb0c8); }
  main[data-pg="leikur"] :global(.lk-heat-tile b) { font-size: 13px; }
  main[data-pg="leikur"] :global(.lk-watch) { font-size: 12.5px; color: #f0c674; background: rgba(240,177,59,.08); border-left: 3px solid #f6b13b; padding: 7px 11px; border-radius: 0 6px 6px 0; margin: 10px 0 0; max-width: 760px; }
  main[data-pg="leikur"] :global(.lk-pop) { margin-top: 2px; }
  main[data-pg="leikur"] :global(.lk-heat-tile[title]), main[data-pg="leikur"] :global(.lk-slider-row[title]) { cursor: help; }
  main[data-pg="leikur"] :global(.lk-news) { margin: 2px 0; }
  main[data-pg="leikur"] :global(.lk-news-item) { display: flex; gap: 8px; padding: 6px 0; border-bottom: 1px solid rgba(255,255,255,.06); font-size: 13.5px; }
  main[data-pg="leikur"] :global(.lk-vs) { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
  main[data-pg="leikur"] :global(.lk-vs-num) { font-size: 30px; font-weight: 800; }
  main[data-pg="leikur"] :global(.lk-title-card) { text-align: center; padding: 8px 0; }
  main[data-pg="leikur"] :global(.lk-title-big) { font-size: 30px; font-weight: 800; margin: 6px 0; }
  main[data-pg="leikur"] :global(.lk-team-banner) { display: flex; align-items: center; justify-content: space-between; gap: 10px; flex-wrap: wrap; background: rgba(110,168,254,.14); border: 1px solid #6ea8fe55; border-radius: 10px; padding: 8px 14px; margin: 0 0 10px; font-size: 14px; }
  main[data-pg="leikur"] :global(.lk-invite-btn) { background: rgba(84,208,138,.16); color: #54d08a; border: 1px solid #54d08a55; border-radius: 8px; padding: 5px 12px; font-size: 13px; font-weight: 700; cursor: pointer; white-space: nowrap; }
  main[data-pg="leikur"] :global(.lk-invite-btn:hover) { background: rgba(84,208,138,.26); }
  /* #1 debrief */
  main[data-pg="leikur"] :global(.lk-debrief) { border-color: #6ea8fe66; background: linear-gradient(180deg, rgba(110,168,254,.10), rgba(110,168,254,.03)); }
  main[data-pg="leikur"] :global(.lk-debrief-line) { margin: 6px 0; font-size: 14px; line-height: 1.5; }
  main[data-pg="leikur"] :global(.lk-debrief-line b) { color: #cfe0ff; }
  /* #2 live fórnarskipti */
  main[data-pg="leikur"] :global(.lk-conflict) { background: rgba(232,193,74,.12); border: 1px solid #e8c14a66; border-radius: 10px; padding: 8px 12px; margin: 0 0 10px; }
  main[data-pg="leikur"] :global(.lk-conflict-row) { display: flex; gap: 8px; align-items: flex-start; font-size: 13px; color: #f0d488; line-height: 1.45; padding: 3px 0; }
  main[data-pg="leikur"] :global(.lk-conflict-ic) { flex: 0 0 auto; }
  /* #3 umferðar-klukka */
  main[data-pg="leikur"] :global(.lk-timer) { display: inline-block; margin-left: 10px; padding: 3px 10px; border-radius: 999px; background: rgba(110,168,254,.16); border: 1px solid #6ea8fe55; color: #cfe0ff; font-size: 13px; font-weight: 700; font-variant-numeric: tabular-nums; vertical-align: middle; }
  main[data-pg="leikur"] :global(.lk-timer.low) { background: rgba(232,193,74,.18); border-color: #e8c14a77; color: #f0d488; }
  main[data-pg="leikur"] :global(.lk-timer.out) { background: rgba(231,130,132,.20); border-color: #e7828477; color: #f2a6a8; }
  /* #4 kjarna-sleði + intro */
  main[data-pg="leikur"] :global(.lk-slider-row.lk-core) { background: rgba(246,177,59,.07); border-left: 2px solid #f6b13b; padding-left: 8px; border-radius: 6px; }
  main[data-pg="leikur"] :global(.lk-intro) { background: rgba(90,200,224,.12); border: 1px solid #5ac8e055; border-radius: 10px; padding: 9px 14px; margin: 0 0 10px; font-size: 13.5px; color: #a9e6f2; line-height: 1.5; }
  /* #5 leikslok-samantekt */
  main[data-pg="leikur"] :global(.lk-recap) { border-color: #f6b13b66; background: linear-gradient(180deg, rgba(246,177,59,.09), rgba(246,177,59,.02)); }
  main[data-pg="leikur"] :global(.lk-recap-line) { margin: 6px 0; font-size: 14px; line-height: 1.5; }
  main[data-pg="leikur"] :global(.lk-recap-line b) { color: #f8d79a; }
  /* #6 kennslu-vísbendingar */
  main[data-pg="leikur"] :global(.lk-prompts) { margin: 2px 0 4px; padding-left: 20px; }
  main[data-pg="leikur"] :global(.lk-prompts li) { margin: 5px 0; font-size: 13.5px; line-height: 1.5; color: #d6def0; }
  main[data-pg="leikur"] :global(.lk-prompts li b) { color: #cfe0ff; }
  /* F1-V3: stefnu-badge-röð + hreint CSS-tooltip + KPI-delta-flísar */
  main[data-pg="leikur"] :global(.lk-pb-row) { display: flex; flex-wrap: wrap; gap: 6px; margin: 0 0 10px; }
  main[data-pg="leikur"] :global(.lk-pb) { position: relative; display: inline-flex; align-items: center; gap: 5px; background: #20242e; border: 1px solid #3a4152; border-left: 3px solid #e8c14a; border-radius: 8px; padding: 5px 10px; font-size: 12.5px; cursor: default; }
  main[data-pg="leikur"] :global(.lk-pb-stage) { color: var(--muted, #9fb0c8); font-size: 11.5px; white-space: nowrap; }
  main[data-pg="leikur"] :global(.lk-pb-esb) { border-left-color: #6ea8fe; }
  main[data-pg="leikur"] :global(.lk-pb-esb .lk-pb-stage) { color: #9cc3ff; font-weight: 700; }
  main[data-pg="leikur"] :global(.lk-pb-tip) { display: none; position: absolute; top: calc(100% + 6px); left: 0; z-index: 60; width: max-content; max-width: 300px; background: #171b24; border: 1px solid #3a4152; border-radius: 10px; padding: 10px 12px; font-size: 12.5px; font-weight: 400; line-height: 1.5; box-shadow: 0 8px 24px rgba(0,0,0,.45); white-space: normal; }
  main[data-pg="leikur"] :global(.lk-pb:hover .lk-pb-tip), main[data-pg="leikur"] :global(.lk-pb:focus-within .lk-pb-tip) { display: block; }
  main[data-pg="leikur"] :global(.lk-pb-tip-h) { display: block; font-weight: 700; font-size: 11px; text-transform: uppercase; letter-spacing: .5px; color: var(--muted, #9fb0c8); margin: 8px 0 3px; }
  main[data-pg="leikur"] :global(.lk-chip) { display: inline-block; padding: 1px 7px; margin: 1px 3px 1px 0; border-radius: 999px; font-size: 11px; font-variant-numeric: tabular-nums; white-space: nowrap; background: rgba(140,160,200,.14); border: 1px solid #3a4152; color: #b8c4d8; }
  main[data-pg="leikur"] :global(.lk-chip.g) { background: rgba(66,208,134,.13); border-color: #42d08655; color: #7fe0ab; }
  main[data-pg="leikur"] :global(.lk-chip.r) { background: rgba(231,130,132,.13); border-color: #e7828455; color: #f0a3a5; }
  main[data-pg="leikur"] :global(.lk-opt-fx) { display: block; margin-top: 3px; }
  /* F1-V4: uppsafnað — legend í results-korti, best-gildi í fac-töflu, leikslok-línur */
  main[data-pg="leikur"] :global(.lk-upp-legend) { display: flex; flex-wrap: wrap; gap: 4px 14px; font-size: 12px; margin: 2px 0 8px; color: var(--muted, #9fb0c8); }
  main[data-pg="leikur"] :global(.lk-upp-leg.me) { font-weight: 700; color: var(--ink, #e8ecf3); }
  main[data-pg="leikur"] :global(.lk-upp-best) { color: #54d08a; font-weight: 700; }
  main[data-pg="leikur"] :global(.lk-upp-lines p) { margin: 5px 0; font-size: 13.5px; line-height: 1.55; }
  main[data-pg="leikur"] :global(.lk-upp-lines p b) { color: #f8d79a; }
  /* VERK 1: pólitíski mælirinn — hlutlaus braut (rautt=vinstri, blátt=hægri skv. íslenskri hefð) + nál.
     Litirnir eru merkingar, ekki dómar; ⓘ-textinn (.lk-pol-info) fylgir mælinum alls staðar. */
  main[data-pg="leikur"] :global(.lk-pol-head) { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; flex-wrap: wrap; margin: 0 0 10px; }
  main[data-pg="leikur"] :global(.lk-pol-track) { position: relative; height: 10px; border-radius: 6px; background: linear-gradient(90deg, #e78284 0%, #8a8f9c 50%, #6ea8fe 100%); }
  main[data-pg="leikur"] :global(.lk-pol-nal) { position: absolute; top: -4px; width: 4px; height: 18px; margin-left: -2px; border-radius: 2px; background: #fff; box-shadow: 0 0 0 1px rgba(0,0,0,.55), 0 0 8px rgba(255,255,255,.45); transition: left .35s ease; }
  main[data-pg="leikur"] :global(.lk-pol-labels) { display: flex; justify-content: space-between; font-size: 11px; color: var(--muted, #9fb0c8); margin-top: 4px; }
  main[data-pg="leikur"] :global(.lk-pol-details) { margin-top: 8px; font-size: 12.5px; }
  main[data-pg="leikur"] :global(.lk-pol-details summary) { cursor: pointer; color: var(--muted, #9fb0c8); font-size: 12px; }
  main[data-pg="leikur"] :global(.lk-pol-tog) { margin: 5px 0 0; line-height: 1.5; }
  main[data-pg="leikur"] :global(.lk-pol-info) { font-size: 11px; margin: 8px 0 0; }
  @media (prefers-reduced-motion: reduce) { main[data-pg="leikur"] :global(.lk-pol-nal) { transition: none; } }
</style>
<style is:global>
  /* VERK 4: „Spyrðu Karp"-fiskurinn (#karp-fab í Layout.astro, fixed z-60) á ekki heima ofan á
     leiknum — ráðherrann og leik-UI eiga sviðið. body:has() bindur regluna við leik-síðuna SJÁLFA
     (main[data-pg="leikur"] er til í DOM) svo hún er skaðlaus þótt CSS-ið lifi view-transition af
     yfir á aðra síðu. :has-stuðningur: Chrome/Edge 105+, Safari 15.4+, Firefox 121+ (des 2023) —
     eldri vafrar sýna fiskinn áfram, skaðlaus úrelding (ekkert leggst lengur yfir hann: fasta
     PM-hornið með bottom:84px-hliðruninni er farið, sjá VERK 2). */
  body:has(main[data-pg="leikur"]) #karp-fab { display: none !important; }
  /* F2-V2: atviks-popup — is:global því @keyframes í scoped-blokk fá hash-nafn sem :global-reglurnar næðu ekki í.
     Modal-hýsillinn er runtime-systkini #leikur-root inni í main[data-pg=leikur] (innerHTML úr client.mjs). */
  main[data-pg="leikur"] .lk-sepop-overlay { position: fixed; inset: 0; z-index: 80; background: rgba(8,11,18,.72); display: flex; align-items: center; justify-content: center; padding: 22px; animation: lk-sepop-fade .2s ease-out; }
