---
// /leikur/kennarahefti/ — PRENTANLEGT KENNARAHEFTI fyrir kennara/leikstjóra sem ætlar að keyra RÁS-Leikinn.
// Systursíða /leikur/leikstjori/ (sölusíðan) og /leikur/personuvernd/ (skólasíðan): sama dökka KARP-gull
// útlit, kh-forskeyti. Statísk, SEO-indexanleg (title/description/OG + JSON-LD Article+LearningResource),
// engin innskráning, engin D1, ekkert runtime-JS nema prent-hnappurinn.
//
// ⚠⚠ EFNIÐ ER ALLT ÚR src/lib/leikur/kennarahefti.mjs — EKKERT efni er skrifað hér.
// Sú eining flytur VILJANDI ekki út `settings`/`strategy`/`varast`/`fylki_til_toflu` úr handbook.mjs:
// það er svarablaðið og það er leikstjóra-læst inni í leiknum. ÞESSI síða er opin og indexeranleg,
// svo hér má aldrei birtast neitt úr handbook.mjs sem kennarahefti.mjs flytur ekki þegar út.
// src/lib/leikur/kennarahefti.test.mjs gætir mörkanna (15 próf) — bæti einhver við innflutningi
// beint úr handbook.mjs hér fer hann framhjá þeim prófum. Ekki gera það.
//
// PRENTIÐ ER KJARNINN: heftið á að vera prentað og haldið á. Sjá @media print neðst — kafli á síðu,
// kjörtímabils-spjöld og vandamála-línur klofna aldrei, svart á hvítu, ekkert síðu-króm.
import Layout from '../../layouts/Layout.astro';
import {
  HEFTI_META, EIN_SIDA, UNDIRBUNINGUR, KEYRSLA, STYTTRI_TIMI, MIN_SAMTALS, OPNUNARORD,
  KJORTIMABIL, DEBRIEF_THREP, LOKASPURNINGAR, LOKASPURNING_ATH, HAMIR, HAEGUR_HAMUR,
  GRUNNTHAETTIR, NAMSMAT, VANDAMAL, TAKMARKANIR, PERSONUVERND, MEIRA, KAFLAR,
} from '@lib/leikur/kennarahefti.mjs';
import { ROUNDS, YEAR_START, QUARTERS_PER_ROUND } from '@lib/leikur/game-config.mjs';

const YEAR_END = YEAR_START + ROUNDS * QUARTERS_PER_ROUND; // 2032
// KAFLAR er ein uppspretta fyrir röð, númer og heiti — flettum upp á id svo markúpið hér að neðan
// þurfi ekki að endurtaka neitt af því (og svo kafli geti aldrei fengið rangt númer).
const K = Object.fromEntries(KAFLAR.map((k) => [k.id, k]));
const KLST = Math.floor(MIN_SAMTALS / 60);
const MIN_AFG = MIN_SAMTALS % 60;

const PAGE_URL = 'https://karp.is/leikur/kennarahefti/';
const TITLE = 'Kennarahefti RÁS-Leiksins — að keyra vinnustofu í hagstjórn';
const DESC = `Prentanlegt kennarahefti fyrir RÁS-Leikinn: undirbúningur, ${MIN_SAMTALS} mínútna keyrsla, umræðuspurningar fyrir öll ${ROUNDS} kjörtímabilin, debrief í fjórum þrepum, tenging við grunnþætti aðalnámskrár, námsmat, algeng vandamál og takmarkanir líkansins. Kennsluleikur í hagstjórn fyrir hagfræðikennslu í framhaldsskóla, háskóla og símenntun — þú þarft ekki að vera hagfræðingur.`;

// JSON-LD: Article + LearningResource (fjöl-tegund), EKKI HowTo.
// Rök: HowTo lýsir einni línulegri aðferð með `step`-runu að einni útkomu — heftið er ekki það, heldur
// tólf kaflar af blönduðu efni (námskrártenging, námsmat, takmarkanir líkansins, persónuvernd) sem
// `step` myndi rangfæra. Google hætti auk þess að birta HowTo-ríkniðurstöður (2023), svo tegundin
// gefur ekkert í staðinn. Article lýsir löngu lesmáli rétt; LearningResource bætir við kennslu-merkingunni
// (learningResourceType, educationalLevel, teaches, EducationalAudience/teacher) sem er einmitt það
// sem kennari leitar að. Fjöl-tegund er gild schema.org og articleSection speglar KAFLAR.
const JSONLD = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['Article', 'LearningResource'], '@id': PAGE_URL + '#hefti', url: PAGE_URL,
      headline: TITLE, name: HEFTI_META.heiti + ' — ' + HEFTI_META.undirtitill, inLanguage: 'is',
      description: DESC, abstract: HEFTI_META.inngangur,
      articleSection: KAFLAR.map((k) => k.heiti),
      learningResourceType: ['Kennsluleiðbeiningar', 'Kennarahefti'],
      educationalLevel: 'Framhaldsskóli, háskóli, símenntun',
      teaches: ['Þjóðhagfræði', 'Hagstjórn', 'Ákvarðanataka undir óvissu'],
      timeRequired: 'PT' + KLST + 'H' + MIN_AFG + 'M',
      audience: { '@type': 'EducationalAudience', educationalRole: 'teacher' },
      about: { '@type': 'Thing', name: 'RÁS-Leikurinn — kennsluleikur í hagstjórn' },
      isPartOf: { '@type': 'WebSite', name: 'Karp', url: 'https://karp.is/' },
      author: { '@type': 'Organization', name: 'Karp', url: 'https://karp.is/' },
      publisher: { '@type': 'Organization', name: 'Karp', url: 'https://karp.is/' },
    },
    { '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'RÁS-Leikurinn', item: 'https://karp.is/leikur/' },
      { '@type': 'ListItem', position: 2, name: 'Fyrir kennara', item: 'https://karp.is/leikur/leikstjori/' },
      { '@type': 'ListItem', position: 3, name: 'Kennarahefti', item: PAGE_URL } ] },
  ],
};
---
<Layout title={TITLE + ' | Karp'} description={DESC} canonical={PAGE_URL} ogTitle={HEFTI_META.heiti + ' — ' + HEFTI_META.undirtitill} jsonLd={JSONLD} bare={true}>
  <main data-pg="leikur-kennarahefti">

    <!-- KÁPA -->
    <header class="kh-hero">
      <p class="kh-crumb"><a href="/leikur/">RÁS-Leikurinn</a> · <a href="/leikur/leikstjori/">Fyrir kennara</a> · Kennarahefti</p>
      <span class="kh-badge">Prentanlegt · {KAFLAR.length} kaflar · {MIN_SAMTALS} mínútna vinnustofa</span>
      <h1>{HEFTI_META.heiti}</h1>
      <p class="kh-sub">{HEFTI_META.undirtitill}</p>
      <p class="kh-lead">{HEFTI_META.inngangur}</p>
      <p class="kh-actions">
        <button type="button" class="kh-btn" id="kh-prenta">🖨️ Prenta heftið</button>
        <a class="kh-btn kh-btn-ghost" href="/leikur/demo/">▶ Prófa demo (2 mín)</a>
        <a class="kh-btn kh-btn-ghost" href="/leikur/leikstjori/">🧑‍🏫 Leikstjóra-síðan</a>
      </p>
      <p class="kh-hero-fine">Sviðsmyndin er Ísland {YEAR_START}–{YEAR_END} í {ROUNDS} kjörtímabilum. Heftið er hugsað til að prenta og halda á meðan á kennslunni stendur — hver kafli byrjar á nýrri síðu.</p>
    </header>

    <!-- EFNISYFIRLIT (fellt út í prenti — kaflarnir byrja hver á sinni síðu) -->
    <nav class="kh-toc" aria-label="Efnisyfirlit">
      <h2>Efnisyfirlit</h2>
      <ol>
        {KAFLAR.map((k) => (
          <li><a href={'#' + k.id}><span class="kh-toc-nr">{k.nr}</span> {k.heiti}</a></li>
        ))}
      </ol>
    </nav>

    <!-- EIN SÍÐA — blaðið sem kennarinn tekur með sér inn í stofuna. Ekki kafli, ekkert númer. -->
    <section class="kh-einsida" id="ein-sida" aria-labelledby="kh-einsida-h">
      <h2 id="kh-einsida-h">Ef þú lest bara eina síðu</h2>
      <ol class="kh-einsida-list">
        {EIN_SIDA.map((s) => <li>{s}</li>)}
      </ol>
    </section>

    <!-- 1. FYRIR TÍMANN -->
    <section class="kh-kafli" id={K.undirbuningur.id} aria-labelledby="h-undirbuningur">
      <h2 id="h-undirbuningur"><span class="kh-nr">{K.undirbuningur.nr}</span> {K.undirbuningur.heiti}</h2>
      <p class="kh-p kh-muted">Sex atriði áður en hópurinn mætir. Það fyrsta skiptir mestu — hin fimm taka örfáar mínútur hvert.</p>
      <ol class="kh-steps">
        {UNDIRBUNINGUR.map((u) => (
          <li class="kh-step"><b>{u.hvad}</b><p class="kh-p">{u.hvernig}</p></li>
        ))}
      </ol>
    </section>

    <!-- 2. KEYRSLAN -->
    <section class="kh-kafli" id={K.keyrsla.id} aria-labelledby="h-keyrsla">
      <h2 id="h-keyrsla"><span class="kh-nr">{K.keyrsla.nr}</span> {K.keyrsla.heiti}</h2>
      <p class="kh-p kh-muted">Þrír fasar, {MIN_SAMTALS} mínútur samtals. Klukkan er valfrjáls — þú ræður takti, en hlutföllin milli fasanna eru það sem skiptir máli.</p>
      <div class="kh-fasar">
        {KEYRSLA.map((f) => (
          <article class="kh-fasi">
            <div class="kh-fasi-h"><b>{f.fasi}</b><span class="kh-min">{f.min} mín</span></div>
            <ul class="kh-bullets">{f.gera.map((g) => <li>{g}</li>)}</ul>
            <p class="kh-varast"><b>Varast:</b> {f.varast}</p>
          </article>
        ))}
      </div>
      <p class="kh-p kh-muted kh-samtals">Samtals {MIN_SAMTALS} mínútur — ein tvöföld kennslustund eða einn fundarsalur eftir hádegi.</p>

      <!-- Undirkafli inni í kafla 2 — ekki eigin kafli, ekkert númer í KAFLAR. -->
      <section class="kh-stytt" aria-labelledby="h-stytt">
        <h3 id="h-stytt">Þegar tíminn er styttri en vinnustofan</h3>
        <p class="kh-p kh-inng">{STYTTRI_TIMI.inngangur}</p>
        <div class="kh-stytt-listi">
          {STYTTRI_TIMI.leidir.map((l) => (
            <div class="kh-stytt-leid"><b>{l.heiti}</b><p class="kh-p">{l.txt}</p></div>
          ))}
        </div>
      </section>
    </section>

    <!-- 3. OPNUNARORÐIN -->
    <section class="kh-kafli" id={K.opnun.id} aria-labelledby="h-opnun">
      <h2 id="h-opnun"><span class="kh-nr">{K.opnun.nr}</span> {K.opnun.heiti}</h2>
      <p class="kh-p kh-muted">Þrjár málsgreinar til að lesa upp þegar liðin eru komin inn. Þær má lesa orðrétt — eða segja með eigin orðum, svo lengi sem þriðja málsgreinin fylgir með.</p>
      <blockquote class="kh-opnun">
        {OPNUNARORD.map((o) => <p>{o}</p>)}
      </blockquote>
    </section>

    <!-- 4. KJÖRTÍMABILIN -->
    <section class="kh-kafli" id={K.kjortimabil.id} aria-labelledby="h-kjortimabil">
      <h2 id="h-kjortimabil"><span class="kh-nr">{K.kjortimabil.nr}</span> {K.kjortimabil.heiti}</h2>
      <p class="kh-p kh-muted">Fyrir hvert kjörtímabil: staðan sem þú lest upp, kennslu-hornið sem lotan snýst um og spurningarnar sem eiga heima í uppgjörinu. Ráðlagðar stillingar eru <b>ekki</b> hér — þær birtast þér einum í kennsluhandbókinni inni í leiknum þegar lotan opnast.</p>
      <div class="kh-kt-listi">
        {KJORTIMABIL.map((k) => (
          <article class="kh-kt">
            <div class="kh-kt-h">
              <span class="kh-kt-nr">KT{k.lota}</span>
              <span class="kh-kt-ar">{YEAR_START + (k.lota - 1) * QUARTERS_PER_ROUND}–{YEAR_START + k.lota * QUARTERS_PER_ROUND}</span>
            </div>
            <p class="kh-p kh-kt-stada">{k.stada}</p>
            <p class="kh-lbl">Kennslu-hornið</p>
            <p class="kh-p">{k.kennslu_horn}</p>
            <p class="kh-lbl">Umræðuspurningar</p>
            <ul class="kh-sp">{k.spurningar.map((s) => <li>{s}</li>)}</ul>
          </article>
        ))}
      </div>
    </section>

    <!-- 5. DEBRIEF -->
    <section class="kh-kafli" id={K.debrief.id} aria-labelledby="h-debrief">
      <h2 id="h-debrief"><span class="kh-nr">{K.debrief.nr}</span> {K.debrief.heiti}</h2>
      <p class="kh-p kh-muted">Debriefið er þar sem lærdómurinn festist. Fjögur þrep, {DEBRIEF_THREP.reduce((s, t) => s + t.min, 0)} mínútur — í þessari röð.</p>
      <ol class="kh-threp">
        {DEBRIEF_THREP.map((t) => (
          <li class="kh-threp-li">
            <div class="kh-threp-h"><span class="kh-threp-nr">{t.threp}</span><b>{t.heiti}</b><span class="kh-min">{t.min} mín</span></div>
            <p class="kh-p">{t.txt}</p>
          </li>
        ))}
      </ol>
      <p class="kh-lbl">Lokaspurningar — veldu eina</p>
      <ul class="kh-sp kh-sp-loka">{LOKASPURNINGAR.map((s) => <li>{s}</li>)}</ul>
      <p class="kh-p kh-ath">{LOKASPURNING_ATH}</p>
    </section>

    <!-- 6. AUKAHAMIRNIR -->
    <section class="kh-kafli" id={K.hamir.id} aria-labelledby="h-hamir">
      <h2 id="h-hamir"><span class="kh-nr">{K.hamir.nr}</span> {K.hamir.heiti}</h2>
      <p class="kh-p kh-muted">Þrjú lög sem má kveikja á ofan á leik sem hópurinn kann þegar. Ekki í fyrstu spilun.</p>
      {HAMIR.map((h) => (
        <article class="kh-ham">
          <h3>{h.heiti}</h3>
          <p class="kh-p kh-ham-blurb">{h.blurb}</p>
          <p class="kh-lbl">Hvers vegna</p>
          <p class="kh-p">{h.hvers_vegna}</p>
          {h.hvenaer && (<><p class="kh-lbl">Hvenær</p><p class="kh-p">{h.hvenaer}</p></>)}
          {h.hvernig_keyra && (<><p class="kh-lbl">Hvernig þú keyrir hann</p><p class="kh-p">{h.hvernig_keyra}</p></>)}
          <p class="kh-lbl">Umræðuspurningar</p>
          <ul class="kh-sp">{h.spurningar.map((s) => <li>{s}</li>)}</ul>
        </article>
      ))}
    </section>

    <!-- 7. HÆGUR HAMUR -->
    <section class="kh-kafli" id={K.haegur.id} aria-labelledby="h-haegur">
      <h2 id="h-haegur"><span class="kh-nr">{K.haegur.nr}</span> {K.haegur.heiti}</h2>
      <h3>{HAEGUR_HAMUR.heiti}</h3>
      <p class="kh-lbl">Hvers vegna</p>
      <p class="kh-p">{HAEGUR_HAMUR.hvers_vegna}</p>
      <p class="kh-lbl">Hvernig þú keyrir hann</p>
      <ul class="kh-bullets">{HAEGUR_HAMUR.hvernig_keyra.map((h) => <li>{h}</li>)}</ul>
      <p class="kh-varast"><b>Varast:</b> {HAEGUR_HAMUR.varast}</p>
    </section>

    <!-- 8. NÁMSKRÁ -->
    <section class="kh-kafli" id={K.namskra.id} aria-labelledby="h-namskra">
      <h2 id="h-namskra"><span class="kh-nr">{K.namskra.nr}</span> {K.namskra.heiti}</h2>
      <p class="kh-p kh-muted">Grunnþættirnir sex úr aðalnámskrá og hvernig leikurinn snertir hvern þeirra. Áfangaheiti og -númer eru vísvitandi ekki hér — þau eru mismunandi milli skóla.</p>
      <dl class="kh-dl">
        {GRUNNTHAETTIR.map((g) => (<div class="kh-dl-row"><dt>{g.thattur}</dt><dd>{g.hvernig}</dd></div>))}
      </dl>
    </section>

    <!-- 9. NÁMSMAT -->
    <section class="kh-kafli" id={K.namsmat.id} aria-labelledby="h-namsmat">
      <h2 id="h-namsmat"><span class="kh-nr">{K.namsmat.nr}</span> {K.namsmat.heiti}</h2>
      <p class="kh-regla">{NAMSMAT.regla}</p>
      <p class="kh-lbl">Fjórar tillögur sem meta vinnuna, ekki stigin</p>
      <div class="kh-grid">
        {NAMSMAT.tillogur.map((t) => (
          <div class="kh-block"><div class="kh-block-h">{t.heiti}</div><p class="kh-p">{t.txt}</p></div>
        ))}
      </div>
    </section>

    <!-- 10. ALGENG VANDAMÁL -->
    <section class="kh-kafli" id={K.vandamal.id} aria-labelledby="h-vandamal">
      <h2 id="h-vandamal"><span class="kh-nr">{K.vandamal.nr}</span> {K.vandamal.heiti}</h2>
      <p class="kh-p kh-muted">Það sem kemur upp — og hvað þú gerir við því.</p>
      <div class="kh-vandi-listi">
        {VANDAMAL.map((v) => (
          <div class="kh-vandi">
            <div class="kh-vandi-q"><span class="kh-vandi-ic" aria-hidden="true">⚠</span> {v.vandi}</div>
            <p class="kh-p kh-vandi-a">{v.lausn}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- 11. TAKMARKANIR LÍKANSINS -->
    <section class="kh-kafli" id={K.takmarkanir.id} aria-labelledby="h-takmarkanir">
      <h2 id="h-takmarkanir"><span class="kh-nr">{K.takmarkanir.nr}</span> {K.takmarkanir.heiti}</h2>
      <p class="kh-p kh-inng">{TAKMARKANIR.inngangur}</p>
      <div class="kh-grid">
        {TAKMARKANIR.atridi.map((a) => (
          <div class="kh-block"><div class="kh-block-h">{a.heiti}</div><p class="kh-p">{a.txt}</p></div>
        ))}
      </div>
    </section>

    <!-- 12. PERSÓNUVERND -->
    <section class="kh-kafli" id={K.personuvernd.id} aria-labelledby="h-personuvernd">
      <h2 id="h-personuvernd"><span class="kh-nr">{K.personuvernd.nr}</span> {K.personuvernd.heiti}</h2>
      <p class="kh-p kh-inng">{PERSONUVERND.inngangur}</p>
      <ul class="kh-bullets">{PERSONUVERND.atridi.map((a) => <li>{a}</li>)}</ul>
      <p class="kh-p kh-muted">Ítarefnið sjálft — hvað er geymt, hver sér hvað, eyðing og drög að skóla-vinnslusamningi — er á <a href="/leikur/personuvernd/">Persónuvernd í RÁS-leiknum, fyrir skóla</a>.</p>
    </section>

    <!-- MEIRA EFNI — ekki kafli, ekkert númer. -->
    <section class="kh-meira" id="meira" aria-labelledby="h-meira">
      <h2 id="h-meira">Meira efni</h2>
      <ul class="kh-meira-listi">
        {MEIRA.map((m) => (
          <li><a href={m.slod}>{m.heiti}</a> <span class="kh-meira-slod">karp.is{m.slod}</span><p class="kh-p">{m.txt}</p></li>
        ))}
      </ul>
    </section>

    <footer class="kh-fotur">
      <p>{HEFTI_META.heiti} — {HEFTI_META.undirtitill} · karp.is/leikur/kennarahefti/</p>
      <p class="kh-muted">Spurningar um leikinn eða leikstjóra-leyfi: <a href="mailto:hjalp@karp.is">hjalp@karp.is</a></p>
    </footer>
  </main>
</Layout>

<!-- Prent-hnappur. CSP: enginn inline handler — addEventListener. astro:page-load svo hann virki
     líka eftir View-Transition navígasjón (ClientRouter í Layout). -->
<script>
  document.addEventListener('astro:page-load', () => {
    const b = document.getElementById('kh-prenta');
    if (b) b.addEventListener('click', () => window.print());
  });
</script>

<style>
  /* Sama dökka KARP-gull útlit og leikstjori.astro / personuvernd.astro (kh-forskeyti).
     Statísk síða, engir runtime-innerHTML hnútar → scoped CSS. Eina undantekningin er
     prent-blokkin neðst sem verður að ná í síðu-krómið úr Layout (haus/fótur/spjall-hnappur). */
  main[data-pg="leikur-kennarahefti"] { max-width: 880px; margin: 0 auto; padding: 20px 20px 80px; color: var(--ink, #e8ecf3); }
  h1 { font-size: 34px; line-height: 1.15; margin: 8px 0 4px; }
  h2 { font-size: 21px; margin: 0 0 10px; }
  h3 { font-size: 16.5px; margin: 16px 0 4px; }
  /* Læsileg lína: ~70 stafir. Allur meginmáls-texti fær kh-p. */
  .kh-p { max-width: 68ch; font-size: 14.5px; line-height: 1.65; margin: 6px 0; }
  .kh-muted { color: var(--muted, #9fb0c8); }
  .kh-muted a, .kh-fotur a { color: #f6b13b; }
  .kh-lbl { font-size: 11.5px; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; color: #f6b13b; margin: 14px 0 2px; }
  .kh-btn { display: inline-block; background: #f6b13b; color: #12161f; border: 0; border-radius: 8px; padding: 11px 20px; font-weight: 700; cursor: pointer; font-size: 15px; text-decoration: none; font-family: inherit; }
  .kh-btn:hover { filter: brightness(1.07); }
  .kh-btn-ghost { background: rgba(255,255,255,.06); color: var(--ink, #e8ecf3); border: 1px solid var(--line, #2a2f3a); }
  /* Kápa */
  .kh-hero { margin: 8px 0 6px; }
  .kh-crumb { font-size: 12.5px; color: var(--muted, #9fb0c8); margin: 0 0 6px; }
  .kh-crumb a { color: var(--muted, #9fb0c8); }
