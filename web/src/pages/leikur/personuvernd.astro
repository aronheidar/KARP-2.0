---
// /leikur/personuvernd/ — PERSÓNUVERND Í RÁS-LEIKNUM, FYRIR SKÓLA. Markhópur: skólastjórnendur, persónuverndar-
// fulltrúar skóla og kennarar sem þurfa að svara „má þetta?" á þremur mínútum. Statísk, SEO-indexanleg (title/
// description/canonical + JSON-LD WebPage+Breadcrumb), engin innskráning, engin D1, ekkert runtime-JS.
// Útlit endurnýtt úr leikstjori.astro (dökkt, KARP-gull) með pv-forskeyti.
//
// ALLT EFNI BYGGIR Á SANNREYNDUM STAÐREYNDUM ÚR KÓÐA (sjá ath. í skilum): töflur í web/migrations/0009_leikur.sql
// (leikur_games/teams/decisions/results — ENGIN user_id/netfang/nafn), join krefst innskráðs nemanda (users-taflan =
// Karp-reikningurinn), leikstjóri = HMAC-undirritað fac-tákn, áhorfenda-sýn ?watch=1 án innskráningar.
// Hugtök og orðalag spegla docs/personuvernd/DPIA-fyrirtaekjaskyrslur-KYC.md + 01-DPA-vinnslusamningur (samþykkt 26.7)
// + web/src/data/skilmalar.json. STAÐA: DRÖG — lögfræðiyfirferð í gangi (ágúst 2026); merkt á þremur stöðum.
import Layout from '../../layouts/Layout.astro';

const DROG = 'Drög — lögfræðiyfirferð í gangi (ágúst 2026)';
const PAGE_URL = 'https://karp.is/leikur/personuvernd/';
const TITLE = 'Persónuvernd í RÁS-leiknum — fyrir skóla';
const DESC = 'Hvað geymir RÁS-Leikurinn, hver sér hvað og hvernig er gögnum eytt? Svör fyrir skólastjórnendur, persónuverndarfulltrúa og kennara: engin netföng eða notanda-auðkenni í leik-gögnunum (liðsheiti er eina frjálsa sviðið), sjálfvirk eyðing eftir 90 daga, skólinn ábyrgðaraðili og Karp vinnsluaðili.';
const DPA_URL = '/skilmalar/#ras-leikurinn';
const HJALP = 'mailto:hjalp@karp.is';
const PV = 'mailto:personuvernd@karp.is';

// 1. Þrjár staðreynda-flísar.
const FLISAR = [
  { icon: '🙈', heiti: 'Engin netföng eða notanda-auðkenni í leiknum', txt: 'Leik-töflurnar geyma leikkóða, liðsheiti, ákvarðanir, uppgjör og stillingar — ekkert notanda-auðkenni, netfang eða skráð nafn. Liðsheiti er eina frjálsa sviðið (veljið hlutlaus heiti).' },
  { icon: '🗑️', heiti: 'Gögnum eytt sjálfkrafa eftir 90 daga', txt: 'Leikur, lið, ákvarðanir og uppgjör grisjast sjálfkrafa — og leikstjóri getur eytt leik strax í leikslok.' },
  { icon: '🏫', heiti: 'Skólinn ræður — Karp vinnur', txt: 'Skólinn er ábyrgðaraðili að kennslunni, Karp vinnsluaðili skv. 28. gr. GDPR. Vinnslusamningur fyrir skóla í drögum.' },
];

// 2. Hvað geymir leikurinn? — reitirnir NÁKVÆMLEGA eins og þeir eru í D1 (0009_leikur.sql).
const GEYMT = [
  { reitur: 'Leikkóði', hvad: '5 stafa handahófskóði sem auðkennir leikinn (t.d. „K7M2P"). Leikstjóri deilir honum á skjávarpa.', pg: 'nei', pgTxt: 'Nei' },
  { reitur: 'Liðsheiti', hvad: 'Frjáls texti sem liðið slær sjálft inn við inngöngu, mest 40 stafir. Birtist á stigatöflu og skjávarpa.', pg: 'nei-star', pgTxt: 'Nei*' },
  { reitur: 'Ákvarðanir', hvad: 'Stillingar liðsins per kjörtímabil: stýrivextir, skattar, útgjöld og stóru ákvarðanirnar (t.d. álver, gagnaver, ESB-umsókn). Lyklað á leikkóða + lið-númer.', pg: 'nei', pgTxt: 'Nei' },
  { reitur: 'Uppgjör', hvad: 'KPI-tölur (verðlag, VLF, kaupmáttur, skuldir, losun …) og stig hvers liðs per kjörtímabil — reiknað í RÁS-herminum á þjóni.', pg: 'nei', pgTxt: 'Nei' },
  { reitur: 'Stillingar', hvad: 'Val leikstjóra við stofnun leiks: erfiðleikastig, umferðar-klukka, leikháttur (einfalt/stjórnstöð), leynileg hlutverk, óvænt atvik, æfingalið.', pg: 'nei', pgTxt: 'Nei' },
];

// 3. Hver sér hvað? — þrír dálkar. Byggt á GET /api/leikur/<kóði>/state: opinbert = lið+stig+KPI-ferlar+kort+atvik;
// lið-tákn = eigið umboð/hlutverk+eigin ákvarðanir; fac-tákn = roster+greining (ALLRA ákvarðanir)+hlutverk allra.
const SER = [
  { icon: '🧑‍🎓', heiti: 'Þátttakandi (lið)', ser: ['Eigin sleða og ákvarðanir liðsins', 'Eigið umboð og leynilegt hlutverk (ef á við)', 'Stigatöflu allra liða: liðsheiti + stig', 'Uppgjör og KPI-ferla allra liða, Ísland liðanna, óvænt atvik', 'Stóru ákvarðanir og klemmu-val allra liða (merki á ferlum og korti)'], serEkki: ['Sleðastillingar annarra liða (hrá gildi)', 'Umboð og hlutverk annarra liða (hlutverk afhjúpuð í leikslok)', 'Nöfn eða netföng nokkurs — eru ekki til í leik-gögnunum'] },
  { icon: '🧑‍🏫', heiti: 'Leikstjóri', ser: ['Allt sem þátttakandi sér', 'Lista liða með læsingar-stöðu', 'Greiningu liða: skorkort, allar ákvarðanir, ferlar', 'Hlutverk allra liða og kennsluhandbók', 'Stjórntæki: byrja, gera upp, stöðva/ljúka — og „🗑️ Eyða leik núna"'], serEkki: ['Nöfn, netföng eða Karp-reikninga þátttakenda — leikurinn geymir þau ekki', 'Aðra leiki en sína eigin (leikstjóra-tákn er bundið leikkóða)'] },
  { icon: '📺', heiti: 'Skjávarpi (áhorfenda-sýn)', ser: ['Stigatöflu í rauntíma: liðsheiti + stig', 'Ísland liðanna (kort), KPI-ferla, atvika-popup, RÁS-tíðindi', 'Stóru ákvarðanir og klemmu-val liðanna (merki) — og í leikslok pólitíska ásinn (stjórnstöð)'], serEkki: ['Sleðastillingar (hrá gildi) eða ósend drög nokkurs liðs', 'Umboð og hlutverk liða fyrir leikslok', 'Neitt sem krefst liðs- eða leikstjóra-tákns (greining, roster)'], ath: 'Áhorfenda-hlekkurinn krefst engrar innskráningar — allir sem hafa leikkóðann geta opnað hann (kóðinn er 5 stafa slembikóði). Liðsheitin birtast því á skjá: veljið nafnlaus heiti og eyðið leiknum eftir kennslu.' },
];

// 6. Fyrir persónuverndarfulltrúann — stuttur listi.
const PVF = [
  { h: 'Mat á áhrifum á persónuvernd (DPIA)', t: 'DPIA-grunnur til í drögum (ekki enn yfirfarinn af lögfræðingi) — afhentur skólum á beiðni til personuvernd@karp.is svo þeir geti tekið hann upp í eigið mat. Niðurstaða draga: eftirstæð áhætta lág, enda engin tenging leik-gagna við notandareikninga, stutt varðveisla og engin prófílgerð eða einkunnagjöf; opin lögfræðileg álitaefni (hlutverk, lagastoð skóla, börn 13–17 ára) eru talin í viðauka matsins.' },
  { h: 'Forsamráð við Persónuvernd', t: 'Ekki talið skylt (36. gr. GDPR) — vinnslan er ekki talin hafa í för með sér mikla áhættu. Endurmetið ef umfang breytist.' },
  { h: 'Undirvinnsluaðilar', t: 'Cloudflare, Inc. — hýsing, keyrsla (Workers) og gagnagrunnur (D1) þar sem leik-gögnin eru vistuð og unnin. Google LLC / Google Ireland Ltd. (Gmail) — móttaka þátttakendalistans sem kennari sendir á hjalp@karp.is og staðfestingar-/lykilorðspóstur Karp-reikningsins; Gmail fær engin leik-gögn (leikurinn sjálfur sendir engan póst). Engin utanaðkomandi gervigreindarveita kemur að uppgjöri leiksins.' },
  { h: 'Staðsetning gagna', t: 'Hjá Cloudflare — sjá vinnslusamning (DPA). Undirvinnsluaðilar kunna að vinna gögn utan EES; slíkur flutningur styðst við viðeigandi verndarráðstafanir skv. V. kafla GDPR (stöðluð samningsákvæði og/eða gildandi fullnægjandiákvörðun).' },
  { h: 'Öryggisbrestur', t: 'Tilkynntur skólanum innan 48 klst. frá því að Karp verður hans var, með þeim upplýsingum sem skólinn þarf skv. 33.–34. gr. GDPR.' },
  { h: 'Öryggisráðstafanir', t: 'Dulkóðun í flutningi (TLS); Karp-innskráning með PBKDF2-vörðu lykilorði og undirritaðri lotuköku; liðs- og leikstjóra-tákn HMAC-undirrituð og bundin einum leikkóða; uppgjör reiknað á þjóni (ófölsuð stig).' },
  { h: 'Aldur þátttakenda', t: 'Karp er ekki ætlað börnum yngri en 13 ára (persónuverndarstefna Karp, 11. liður, sbr. ákvæði laga nr. 90/2018 um aldursmörk barna í tengslum við þjónustu í upplýsingasamfélaginu). Leikurinn er ætlaður framhaldsskóla-, háskóla- og símenntunarstigi; nemendur 13–17 ára eru börn í skilningi laganna og vinnslan fer fram undir ábyrgð skólans — ekki á grundvelli samþykkis nemenda.' },
  { h: 'Þátttakendalisti frá kennara', t: 'Til að virkja nemanda-aðgang sendir kennari lista þátttakenda (netföng) á hjalp@karp.is. Listinn er notaður eingöngu til að merkja reikningana sem nemanda-aðgang — mælt er með skóla-netföngum.' },
  { h: 'Réttindi skráðra', t: 'Um leik-gögnin: réttindi nemenda (aðgangur, leiðrétting, eyðing, andmæli) eru gagnvart skólanum sem ábyrgðaraðila; Karp aðstoðar og framsendir beiðnir sem berast beint. Leik-gögn eru ekki lykluð á einstakling — beiðni er afgreidd með leikkóða og liði (að jafnaði með atbeina kennara): leik eytt eða liðsheiti nafnleyst. Um Karp-reikninginn: beiðnir á hjalp@karp.is, afgreiddar innan lögbundins frests (að jafnaði mánaðar). Rétt er að kvarta til Persónuverndar.' },
];

const JSONLD = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebPage', '@id': PAGE_URL, url: PAGE_URL, name: TITLE, inLanguage: 'is', description: DESC, isPartOf: { '@type': 'WebSite', name: 'Karp', url: 'https://karp.is/' },
      about: { '@type': 'Thing', name: 'RÁS-Leikurinn — persónuvernd og gagnavinnsla í skólum' }, publisher: { '@type': 'Organization', name: 'Karp', url: 'https://karp.is/' } },
    { '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'RÁS-Leikurinn', item: 'https://karp.is/leikur/' },
      { '@type': 'ListItem', position: 2, name: 'Fyrir kennara', item: 'https://karp.is/leikur/leikstjori/' },
      { '@type': 'ListItem', position: 3, name: 'Persónuvernd fyrir skóla', item: PAGE_URL } ] },
  ],
};
---
<Layout title={TITLE + ' | Karp'} description={DESC} canonical={PAGE_URL} ogTitle={TITLE} jsonLd={JSONLD} bare={true}>
  <main data-pg="leikur-personuvernd">

    <!-- 1. HERO -->
    <header class="pv-hero">
      <p class="pv-crumb"><a href="/leikur/">RÁS-Leikurinn</a> · <a href="/leikur/leikstjori/">Fyrir kennara</a> · Persónuvernd</p>
      <span class="pv-drog" title="Staða skjalsins">⚠ {DROG}</span>
      <h1>Persónuvernd í RÁS-leiknum — fyrir skóla</h1>
      <p class="pv-lead">Síðan er fyrir skólastjórnendur, persónuverndarfulltrúa og kennara sem þurfa að svara „má þetta?" á þremur mínútum. Hún lýsir nákvæmlega hvað leikurinn geymir, hver sér hvað og hvernig gögnum er eytt — og hvaða hlutverk skóli og Karp hafa samkvæmt persónuverndarlögum.</p>
      <div class="pv-flisar" aria-label="Þrjár staðreyndir">
        {FLISAR.map((f) => (
          <div class="pv-flis"><span class="pv-flis-ic" aria-hidden="true">{f.icon}</span><b>{f.heiti}</b><p>{f.txt}</p></div>
        ))}
      </div>
    </header>

    <!-- 2. HVAÐ GEYMIR LEIKURINN? -->
    <section class="pv-card" id="geymt">
      <h2>🗄️ Hvað geymir leikurinn?</h2>
      <p class="pv-muted">Leikurinn keyrir á þjóni Karp og geymir fimm flokka upplýsinga um hvern leik (fjórar töflur: leikur, lið, ákvarðanir, uppgjör). Ekkert þeirra er notanda-auðkenni, netfang eða skráð nafn — leik-töflurnar fjórar hafa enga tengingu við Karp-reikning þátttakanda. Eina undantekningin er valfrjáls póst-áminning: hún er slökkt sjálfgefið og geymd sér — sjá töfluna.</p>
      <div class="pv-tbl-wrap">
        <table class="pv-tbl">
          <thead><tr><th>Reitur</th><th>Hvað er geymt</th><th>Persónugögn?</th></tr></thead>
          <tbody>
            {GEYMT.map((r) => (
              <tr><td class="pv-reitur">{r.reitur}</td><td>{r.hvad}</td><td><span class={'pv-pg pv-pg-' + r.pg}>{r.pgTxt}</span></td></tr>
            ))}
            <tr>
              <td class="pv-reitur">Póst-áminning — valfrjáls</td>
              <td>Í <b>hægum ham</b>, þar sem ein umferð er opin í heilan dag í stað þess að allt sé spilað í einni kennslustund, geturðu beðið um póst þegar ný umferð opnast. Kveikirðu á henni geymum við að <b>þinn Karp-reikningur tilheyri þessum leik</b> — það er allt og það er geymt sér, ekki með ákvörðunum eða stigum. <b>Slökkt sjálfgefið.</b> Pósturinn ber aðeins leikkóða, umferð, frest og hlekk — ekkert um önnur lið eða niðurstöður. Slekkirðu á henni er færslunni eytt strax; annars eyðist hún með leiknum.</td>
              <td><span class="pv-pg pv-pg-ja">Já — ef þú kveikir á henni</span></td>
            </tr>
            <tr class="pv-row-acct">
              <td class="pv-reitur">Karp-innskráning nemanda</td>
              <td>Til að ganga í lið þarf þátttakandi innskráðan Karp-reikning sem merktur er sem nemanda-aðgangur: netfang, lykilorð (geymt sem PBKDF2-hash) og nemanda-merki. Þetta er vistað í notendaskrá Karp — <b>það er Karp-reikningurinn, ekki leikurinn.</b> Eitt tæki per lið dugar, svo aðeins einn í hverju liði þarf aðgang. <b>Mælt er með skóla-netfangi.</b></td>
              <td><span class="pv-pg pv-pg-ja">Já — reikningurinn</span></td>
            </tr>
            <tr>
              <td class="pv-reitur">Í vafra þátttakanda</td>
              <td>Liðs- eða leikstjóra-tákn leiksins og „séð"-flögg (t.d. að atvika-popup hafi birst) í localStorage vafrans. Ekkert af þessu er sent til þjóns nema táknið sjálft, sem auðkennir lið eða leikstjóra í einum leik.</td>
              <td><span class="pv-pg pv-pg-nei">Nei</span></td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="pv-fn"><b>* Liðsheiti er frjáls texti.</b> Kerfið síar ekki nöfn úr því — ef lið skrifar „Jón og Gunna" er það eina leiðin sem persónuupplýsingar komast í leik-gögnin. Inngönguskjárinn biður um hlutlaust heiti; biðjið liðin um nafnlaus heiti („Rauða liðið", „Ríkisstjórn 3") — leikstjóri sér heitin í lobby áður en leikur hefst og getur eytt leiknum og stofnað nýjan ef þörf krefur.</p>
    </section>

    <!-- 3. HVER SÉR HVAÐ? -->
    <section class="pv-card" id="ser">
      <h2>👀 Hver sér hvað?</h2>
      <p class="pv-muted">Þrjár sýnir á sama leik. Stigatafla, KPI-ferlar og kortið eru sameiginleg öllum sem hafa leikkóðann; ákvarðanir liða í smáatriðum sér aðeins leikstjóri.</p>
      <div class="pv-ser-grid">
        {SER.map((s) => (
          <div class="pv-ser">
            <div class="pv-ser-h"><span aria-hidden="true">{s.icon}</span> <b>{s.heiti}</b></div>
            <p class="pv-ser-lbl">Sér</p>
            <ul>{s.ser.map((x) => <li>{x}</li>)}</ul>
            <p class="pv-ser-lbl pv-ser-lbl-ekki">Sér ekki</p>
            <ul class="pv-ekki">{s.serEkki.map((x) => <li>{x}</li>)}</ul>
            {s.ath && <p class="pv-ser-ath">{s.ath}</p>}
          </div>
        ))}
      </div>
    </section>

    <!-- 4. HVERNIG EYÐUM VIÐ? -->
    <section class="pv-card" id="eyding">
      <h2>🗑️ Hvernig eyðum við?</h2>
      <div class="pv-grid3">
        <div class="pv-block">
          <div class="pv-block-h">⏳ Sjálfkrafa eftir 90 daga</div>
          <p>Loknir leikir eru grisjaðir sjálfkrafa 90 dögum eftir stofnun (vikuleg keyrsla): leikurinn, lið hans, ákvarðanir og uppgjör hverfa úr gagnagrunninum. Leikir sem aldrei var lokið hverfa eigi síðar en eftir 180 daga. Engin leik-gögn eru varðveitt lengur en kennslan þarf.</p>
        </div>
        <div class="pv-block">
          <div class="pv-block-h">🧑‍🏫 „Eyða leik núna" — leikstjóri</div>
          <p>Í leikslok (og í biðstöðu áður en leikur hefst) hefur leikstjóri hnappinn „🗑️ Eyða leik núna" sem eyðir leiknum, liðsheitum, ákvörðunum og uppgjöri strax og endanlega, án þess að bíða grisjunarinnar (leikur í gangi er fyrst stöðvaður). Mælt með því þegar kennslustund er lokið og debrief-skýrslan hefur verið prentuð.</p>
        </div>
        <div class="pv-block">
          <div class="pv-block-h">✉️ Karp-reikningur nemanda</div>
          <p>Karp er ábyrgðaraðili reikningsins: beiðni um eyðingu hans (netfangs) sendir nemandinn sjálfur á <a href={HJALP}>hjalp@karp.is</a> — afgreitt handvirkt innan lögbundins frests, að jafnaði mánaðar. Skólinn getur óskað þess að nemanda-merking sé afturkölluð af reikningum þátttakenda og að þátttakendalistanum sé eytt.</p>
        </div>
      </div>
    </section>

    <!-- 5. HLUTVERK OG SAMNINGUR -->
    <section class="pv-card pv-dpa" id="samningur">
      <h2>📜 Hlutverk og samningur</h2>
      <span class="pv-drog">⚠ {DROG}</span>
      <p>Þegar skóli notar RÁS-Leikinn í kennslu er <b>skólinn ábyrgðaraðili</b> að vinnslu persónuupplýsinga nemenda sinna — hann ákveður hverjir taka þátt, hvaða netföng eru notuð og hvernig lið eru nefnd. <b>Karp (Steinsson Greykdal ehf., kt. 490522-0500) er vinnsluaðili</b> í skilningi 28. gr. reglugerðar (ESB) 2016/679 (GDPR) og laga nr. 90/2018: Karp vinnur leik-gögnin aðeins til að reka leikinn fyrir skólann — ekki í eigin þágu, hvorki í aðrar vörur Karp né til markaðssetningar — og eyðir þeim samkvæmt ofangreindu. Karp-reikningur nemandans sjálfs (netfang og lykilorð) fellur undir persónuverndarstefnu Karp sem ábyrgðaraðila að eigin notendagögnum.</p>
      <p class="pv-cta-row">
        <a class="pv-btn" href={DPA_URL}>📄 Skóla-DPA (drög) — sækja</a>
        <a class="pv-btn pv-btn-ghost" href={PV + '?subject=' + encodeURIComponent('Skóla-DPA — RÁS-Leikurinn')}>✉️ Hafa samband til að undirrita</a>
      </p>
      <p class="pv-muted">Skóla-samningurinn fylgir sama sniði og gagnavinnslusamningur Karp fyrir compliance-vörur (það sniðmát var yfirfarið af persónuverndarlögfræðingi 26. júlí 2026 — skóla-útgáfan sjálf er enn í drögum og bíður yfirferðar): efni og tilgangur, tegundir upplýsinga, skyldur vinnsluaðila, öryggisráðstafanir, undirvinnsluaðilar, öryggisbrestur, varðveisla og eyðing. Þar til skóli hefur undirritað hann gildir almenni gagnavinnslusamningurinn á skilmálasíðunni. Skólinn fær afrit til undirritunar — ekkert gjald fylgir samningnum.</p>
    </section>

    <!-- 6. FYRIR PERSÓNUVERNDARFULLTRÚANN -->
    <section class="pv-card" id="pvf">
      <h2>🛡️ Fyrir persónuverndarfulltrúann</h2>
      <dl class="pv-dl">
        {PVF.map((p) => (<div class="pv-dl-row"><dt>{p.h}</dt><dd>{p.t}</dd></div>))}
