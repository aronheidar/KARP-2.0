---
// Eftirlit & byggingarleyfi — SAMEINUÐ síða (áður /eftirlit/ + /byggingarvakt/).
// Bæði eru opin Reykjavíkur-gögn um staði og hús; hvorugt er persónusniðin „vakt".
// Flipar: ?t=eftirlit (sjálfgefið) · ?t=bygging — sama mynstur og /okutaeki-skip/?t=oku.
//
// ⚠ Flipa-tæknin: báðir hlutar eru RENDERAÐIR og frumstilltir strax (eins og áður);
// falinn flipi = hidden. ECharts/Leaflet frumstillast því í 0px-íláti → flipa-rofinn
// sendir 'resize' (ECharts hlustar) og kallar el._map.invalidateSize() (Leaflet).
// Þess vegna geymir kort-kóðinn `el._map = map`.
//
// data-pg situr á HLUTUNUM (ekki <main>) svo skrifturnar og is:global-reglurnar úr
// upprunasíðunum haldist óbreyttar — valdararnir eru [data-pg="…"] í stað main[data-pg="…"].
import Layout from '../layouts/Layout.astro';
import EF from '@gogn/eftirlit.json';
import VAKT from '@gogn/byggingarleyfi_vakt.json';

/* ---- Eftirlit (HER) ---- */
const stadir = EF.stadir || [];
const dist = EF.dist || [0, 0, 0, 0, 0, 0];
const count = EF.count || stadir.length;
const avg = EF.avg;
const worst = stadir.filter((s) => s.rating <= 1).sort((a, b) => (a.rating - b.rating) || (b.lastInspectionISO || '').localeCompare(a.lastInspectionISO || ''));
const nStopped = dist[0] + dist[1];
const efUpdated = (EF.updated || '').slice(0, 10);
const RLAB = EF.labels || {};
const cIS = (v) => (v == null ? '–' : String(v).replace('.', ','));

/* ---- Byggingarleyfi (byggingarfulltrúi RVK) ---- */
const LABELS = VAKT.decisionLabels || {};
const byDec = VAKT.byDecision || {};
const byHv = VAKT.byHverfi || {};
const counts = VAKT.counts || {};
const bvUpdated = (VAKT.generated || '').slice(0, 10);
const latestDate = VAKT.latestDate || '';
const DCOL = {
  samthykkt: '#3fb950', jakvaett: '#6fd39b', frestad: '#f6b13b', afgreitt: '#58a6ff',
  synjad: '#d1242f', neikvaett: '#f85149', visad_fra: '#f0883e', afturkallad: '#8b98ac', annad: '#9fb0c8',
};
const ORDER = ['samthykkt', 'jakvaett', 'frestad', 'afgreitt', 'synjad', 'neikvaett', 'visad_fra', 'afturkallad', 'annad'];
const distRows = ORDER.filter((c) => byDec[c]).map((c) => ({ code: c, label: LABELS[c] || c, n: byDec[c], col: DCOL[c] }));
const nIS = (v) => (v == null ? '–' : Number(v).toLocaleString('is-IS'));
const samth = (byDec.samthykkt || 0) + (byDec.jakvaett || 0);
const synj = (byDec.synjad || 0) + (byDec.neikvaett || 0);
const topHv = Object.entries(byHv).slice(0, 8);

const desc = `Opinber gögn Reykjavíkurborgar um staði og hús: matvæla- og heilbrigðiseftirlitseinkunn ${count} veitinga- og matvælastaða (kvarði 0–5) og ${nIS(counts.permits)} afgreiðslur byggingarfulltrúa á ${nIS(counts.addresses)} heimilisföngum. Kort, leit og skýrslur.`;
---
<Layout title="Eftirlit & byggingarleyfi í Reykjavík — hreinlætiseinkunnir og afgreiðslur byggingarfulltrúa | Karp" description={desc} canonical="https://karp.is/eftirlit-byggingar/" ogTitle="Eftirlit & byggingarleyfi í Reykjavík">
  <main class="eb">
    <p class="kicker">Hagvísir Íslands · Reykjavík</p>
    <h1>Eftirlit &amp; byggingarleyfi 🏙️</h1>
    <p class="lead">Tvær opinberar skrár Reykjavíkurborgar um staði og hús, á einum stað: <strong>hreinlætiseinkunn</strong> veitinga- og matvælastaða úr heilbrigðiseftirliti, og <strong>afgreiðslur byggingarfulltrúa</strong> á byggingarleyfum. Hvort tveggja er opið og uppfært daglega.</p>
    <p class="datainfo">⚠ Aðeins Reykjavík — önnur sveitarfélög birta hvorugt á sambærilegu formi.</p>

    <div class="eb-tabs" role="tablist" aria-label="Veldu gagnaskrá">
      <button class="eb-tab" data-t="eftirlit" type="button" role="tab" aria-controls="tab-eftirlit">🍽️ Heilbrigðiseftirlit <span>{count} staðir</span></button>
      <button class="eb-tab" data-t="bygging" type="button" role="tab" aria-controls="tab-bygging">🏗️ Byggingarleyfi <span>{nIS(counts.permits)} afgreiðslur</span></button>
    </div>

    {/* ============================ FLIPI 1 — EFTIRLIT ============================ */}
    <section id="tab-eftirlit" data-tab="eftirlit" data-pg="eftirlit" role="tabpanel">
      <p class="lead">Opinber niðurstaða matvæla- og heilbrigðiseftirlits fyrir <strong>{count}</strong> veitinga-, kaffihúsa- og matvælastaði í Reykjavík — einkunn <strong>0–5</strong> (0 verst) úr nýjasta eftirliti. Enginn annar birtir þetta á einum stað: Matvælastofnun gefur engar per-stað einkunnir og fjölmiðlar halda ekki skrá. Fletta má upp einstöku fyrirtæki á <a href="/fyrirtaeki/">fyrirtækjaprófílum</a>.</p>
      <p class="datainfo"><i class="tip" tabindex="0" data-tip="Heimild: Heilbrigðiseftirlit Reykjavíkur (her.reykjavik.is). Kvarði 0–5: 5 kröfur uppfylltar · 4 fáein frávik · 3 frávik/ábendingar · 2 aðkallandi frávik · 1 starfsemi takmörkuð/stöðvuð að hluta · 0 starfsemi stöðvuð. ⚠ Aðeins Reykjavík — önnur heilbrigðiseftirlitssvæði birta ekki per-stað einkunnir.">ⓘ</i> Um kvarðann og gögnin</p>

      <div class="kpis">
        <div class="kpi"><div class="k-l">🏢 Metnir staðir</div><div class="k-v">{count}</div><div class="k-s">m/ birta einkunn</div></div>
        <div class="kpi"><div class="k-l">📊 Meðaleinkunn</div><div class="k-v">{cIS(avg)}</div><div class="k-s">af 5 (hærra betra)</div></div>
        <div class="kpi"><div class="k-l">⛔ Stöðvuð / takmörkuð</div><div class="k-v" style="color:#f85149">{nStopped}</div><div class="k-s">einkunn 0–1</div></div>
        <div class="kpi"><div class="k-l">⭐ Til fyrirmyndar</div><div class="k-v" style="color:#3fb950">{dist[5]}</div><div class="k-s">einkunn 5</div></div>
      </div>

      <h2>Dreifing einkunna</h2>
      <p class="sub">Fjöldi staða eftir einkunn. Flestir eru í 3 („frávik / ábendingar"); {nStopped} staðir í 0–1.</p>
      <div class="cwrap"><div id="ef-dist" class="ch"></div></div>

      <div id="ef-mapwrap" hidden>
        <h2>Kort — hreinlæti eftir stað</h2>
        <p class="sub">Litur eftir einkunn (grænt best, rautt verst). Smelltu á punkt fyrir stað og skýrslu. <span id="ef-mapn"></span></p>
        <div id="ef-map"></div>
      </div>

      {worst.length > 0 && <>
        <h2>⚠ Alvarlegustu frávikin</h2>
        <p class="sub">Staðir með stöðvaða eða að hluta takmarkaða/stöðvaða starfsemi (einkunn 0–1) í nýjasta eftirliti.</p>
        <div class="ef-grid">
          {worst.map((s) => (
            <div class="ef-card">
              <span class={'ef-b r' + s.rating} title={'Einkunn ' + s.rating + '/5'}>{s.rating}</span>
              <div class="ef-t">
                <a class="ef-n" href={'/fyrirtaeki/?q=' + encodeURIComponent(s.kt || s.name)}>{s.name}</a>
                <div class="ef-meta">{[s.street, s.postnr, s.city].filter(Boolean).join(' · ')}</div>
                <div class="ef-lab">{s.ratingLabel}</div>
              </div>
              <div class="ef-r">
                <div class="ef-d">{s.lastInspection || ''}</div>
                {s.reportUrl && <a class="ef-rep" href={s.reportUrl} target="_blank" rel="noopener">skýrsla ↗</a>}
              </div>
            </div>
          ))}
        </div>
      </>}

      <h2>Leitaðu í skránni</h2>
      <p class="sub">Sláðu inn nafn eða götu, eða síaðu eftir einkunn. Smelltu á nafn til að sjá fyrirtækjaprófíl, eða „skýrsla" fyrir fulla eftirlitsskýrslu HER.</p>
      <div class="ef-controls">
        <input id="ef-q" type="search" placeholder="🔎 Leita að stað eða götu…" autocomplete="off" aria-label="Leita að stað eða götu" />
        <div class="ef-filt" id="ef-filt">
          <button class="ef-fb active" data-r="all">Allar</button>
          <button class="ef-fb" data-r="5">5</button>
          <button class="ef-fb" data-r="4">4</button>
          <button class="ef-fb" data-r="3">3</button>
          <button class="ef-fb" data-r="2">2</button>
          <button class="ef-fb" data-r="1">1</button>
          <button class="ef-fb" data-r="0">0</button>
        </div>
      </div>
      <div id="ef-count" class="ef-cnt"></div>
      <div id="ef-list" class="ef-grid"><div class="ef-load">Hleð skránni…</div></div>
      <button id="ef-more" class="ef-more" hidden>Sýna fleiri</button>

      <p class="foot">Forþjónað (SSG). Heimild: <b>Heilbrigðiseftirlit Reykjavíkur</b> (her.reykjavik.is), uppfært {efUpdated}. Einkunn 0–5 úr nýjasta eftirliti hvers staðar; full skýrsla (Hollustuhættir / Matvæli / Mengunarvarnir) á HER. ⚠ Aðeins Reykjavík — Matvælastofnun og önnur heilbrigðiseftirlitssvæði birta ekki per-stað einkunnir.</p>
    </section>

    {/* ============================ FLIPI 2 — BYGGINGARLEYFI ============================ */}
    <section id="tab-bygging" data-tab="bygging" data-pg="byggingarvakt" role="tabpanel" hidden>
      <p class="lead">Opinberar afgreiðslur <strong>byggingarfulltrúa Reykjavíkur</strong> á byggingarleyfum — <strong>{nIS(counts.permits)}</strong> afgreiðslur (samþykkt · synjað · frestað) á <strong>{nIS(counts.addresses)}</strong> heimilisföngum, úr fundargerðum frá 2020. Sjáðu hvað er verið að byggja, breyta og stækka í hverju hverfi. Byggingarsögu hvers heimilisfangs má fletta upp í <a href="/fasteignavakt/">verðmatsskýrslunni</a>.</p>
      <p class="datainfo"><i class="tip" tabindex="0" data-tip="Heimild: Afgreiðslufundir byggingarfulltrúa Reykjavíkur (reykjavik.is). Lyklað á heimilisfang — engar kennitölur, nöfn eða persónuupplýsingar umsækjenda. Samþykkt = leyfi veitt · Synjað = hafnað · Frestað = beðið umsagnar/athugasemda · Afgreitt/Jákvæð/Neikvæð = fyrirspurn afgreidd. ⚠ Aðeins Reykjavík — önnur sveitarfélög birta byggingarleyfi á öðru formi.">ⓘ</i> Um gögnin og ákvarðanir</p>

      <div class="kpis">
        <div class="kpi"><div class="k-l">🏗️ Afgreiðslur</div><div class="k-v">{nIS(counts.permits)}</div><div class="k-s">frá 2020 ({nIS(counts.meetings)} fundir)</div></div>
        <div class="kpi"><div class="k-l">🏠 Heimilisföng</div><div class="k-v">{nIS(counts.addresses)}</div><div class="k-s">í Reykjavík</div></div>
        <div class="kpi"><div class="k-l">✅ Samþykkt</div><div class="k-v" style="color:#3fb950">{nIS(samth)}</div><div class="k-s">{synj} synjað / hafnað</div></div>
        <div class="kpi"><div class="k-l">📅 Nýjasti fundur</div><div class="k-v" style="font-size:19px">{latestDate}</div><div class="k-s">uppfært {bvUpdated}</div></div>
      </div>

      <h2>Dreifing ákvarðana</h2>
      <p class="sub">Fjöldi afgreiðslna eftir niðurstöðu. „Frestað" er algengast enda fresta fundir málum til umsagnar áður en þau eru samþykkt.</p>
      <div class="cwrap"><div id="bv-dist" class="ch"></div></div>

      {topHv.length > 0 && <>
        <h2>Flest byggingarmál eftir hverfi</h2>
        <p class="sub">Hverfi með flestar afgreiðslur byggingarfulltrúa (öll ár).</p>
        <div class="hv-grid">
          {topHv.map(([hv, n]) => (
            <div class="hv-card"><span class="hv-n">{nIS(n)}</span><span class="hv-h">{hv}</span></div>
          ))}
        </div>
      </>}

      <div id="bv-mapwrap" hidden>
        <h2>Kort — nýjustu leyfi</h2>
        <p class="sub">Nýjustu afgreiðslur, litaðar eftir niðurstöðu (grænt samþykkt, rautt synjað, gult frestað). Smelltu á punkt fyrir mál og fundargerð. <span id="bv-mapn"></span></p>
        <div id="bv-map"></div>
      </div>

      <h2>Nýjustu afgreiðslur</h2>
      <p class="sub">Sláðu inn heimilisfang eða hverfi, eða síaðu eftir niðurstöðu. Smelltu á heimilisfang fyrir verðmat og byggingarsögu, eða „fundargerð" fyrir opinberu bókunina.</p>
      <div class="bv-controls">
        <input id="bv-q" type="search" placeholder="🔎 Leita að heimilisfangi eða hverfi…" autocomplete="off" aria-label="Leita að heimilisfangi eða hverfi" />
        <div class="bv-filt" id="bv-filt">
          <button class="bv-fb active" data-g="all">Allar</button>
          <button class="bv-fb" data-g="samth">✅ Samþykkt</button>
          <button class="bv-fb" data-g="synj">⛔ Synjað</button>
          <button class="bv-fb" data-g="frest">⏸ Frestað</button>
          <button class="bv-fb" data-g="annad">Annað</button>
        </div>
      </div>
      <div id="bv-count" class="bv-cnt"></div>
      <div id="bv-list" class="bv-grid"><div class="bv-load">Hleð skránni…</div></div>
      <button id="bv-more" class="bv-more" hidden>Sýna fleiri</button>

      <p class="foot">Forþjónað (SSG). Heimild: <b>Afgreiðslufundir byggingarfulltrúa Reykjavíkur</b> (reykjavik.is), afgreiðslur skv. mannvirkjalögum nr. 160/2010, uppfært {bvUpdated}. Lyklað á heimilisfang — engar persónuupplýsingar umsækjenda. ⚠ Aðeins Reykjavík; önnur sveitarfélög (Kópavogur, Hafnarfjörður o.fl.) birta byggingarleyfi á öðru formi.</p>
    </section>
  </main>

  <style>
    main { max-width: 1000px; margin: 0 auto; padding: 44px 20px 64px; }
    .kicker { font-size: 12px; letter-spacing: .14em; text-transform: uppercase; color: var(--faint); margin: 0 0 4px; }
    h1 { font-size: 32px; margin: 0 0 10px; }
    p { color: var(--ink); } p a { color: #f6b13b; }
    .lead { font-size: 15px; line-height: 1.6; } .lead strong { color: var(--ink); }
    h2 { font-size: 17px; color: var(--ink); margin: 38px 0 4px; }
    .sub { font-size: 13.5px; color: var(--muted); margin: 0 0 14px; line-height: 1.55; }
    .datainfo { font-size: 12.5px; color: var(--faint); margin: 6px 0 4px; }
    .tip { font-style: normal; cursor: help; color: #f6b13b; border: 1px solid rgba(246,177,59,.4); border-radius: 50%; padding: 0 5px; font-size: 11px; }

    /* Flipar */
    .eb-tabs { display: flex; flex-wrap: wrap; gap: 8px; margin: 22px 0 6px; border-bottom: 1px solid rgba(255,255,255,.1); padding-bottom: 10px; }
    .eb-tab { font: inherit; font-size: 14px; font-weight: 700; padding: 9px 16px; border-radius: 10px; cursor: pointer;
      border: 1px solid rgba(255,255,255,.12); background: rgba(255,255,255,.03); color: var(--muted); }
    .eb-tab span { font-weight: 400; font-size: 12px; color: var(--faint); margin-left: 4px; }
    .eb-tab:hover { color: var(--ink); border-color: rgba(246,177,59,.5); }
    .eb-tab.active { background: #f6b13b; border-color: #f6b13b; color: #10151f; }
    .eb-tab.active span { color: rgba(16,21,31,.7); }
    section > .lead { margin-top: 18px; }

    .kpis { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 10px; margin: 18px 0 6px; }
    .kpi { background: rgba(255,255,255,.04); border: 1px solid rgba(255,255,255,.08); border-radius: 10px; padding: 12px 14px; }
    .k-l { font-size: 12px; color: var(--muted); }
    .k-v { font-size: 26px; font-weight: 800; color: #f6b13b; margin-top: 2px; font-variant-numeric: tabular-nums; }
    .k-s { font-size: 11px; color: var(--faint); }
    .cwrap { background: rgba(255,255,255,.02); border: 1px solid rgba(255,255,255,.06); border-radius: 12px; padding: 12px 10px 8px; }
    .ch { width: 100%; height: 300px; }

    #ef-map, #bv-map { width: 100%; height: 440px; border-radius: 12px; border: 1px solid rgba(255,255,255,.08); overflow: hidden; z-index: 0; }
    #ef-map :global(.leaflet-popup-content), #bv-map :global(.leaflet-popup-content) { font-size: 13px; }
    #ef-mapn, #bv-mapn { color: var(--faint); font-size: 12px; }

    /* — eftirlit — */
    .ef-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 10px; margin-top: 4px; }
    .ef-card { display: flex; align-items: flex-start; gap: 11px; background: rgba(255,255,255,.03); border: 1px solid rgba(255,255,255,.08); border-radius: 11px; padding: 11px 13px; }
    /* ⚠ .ef-b (einkunnar-reitur) er byggður með innerHTML í card()-JS → færður í is:global neðar. */
    .ef-t { flex: 1 1 auto; min-width: 0; }
    .ef-n { font-size: 13.5px; font-weight: 700; color: var(--ink); text-decoration: none; display: block; }
    .ef-n:hover { color: #f6b13b; }
    .ef-meta { font-size: 11.5px; color: var(--faint); margin-top: 1px; }
    .ef-lab { font-size: 11.5px; color: var(--muted); margin-top: 3px; }
    .ef-r { flex: 0 0 auto; text-align: right; }
    .ef-d { font-size: 11px; color: var(--faint); white-space: nowrap; }
    .ef-rep { font-size: 11px; color: #f6b13b; text-decoration: none; }
    .ef-rep:hover { text-decoration: underline; }
    .ef-controls { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; margin: 4px 0 10px; }
    #ef-q { flex: 1 1 260px; font: inherit; font-size: 14px; padding: 9px 13px; border-radius: 10px; border: 1px solid rgba(255,255,255,.14); background: rgba(255,255,255,.03); color: var(--ink); }
    #ef-q:focus { outline: none; border-color: rgba(246,177,59,.55); }
    .ef-filt { display: flex; gap: 5px; }
    .ef-fb { font: inherit; font-size: 13px; min-width: 34px; padding: 6px 10px; border-radius: 8px; border: 1px solid rgba(255,255,255,.12); background: rgba(255,255,255,.03); color: var(--muted); cursor: pointer; font-weight: 700; }
    .ef-fb:hover { color: var(--ink); border-color: rgba(246,177,59,.5); }
    .ef-fb.active { background: #f6b13b; border-color: #f6b13b; color: #10151f; }
    .ef-cnt { font-size: 12.5px; color: var(--faint); margin: 0 2px 8px; }
    .ef-load { color: var(--faint); font-size: 13px; padding: 20px; }
    .ef-more { display: block; margin: 14px auto 0; font: inherit; font-size: 13px; padding: 8px 20px; border-radius: 999px; border: 1px solid rgba(255,255,255,.14); background: rgba(255,255,255,.03); color: var(--ink); cursor: pointer; }
    .ef-more:hover { border-color: rgba(246,177,59,.5); color: var(--ink); }

    /* — byggingarleyfi — */
    .hv-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 8px; }
    .hv-card { display: flex; align-items: baseline; gap: 8px; background: rgba(255,255,255,.03); border: 1px solid rgba(255,255,255,.08); border-radius: 9px; padding: 9px 12px; }
    .hv-n { font-size: 18px; font-weight: 800; color: #f6b13b; font-variant-numeric: tabular-nums; }
    .hv-h { font-size: 12.5px; color: var(--ink); }
    .bv-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: 10px; margin-top: 4px; }
    /* ⚠ .bv-kortin eru byggð með innerHTML í card()-JS → reglurnar í is:global neðar. */
    .bv-controls { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; margin: 4px 0 10px; }
    #bv-q { flex: 1 1 260px; font: inherit; font-size: 14px; padding: 9px 13px; border-radius: 10px; border: 1px solid rgba(255,255,255,.14); background: rgba(255,255,255,.03); color: var(--ink); }
    #bv-q:focus { outline: none; border-color: rgba(246,177,59,.55); }
    .bv-filt { display: flex; flex-wrap: wrap; gap: 5px; }
    .bv-fb { font: inherit; font-size: 12.5px; padding: 6px 11px; border-radius: 8px; border: 1px solid rgba(255,255,255,.12); background: rgba(255,255,255,.03); color: var(--muted); cursor: pointer; font-weight: 700; }
    .bv-fb:hover { color: var(--ink); border-color: rgba(246,177,59,.5); }
    .bv-fb.active { background: #f6b13b; border-color: #f6b13b; color: #10151f; }
    .bv-cnt { font-size: 12.5px; color: var(--faint); margin: 0 2px 8px; }
    .bv-load { color: var(--faint); font-size: 13px; padding: 20px; }
    .bv-more { display: block; margin: 14px auto 0; font: inherit; font-size: 13px; padding: 8px 20px; border-radius: 999px; border: 1px solid rgba(255,255,255,.14); background: rgba(255,255,255,.03); color: var(--ink); cursor: pointer; }
    .bv-more:hover { border-color: rgba(246,177,59,.5); color: var(--ink); }

    .foot { font-size: 12px; color: var(--faint); margin-top: 30px; border-top: 1px solid rgba(255,255,255,.08); padding-top: 14px; line-height: 1.6; }
    .foot b { color: var(--muted); }
  </style>

  <style is:global>
    /* runtime-innerHTML → global (Astro-gildran): byggt í card()-JS, aldrei í static template.
       [data-pg] (ekki main[data-pg]) því hlutarnir bera merkið hér, ekki <main>. */
    [data-pg="eftirlit"] .ef-vakta { display: block; width: 100%; margin-top: 7px; font: inherit; font-size: 11px; font-weight: 700; padding: 5px 8px; border-radius: 8px; border: 1px solid rgba(246,177,59,.5); background: none; color: #f6b13b; cursor: pointer; text-align: center; }
