    [data-pg="eftirlit"] .ef-b { flex: 0 0 34px; width: 34px; height: 34px; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 17px; color: #10151f; }
    [data-pg="eftirlit"] .ef-b.r5 { background: #3fb950; }
    [data-pg="eftirlit"] .ef-b.r4 { background: #6fd39b; }
    [data-pg="eftirlit"] .ef-b.r3 { background: #f6b13b; }
    [data-pg="eftirlit"] .ef-b.r2 { background: #f0883e; }
    [data-pg="eftirlit"] .ef-b.r1 { background: #f85149; color: #fff; }
    [data-pg="eftirlit"] .ef-b.r0 { background: #d1242f; color: #fff; }

    [data-pg="byggingarvakt"] .bv-vakta { display: block; width: 100%; margin-top: 8px; font: inherit; font-size: 11px; font-weight: 700; padding: 5px 8px; border-radius: 8px; border: 1px solid rgba(246,177,59,.5); background: none; color: #f6b13b; cursor: pointer; text-align: center; }
    [data-pg="byggingarvakt"] .bv-vakta:hover { background: rgba(246,177,59,.1); }
    [data-pg="byggingarvakt"] .bv-vakta.on { background: rgba(66,208,134,.12); border-color: rgba(66,208,134,.5); color: #42d086; }
    [data-pg="byggingarvakt"] .bv-vakta:disabled { opacity: .6; cursor: default; }
    [data-pg="byggingarvakt"] .bv-card { background: rgba(255,255,255,.03); border: 1px solid rgba(255,255,255,.08); border-radius: 11px; padding: 11px 13px; }
    [data-pg="byggingarvakt"] .bv-top { display: flex; align-items: baseline; gap: 8px; }
    [data-pg="byggingarvakt"] .bv-badge { flex: 0 0 auto; font-size: 11px; font-weight: 800; padding: 2px 8px; border-radius: 999px; color: #0a0e14; white-space: nowrap; }
    [data-pg="byggingarvakt"] .bv-a { font-size: 14px; font-weight: 700; color: var(--ink); text-decoration: none; }
    [data-pg="byggingarvakt"] .bv-a:hover { color: #f6b13b; }
    [data-pg="byggingarvakt"] .bv-desc { font-size: 12.5px; color: var(--ink); margin: 5px 0 3px; line-height: 1.45; }
    [data-pg="byggingarvakt"] .bv-meta { display: flex; justify-content: space-between; gap: 10px; font-size: 11.5px; color: var(--faint); }
    [data-pg="byggingarvakt"] .bv-meta a { color: #f6b13b; text-decoration: none; }
    [data-pg="byggingarvakt"] .bv-meta a:hover { text-decoration: underline; }
  </style>

  {/* ---- Flipa-rofi. Skilgreindur ÁÐUR en hluta-skrifturnar keyra sinn astro:page-load,
         en show() er kallað í page-load svo báðar hafa þegar frumstillt sig. ---- */}
  <script>
    function ebTabs() {
      const main = document.querySelector('main.eb');
      if (!main) return;
      const secs = main.querySelectorAll('[data-tab]');
      const btns = main.querySelectorAll('.eb-tab');
      const show = (t, push) => {
        secs.forEach((s) => { s.hidden = s.dataset.tab !== t; });
        btns.forEach((b) => { const on = b.dataset.t === t; b.classList.toggle('active', on); b.setAttribute('aria-selected', on ? 'true' : 'false'); });
        if (push) { const u = new URL(location.href); u.searchParams.set('t', t); history.replaceState(null, '', u); }
        // Bæði ECharts og Leaflet frumstillast í földu íláti (0px) → vekja þau við skipti.
        window.dispatchEvent(new Event('resize'));
        main.querySelectorAll('#ef-map, #bv-map').forEach((el) => {
          if (el._map) [0, 120, 400].forEach((d) => setTimeout(() => el._map.invalidateSize(), d));
        });
      };
      btns.forEach((b) => b.addEventListener('click', () => show(b.dataset.t, true)));
      const t0 = new URLSearchParams(location.search).get('t');
      show(t0 === 'bygging' ? 'bygging' : 'eftirlit', false);
    }
    document.addEventListener('astro:page-load', ebTabs);
  </script>

  {/* ---- Eftirlit: graf + leitanleg skrá + kort (óbreytt frá /eftirlit/, utan ef-dist + el._map) ---- */}
  <script define:vars={{ dist, RLAB }}>
    function initEft() {
      if (!document.querySelector('[data-pg="eftirlit"]')) return;
      const AX = '#7e8ca6', GRID = 'rgba(255,255,255,.06)', LINE = 'rgba(255,255,255,.14)';
      const RCOL = ['#d1242f', '#f85149', '#f0883e', '#f6b13b', '#6fd39b', '#3fb950'];
      const esc = (s) => String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

      const drawDist = () => {
        const el = document.getElementById('ef-dist');
        if (!el || !window.echarts || window.echarts.getInstanceByDom(el)) return;
        const c = window.echarts.init(el);
        c.setOption({
          backgroundColor: 'transparent', grid: { left: 44, right: 16, top: 14, bottom: 40 },
          tooltip: { trigger: 'axis', axisPointer: { type: 'shadow' }, formatter: (p) => 'Einkunn ' + p[0].name + '<br/><b>' + p[0].value + '</b> staðir<br/>' + (RLAB[p[0].name] || '') },
          xAxis: { type: 'category', data: [0, 1, 2, 3, 4, 5], name: 'einkunn', nameLocation: 'middle', nameGap: 26, nameTextStyle: { color: AX, fontSize: 11 }, axisLabel: { color: AX, fontSize: 13, fontWeight: 700 }, axisLine: { lineStyle: { color: LINE } } },
          yAxis: { type: 'value', axisLabel: { color: AX }, splitLine: { lineStyle: { color: GRID } } },
          series: [{ type: 'bar', data: dist.map((v, i) => ({ value: v, itemStyle: { color: RCOL[i], borderRadius: [4, 4, 0, 0] } })), barMaxWidth: 60, label: { show: true, position: 'top', color: '#9fb0c8', fontSize: 12, fontWeight: 700 } }],
        });
        window.addEventListener('resize', () => c.resize());
      };
      if (window.echarts) drawDist();
      else { let s = document.getElementById('echarts-cdn'); if (!s) { s = document.createElement('script'); s.id = 'echarts-cdn'; s.src = 'https://cdn.jsdelivr.net/npm/echarts@5/dist/echarts.min.js'; document.head.appendChild(s); } s.addEventListener('load', drawDist, { once: true }); }

      const listEl = document.getElementById('ef-list'), cntEl = document.getElementById('ef-count'), moreEl = document.getElementById('ef-more'), qEl = document.getElementById('ef-q');
      if (!listEl || listEl.dataset.wired) return;
      listEl.dataset.wired = '1';
      let DATA = null, filtered = [], shown = 0, curR = 'all', PAGE = 60;
      const card = (s) => '<div class="ef-card"><span class="ef-b r' + s.rating + '" title="Einkunn ' + s.rating + '/5">' + s.rating + '</span>'
        + '<div class="ef-t"><a class="ef-n" href="/fyrirtaeki/?q=' + encodeURIComponent(s.kt || s.name) + '">' + esc(s.name) + '</a>'
        + '<div class="ef-meta">' + esc([s.street, s.postnr, s.city].filter(Boolean).join(' · ')) + '</div>'
        + '<div class="ef-lab">' + esc(s.ratingLabel || '') + '</div></div>'
        + '<div class="ef-r"><div class="ef-d">' + esc(s.lastInspection || '') + '</div>'
        + (s.reportUrl ? '<a class="ef-rep" href="' + esc(s.reportUrl) + '" target="_blank" rel="noopener">skýrsla ↗</a>' : '')
        + (s.kt ? '<button type="button" class="ef-vakta" data-kt="' + esc(s.kt) + '" data-nafn="' + esc(s.name || '') + '">🔔 Vakta félagið</button>' : '')
        + '</div></div>';
      const apply = () => {
        const q = (qEl.value || '').toLowerCase().trim();
        filtered = DATA.filter((s) => (curR === 'all' || s.rating === +curR)
          && (!q || (s.name || '').toLowerCase().includes(q) || (s.street || '').toLowerCase().includes(q)));
        shown = 0;
        cntEl.textContent = filtered.length + ' staðir' + (q || curR !== 'all' ? ' (síað)' : '');
        listEl.innerHTML = '';
        more();
      };
      const more = () => {
        const next = filtered.slice(shown, shown + PAGE);
        listEl.insertAdjacentHTML('beforeend', next.map(card).join('') || (shown === 0 ? '<div class="ef-load">Engir staðir fundust.</div>' : ''));
        shown += next.length;
        moreEl.hidden = shown >= filtered.length;
      };
      const withLeaflet = (cb) => {
        if (window.L) return cb();
        if (!document.getElementById('leaflet-css')) { const l = document.createElement('link'); l.id = 'leaflet-css'; l.rel = 'stylesheet'; l.href = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.css'; document.head.appendChild(l); }
        if (!document.getElementById('leaflet-js')) { const s = document.createElement('script'); s.id = 'leaflet-js'; s.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js'; document.head.appendChild(s); }
        const iv = setInterval(() => { if (window.L) { clearInterval(iv); cb(); } }, 60);
        setTimeout(() => clearInterval(iv), 10000);
      };
      const drawMap = (rows) => {
        const pts = rows.filter((s) => typeof s.lat === 'number' && typeof s.lng === 'number');
        if (!pts.length) return;
        const wrap = document.getElementById('ef-mapwrap'); if (!wrap) return;
        wrap.hidden = false;
        document.getElementById('ef-mapn').textContent = '· ' + pts.length + ' af ' + rows.length + ' staðsett';
        withLeaflet(() => {
          const el = document.getElementById('ef-map'); if (!el || el.dataset.done) return;
          el.dataset.done = '1';
          const map = window.L.map(el, { scrollWheelZoom: false }).setView([64.13, -21.90], 12);
          el._map = map;                                        // flipa-rofinn þarf hann (invalidateSize)
          window.L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', { attribution: '© OpenStreetMap', maxZoom: 19 }).addTo(map);
          const bounds = [];
          pts.forEach((s) => {
            window.L.circleMarker([s.lat, s.lng], { radius: 7, fillColor: RCOL[s.rating], color: '#0a0e14', weight: 1, fillOpacity: 0.92 })
              .bindPopup('<b>' + esc(s.name) + '</b><br>Einkunn ' + s.rating + '/5 · ' + esc(s.ratingLabel || '') + (s.reportUrl ? '<br><a href="' + esc(s.reportUrl) + '" target="_blank" rel="noopener">skýrsla ↗</a>' : ''))
              .addTo(map);
            bounds.push([s.lat, s.lng]);
          });
          if (bounds.length) map.fitBounds(bounds, { padding: [30, 30], maxZoom: 15 });
          [120, 500, 1200].forEach((d) => setTimeout(() => map.invalidateSize(), d));
        });
      };
      const load = () => fetch('/gogn/eftirlit.json').then((r) => r.json()).then((j) => {
        DATA = (j.stadir || []).slice().sort((a, b) => (a.rating - b.rating) || (b.lastInspectionISO || '').localeCompare(a.lastInspectionISO || ''));
        apply();
        drawMap(DATA);
      }).catch(() => { listEl.innerHTML = '<div class="ef-load">Ekki tókst að hlaða skránni.</div>'; });
      let t; qEl.addEventListener('input', () => { clearTimeout(t); t = setTimeout(apply, 180); });
      document.getElementById('ef-filt').addEventListener('click', (e) => {
        const b = e.target.closest('.ef-fb'); if (!b) return;
        document.querySelectorAll('.ef-fb').forEach((x) => x.classList.remove('active'));
        b.classList.add('active'); curR = b.dataset.r; if (DATA) apply();
      });
      moreEl.addEventListener('click', more);
      load();
    }
    document.addEventListener('astro:page-load', initEft);
  </script>

  {/* ---- Byggingarleyfi: graf + leitanleg skrá + kort (óbreytt frá /byggingarvakt/, utan bv-dist + el._map) ---- */}
  <script define:vars={{ distRows, LABELS, DCOL }}>
    function initBygg() {
      if (!document.querySelector('[data-pg="byggingarvakt"]')) return;
      const AX = '#7e8ca6', GRID = 'rgba(255,255,255,.06)', LINE = 'rgba(255,255,255,.14)';
      const esc = (s) => String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
      const GROUPS = { samth: ['samthykkt', 'jakvaett'], synj: ['synjad', 'neikvaett'], frest: ['frestad'], annad: ['afgreitt', 'visad_fra', 'afturkallad', 'annad'] };

      const drawDist = () => {
        const el = document.getElementById('bv-dist');
        if (!el || !window.echarts || window.echarts.getInstanceByDom(el)) return;
        const rows = distRows.slice().reverse();
        const c = window.echarts.init(el);
        c.setOption({
          backgroundColor: 'transparent', grid: { left: 118, right: 40, top: 8, bottom: 28 },
          tooltip: { trigger: 'axis', axisPointer: { type: 'shadow' }, formatter: (p) => p[0].name + '<br/><b>' + Number(p[0].value).toLocaleString('is-IS') + '</b> afgreiðslur' },
          xAxis: { type: 'value', axisLabel: { color: AX }, splitLine: { lineStyle: { color: GRID } } },
          yAxis: { type: 'category', data: rows.map((r) => r.label), axisLabel: { color: '#cdd6e6', fontSize: 12 }, axisLine: { lineStyle: { color: LINE } } },
          series: [{ type: 'bar', data: rows.map((r) => ({ value: r.n, itemStyle: { color: r.col, borderRadius: [0, 4, 4, 0] } })), barMaxWidth: 22, label: { show: true, position: 'right', color: '#9fb0c8', fontSize: 11.5, fontWeight: 700, formatter: (o) => Number(o.value).toLocaleString('is-IS') } }],
        });
        window.addEventListener('resize', () => c.resize());
      };
      if (window.echarts) drawDist();
      else { let s = document.getElementById('echarts-cdn'); if (!s) { s = document.createElement('script'); s.id = 'echarts-cdn'; s.src = 'https://cdn.jsdelivr.net/npm/echarts@5/dist/echarts.min.js'; document.head.appendChild(s); } s.addEventListener('load', drawDist, { once: true }); }

      const listEl = document.getElementById('bv-list'), cntEl = document.getElementById('bv-count'), moreEl = document.getElementById('bv-more'), qEl = document.getElementById('bv-q');
      if (!listEl || listEl.dataset.wired) return;
      listEl.dataset.wired = '1';
      let MEET = {}, DATA = [], filtered = [], shown = 0, curG = 'all', PAGE = 40;
      const fundUrl = (f) => (MEET[f] && MEET[f].url) || null;
      const badge = (e) => '<span class="bv-badge" style="background:' + (DCOL[e.decisionCode] || '#9fb0c8') + '">' + esc(LABELS[e.decisionCode] || e.decisionCode) + '</span>';
      const card = (e) => {
        const u = fundUrl(e.fund);
        const sz = e.sizeM2 ? ' · ' + String(e.sizeM2).replace('.', ',') + ' m²' : '';
        const pn = e.postnr != null ? String(e.postnr) : '';
        return '<div class="bv-card"><div class="bv-top">' + badge(e)
          + '<a class="bv-a" href="/fasteignavakt/?q=' + encodeURIComponent(e.addr) + '" title="Verðmat og byggingarsaga">' + esc(e.addr) + '</a></div>'
          + '<div class="bv-desc">' + esc(e.desc || 'Byggingarleyfi') + '</div>'
          + '<div class="bv-meta"><span>' + esc([e.hverfi, e.date].filter(Boolean).join(' · ')) + sz + '</span>'
          + (u ? '<a href="' + esc(u) + '" target="_blank" rel="noopener">fundargerð ↗</a>' : '') + '</div>'
          + (pn ? '<button type="button" class="bv-vakta" data-pn="' + esc(pn) + '" data-addr="' + esc(e.addr || '') + '">🔔 Vakta þetta svæði</button>' : '')
          + '</div>';
      };
      const apply = () => {
        const q = (qEl.value || '').toLowerCase().trim();
        const codes = curG === 'all' ? null : GROUPS[curG];
        filtered = DATA.filter((e) => (!codes || codes.includes(e.decisionCode))
          && (!q || (e.addr || '').toLowerCase().includes(q) || (e.hverfi || '').toLowerCase().includes(q)));
        shown = 0;
        cntEl.textContent = filtered.length.toLocaleString('is-IS') + ' afgreiðslur' + (q || codes ? ' (síað)' : '') + ' · nýjustu fyrst';
        listEl.innerHTML = '';
        more();
      };
      const more = () => {
        const next = filtered.slice(shown, shown + PAGE);
        listEl.insertAdjacentHTML('beforeend', next.map(card).join('') || (shown === 0 ? '<div class="bv-load">Engar afgreiðslur fundust.</div>' : ''));
        shown += next.length;
        moreEl.hidden = shown >= filtered.length;
      };
      const withLeaflet = (cb) => {
        if (window.L) return cb();
        if (!document.getElementById('leaflet-css')) { const l = document.createElement('link'); l.id = 'leaflet-css'; l.rel = 'stylesheet'; l.href = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.css'; document.head.appendChild(l); }
        if (!document.getElementById('leaflet-js')) { const s = document.createElement('script'); s.id = 'leaflet-js'; s.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js'; document.head.appendChild(s); }
        const iv = setInterval(() => { if (window.L) { clearInterval(iv); cb(); } }, 60);
        setTimeout(() => clearInterval(iv), 10000);
      };
      const drawMap = () => {
        const pts = DATA.filter((e) => typeof e.lat === 'number' && typeof e.lng === 'number');
        if (!pts.length) return;
        const wrap = document.getElementById('bv-mapwrap'); if (!wrap) return;
        wrap.hidden = false;
        document.getElementById('bv-mapn').textContent = '· ' + pts.length + ' af ' + DATA.length + ' staðsett';
        withLeaflet(() => {
          const el = document.getElementById('bv-map'); if (!el || el.dataset.done) return;
          el.dataset.done = '1';
          const map = window.L.map(el, { scrollWheelZoom: false }).setView([64.13, -21.90], 12);
          el._map = map;                                        // flipa-rofinn þarf hann (invalidateSize)
          window.L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', { attribution: '© OpenStreetMap', maxZoom: 19 }).addTo(map);
          const bounds = [];
          pts.forEach((e) => {
            const u = fundUrl(e.fund);
            window.L.circleMarker([e.lat, e.lng], { radius: 6, fillColor: DCOL[e.decisionCode] || '#9fb0c8', color: '#0a0e14', weight: 1, fillOpacity: 0.9 })
              .bindPopup('<b>' + esc(e.addr) + '</b><br>' + esc(LABELS[e.decisionCode] || '') + ' · ' + esc(e.date || '') + '<br>' + esc((e.desc || '').slice(0, 90)) + (u ? '<br><a href="' + esc(u) + '" target="_blank" rel="noopener">fundargerð ↗</a>' : ''))
              .addTo(map);
            bounds.push([e.lat, e.lng]);
          });
          if (bounds.length) map.fitBounds(bounds, { padding: [30, 30], maxZoom: 15 });
          [120, 500, 1200].forEach((d) => setTimeout(() => map.invalidateSize(), d));
        });
      };
      fetch('/gogn/byggingarleyfi_vakt.json').then((r) => r.json()).then((j) => {
        MEET = j.meetings || {};
        DATA = j.recent || [];
        apply();
        drawMap();
      }).catch(() => { listEl.innerHTML = '<div class="bv-load">Ekki tókst að hlaða skránni.</div>'; });
      let t; qEl.addEventListener('input', () => { clearTimeout(t); t = setTimeout(apply, 180); });
      document.getElementById('bv-filt').addEventListener('click', (e) => {
        const b = e.target.closest('.bv-fb'); if (!b) return;
        document.querySelectorAll('.bv-fb').forEach((x) => x.classList.remove('active'));
        b.classList.add('active'); curG = b.dataset.g; if (DATA.length) apply();
      });
      moreEl.addEventListener('click', more);
    }
    document.addEventListener('astro:page-load', initBygg);
  </script>

  {/* ---- Vakta-hnappar (þurfa import → sér blokk, event-delegation á listana) ---- */}
  <script>
    import { karpGet, karpPost, loginHref } from '../lib/auth.js';
    function initEbVakta() {
      // 🔔 Vakta félagið → firmavakt (eftirlit). Toggle.
      const efList = document.getElementById('ef-list');
      if (efList && !efList.dataset.vaktaWired) {
        efList.dataset.vaktaWired = '1';
        efList.addEventListener('click', async (e) => {
          const b = e.target.closest('.ef-vakta');
          if (!b || b.disabled) return;
          const kt = b.dataset.kt || '', nafn = b.dataset.nafn || '';
          if (!kt) return;
          b.disabled = true;
          const t0 = b.textContent;
          try {
            const cur = await karpGet('/firmavakt');
            if (!cur || !Array.isArray(cur.felog)) { location.href = loginHref(); return; }
            const has = cur.felog.some((x) => x && x.kt === kt);
            const felog = has ? cur.felog.filter((x) => !(x && x.kt === kt)) : cur.felog.concat([{ kt, nafn }]);
            const r = await karpPost('/firmavakt', { on: true, felog });
            if (!r || r.ok !== true) throw new Error('save');
            b.classList.toggle('on', !has);
            b.textContent = !has ? '✓ Á vaktinni · 🔕 hætta' : '🔔 Vakta félagið';
          } catch (err) {
            b.textContent = '⚠ Villa — reyndu aftur';
            setTimeout(() => { b.textContent = t0; }, 2400);
          }
          b.disabled = false;
        });
      }

      // 🔔 Vakta þetta svæði → fastvakt (q=póstnúmer). ADD-ONLY, cap 6.
      const bvList = document.getElementById('bv-list');
      if (bvList && !bvList.dataset.vaktaWired) {
        bvList.dataset.vaktaWired = '1';
        bvList.addEventListener('click', async (e) => {
          const b = e.target.closest('.bv-vakta');
          if (!b || b.disabled) return;
          const q = b.dataset.pn || '';
          if (!q) return;
          b.disabled = true;
          const t0 = b.textContent;
          try {
            const cur = await karpGet('/fastvakt');
            if (!cur || !Array.isArray(cur.vaktir)) { location.href = loginHref(); return; }
            const has = cur.vaktir.some((v) => v && v.q === q);
            if (has) { b.classList.add('on'); b.textContent = '✓ Á vaktinni'; return; }
            if (cur.vaktir.length >= 6) {
              b.textContent = 'Hámark 6 vaktir náð';
              setTimeout(() => { b.textContent = t0; b.disabled = false; }, 2600);
              return;
            }
            const vaktir = cur.vaktir.concat([{ q }]).slice(0, 6);
            const r = await karpPost('/fastvakt', { on: true, vaktir });
            if (!r || r.ok !== true) throw new Error('save');
            b.classList.add('on');
            b.textContent = '✓ Á vaktinni';
          } catch (err) {
            b.textContent = '⚠ Villa — reyndu aftur';
            setTimeout(() => { b.textContent = t0; b.disabled = false; }, 2600);
          }
        });
      }
    }
    document.addEventListener('astro:page-load', initEbVakta);
  </script>
</Layout>
