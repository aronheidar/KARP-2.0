---
// ─────────────────────────────────────────────────────────────
// Ívilnanir & stuðningur (#2 LOTA 7) — 53 ívilnana-/styrkjaleiðir ríkisins (heiti aðgreint frá /styrkir/)
// (ivilnanir.json), flokkaðar og með stöðu. Eins og gamli Alþingis-flipinn.
// ─────────────────────────────────────────────────────────────
import Layout from '../layouts/Layout.astro';
import ThingTabs from '../components/ThingTabs.astro';
import IVILNANIR from '@gogn/ivilnanir.json';
import VAKT from '@gogn/ivilnanir_vakt.json';

const FLOKKAR = { atvinnulif: 'Atvinnulíf', nyskopun: 'Nýsköpun & rannsóknir', orkuskipti: 'Orkuskipti & umhverfi', husnaedi: 'Húsnæði', heimili: 'Heimili & einstaklingar', menning: 'Menning & listir', byggd: 'Byggðamál', annad: 'Annað' };
const groups = {};
(Array.isArray(IVILNANIR) ? IVILNANIR : []).forEach((x) => {
  const f = FLOKKAR[x.flokkur] ? x.flokkur : 'annad';
  (groups[f] = groups[f] || []).push(x);
});
const order = Object.keys(FLOKKAR).filter((f) => groups[f]?.length);
const total = (Array.isArray(IVILNANIR) ? IVILNANIR : []).length;
const tel = (s) => (Array.isArray(IVILNANIR) ? IVILNANIR : []).filter((x) => x.stada === s).length;
const nVirk = tel('virk');
const nBreytt = tel('breytt');   // í gangi, en skilmálum hefur verið breytt
const nLidin = tel('lidin');
const active = nVirk + nBreytt;  // í gildi — ekki aðeins þær óbreyttu
// Dagsetningin var HARÐKÓÐUÐ og sagði 2026-07-02 fram í september. Nú kemur hún úr vaktinni
// (skriptur/build_ivilnanir.mjs), sem staðfestir heimildirnar vikulega í CI.
const updated = VAKT.athugad;
const vaktLog = Array.isArray(VAKT.log) ? VAKT.log : [];
const iGildi = vaktLog.filter((l) => l.stada === 'i-gildi').length;
const fallin = vaktLog.filter((l) => l.stada === 'fallin').length;
// Breyting á lögunum sest á færslunni sem vitnar í þau — það er tilefni fyrir lesanda að lesa
// upp á nýtt, og einmitt það sem ritstýrð skrá getur ekki sagt sér sjálf.
const breytingar = Array.isArray(VAKT.breytingar) ? VAKT.breytingar : [];
const breytingarA = (heimild) => breytingar.filter((b) =>
  (b.snertir || []).some((m) => (heimild || '').includes(m)));
const desc = `Ívilnanir og stuðningur ríkisins — ${total} leiðir (${active} í gildi): endurgreiðslur, skattaívilnanir og stuðningskerfi eftir málaflokkum.`;
---

<Layout title="Ívilnanir & stuðningur | Karp" description={desc} canonical="https://karp.is/ivilnanir/" ogTitle="Ívilnanir & stuðningur">
  <main>
    <p class="kicker">Hagvísir Íslands · Alþingi</p>
    <ThingTabs active="ivilnanir" />
    <h1>Ívilnanir &amp; stuðningur</h1>
    <p>Stuðningskerfi ríkisins á einum stað — <strong>{total} leiðir</strong>: {nVirk} virkar, {nBreytt} með breyttum skilmálum, {nLidin} liðnar. Smelltu á færslu fyrir lýsingu.</p>
    <p class="datainfo"><i class="tip" tabindex="0" data-tip="Ívilnanir: opinberar skrár um ívilnanasamninga og byggðaaðstoð stjórnvalda.">ⓘ</i> Um gögnin á síðunni</p>

    {order.map((f) => (
      <>
        <h2>{FLOKKAR[f]} ({groups[f].length})</h2>
        <div class="grid">
          {groups[f].map((x) => (
            <details class="iv">
              <summary>
                <span class="iv-n">{x.nafn}</span>
                {/* ⚠ Var tvígilt (virk : „Lokið"), svo ALLAR 11 `breytt`-færslurnar birtust sem loknar —
                    vaxtabætur, kolefnisgjald og starfslaun listamanna með talið. Þær eru í gangi; það sem
                    breyttist eru skilmálarnir. Enginn þeirra ber lokaár í gögnunum. */}
                <span class={`iv-st ${x.stada === 'virk' ? 'on' : x.stada === 'breytt' ? 'br' : 'off'}`}
                  >{x.stada === 'virk' ? 'Virk' : x.stada === 'breytt' ? 'Breytt' : 'Lokið'}</span>
                <span class="iv-y">{x.fra}{x.til ? `–${x.til}` : '–'}</span>
              </summary>
              <div class="iv-b">{x.lysing}</div>
              {/* Heimildin var ósýnileg þótt reiturinn væri til. Hún er gagnslaus í skránni einni:
                  lesandi á að geta flett upp lagagreininni sjálfur. 44 af 53 vísa nú í staðfest lög. */}
              {x.umfang && <div class="iv-u">Umfang: {x.umfang}</div>}
              {x.heimild && <div class="iv-h">{/ekki staðfest/.test(x.heimild)
                ? <span class="iv-ost">⚠ {x.heimild}</span>
                : <>Heimild: {x.heimild}</>}</div>}
              {breytingarA(x.heimild).map((b) => (
                <div class="iv-br">↻ Lögunum var breytt {b.dags}: {b.titill}</div>
              ))}
            </details>
          ))}
        </div>
      </>
    ))}

    <p class="foot">Forþjónað (SSG) {updated}. Samantekt Karp. Allar {total} færslur vísa í frumheimild — lög, eða þau lög sem stofna sjóðinn þegar skilmálar eru settir af honum; Barnamenningarsjóður einn á sér þingsályktun að stoð. Sjálfvirk vakt staðfesti {updated} að {iGildi} af {vaktLog.length} tilvitnuðum lögum standi í gildandi lagasafni{fallin ? ` (${fallin} fallin úr gildi)` : ''}. Ekki tæmandi réttindalýsing; kannaðu skilyrði hjá viðkomandi stofnun. #3.</p>
  </main>

  <style>
    main { max-width: 820px; margin: 0 auto; padding: 44px 20px 64px; }
    .kicker { font-size: 12px; letter-spacing: .14em; text-transform: uppercase; color: var(--faint); margin: 0 0 4px; }
    h1 { font-size: 32px; margin: 0 0 10px; } p { color: var(--ink); }
    h2 { font-size: 15px; color: var(--muted); text-transform: uppercase; letter-spacing: .05em; margin: 26px 0 8px; }
    .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 8px; }
    .iv { background: rgba(255,255,255,.04); border: 1px solid rgba(255,255,255,.08); border-radius: 10px; }
    .iv[open] { border-color: rgba(246,177,59,.5); }
    .iv summary { list-style: none; cursor: pointer; padding: 10px 12px; position: relative; }
    .iv summary::-webkit-details-marker { display: none; }
    .iv-n { display: block; font-weight: 600; font-size: 13.5px; color: var(--ink); padding-right: 52px; }
    .iv-st { position: absolute; top: 10px; right: 12px; font-size: 10px; font-weight: 700; border-radius: 5px; padding: 1px 7px; }
    .iv-st.on { color: var(--bg); background: #46e08a; }
    .iv-st.br { color: var(--bg); background: #e0b446; }
    .iv-st.off { color: var(--muted); background: rgba(255,255,255,.1); }
    .iv-y { display: block; font-size: 11px; color: var(--faint); margin-top: 2px; }
    .iv-b { font-size: 12.5px; color: var(--ink); line-height: 1.55; padding: 0 12px 10px; }
    .iv-u { font-size: 12.5px; color: var(--muted); margin-top: 6px; }
    .iv-h { font-size: 12px; color: var(--faint); margin-top: 6px; line-height: 1.45; }
    .iv-br { font-size: 12px; color: var(--warn, #b26a00); margin-top: 4px; line-height: 1.45; }
    .iv-ost { color: #e0a33c; }
    .foot { font-size: 12px; color: var(--faint); margin-top: 26px; border-top: 1px solid rgba(255,255,255,.08); padding-top: 14px; }
  </style>
</Layout>
