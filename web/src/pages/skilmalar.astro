---
// ─────────────────────────────────────────────────────────────
// SSG-síða (#2) — Skilmálar & persónuvernd: lögfræðitextinn portaður ÓBREYTTUR
// úr gamla mælaborðinu (skilmalar.json, dreginn vélrænt út). Statísk. #2.
// ─────────────────────────────────────────────────────────────
import Layout from '../layouts/Layout.astro';
import SiduHaus from '../components/SiduHaus.astro';
import SK from '../data/skilmalar.json';

const updated = '2026-08-02';
const desc = 'Skilmálar og persónuverndarstefna Karp (karp.is) — notkunarskilmálar, gagnaheimildir, kökur, réttindi notenda og gagnavinnslusamningur (DPA) fyrir compliance-vörur.';
---

<Layout title="Skilmálar & persónuvernd | Karp" description={desc} canonical="https://karp.is/skilmalar/">
  <main>
    <SiduHaus kicker="Karp" titill={'Skilmálar & persónuvernd'} />

    <h2>Notkunarskilmálar</h2>
    {SK.terms.map((s) => (
      <div class="sec">
        <h3>{s.n}. {s.t}</h3>
        <div set:html={s.b} />
      </div>
    ))}

    <h2>Persónuverndarstefna</h2>
    {SK.privacy.map((s) => (
      <div class="sec">
        <h3>{s.n}. {s.t}</h3>
        <div set:html={s.b} />
      </div>
    ))}

    <h2>Gagnavinnslusamningur (Karp sem vinnsluaðili)</h2>
    <p class="dpa-intro">Þessi gagnavinnslusamningur (DPA) á við þegar áskrifandi að compliance-vörum Karp (Áreiðanleikavaktin, Firma-account) vinnur persónuupplýsingar um eigin viðskiptavini — þá er áskrifandinn ábyrgðaraðili og Karp vinnsluaðili skv. 28. gr. GDPR. Hann er hluti af Fyrirtæki+ skilmálum. Fyrirspurnir: <a href="mailto:personuvernd@karp.is">personuvernd@karp.is</a>.</p>
    {SK.dpa.map((s) => (
      <div class="sec" id={s.id}>
        <h3>{s.n}. {s.t}</h3>
        <div set:html={s.b} />
      </div>
    ))}

    <p class="foot">Síðast uppfært {updated}. Spurningar: sjá lið 1 í persónuverndarstefnu.</p>
  </main>

  <style>
    main { max-width: 720px; margin: 0 auto; padding: 44px 20px 64px; }
    /* VIK (fasi 4c): eigin h1-stig — 30px og 14px spassia, EKKI jafngilt global .sh h1 (32px / 10px). Stendur. */
    h2 { font-size: 16px; color: var(--gold); text-transform: uppercase; letter-spacing: .05em; margin: 28px 0 10px; }
    .sec h3 { font-size: 14.5px; color: var(--ink); margin: 14px 0 4px; }
    .sec :global(p) { font-size: 13.5px; color: var(--ink); line-height: 1.6; margin: 0 0 6px; }
    .sec :global(a) { color: var(--muted); }
    .sec :global(ul) { font-size: 13.5px; color: var(--ink); margin: 4px 0 8px; padding-left: 20px; }
    .foot { font-size: 12px; color: var(--faint); margin-top: 26px; border-top: 1px solid rgba(255,255,255,.08); padding-top: 14px; }
    .draft-note { background: rgba(246,177,59,.09); border: 1px solid rgba(246,177,59,.35); border-radius: 8px; padding: 12px 14px; font-size: 13px; color: var(--ink); line-height: 1.55; margin: 4px 0 16px; }
    .draft-note b { color: var(--gold); }
    .draft-note :global(a), .draft-note a { color: var(--gold); }
  </style>
</Layout>
