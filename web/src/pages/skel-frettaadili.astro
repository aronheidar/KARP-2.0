---
// ─────────────────────────────────────────────────────────────────────────────
// WORKER-SSR SKEL fyrir /frettir/<slug>/ (SEO — indexeranleg fréttasíða aðila).
// RENDERAST ALDREI beint. worker.js:frettaAdiliHandler sækir þessa byggðu HTML
// úr ASSETS og string-replace-ar %%KARP_*%% tóka fyrir per-aðila efni.
// Sama mynstur og skel-fyrirtaeki: einn haus/nav/footer, ekkert tvíritað Layout.
// noindex hér (hrá skelin má ALDREI indexast); worker fjarlægir robots-metað
// þegar hann ber fram raunverulegan aðila. Útilokuð úr sitemap (astro.config).
// ⚠ CSS = is:global — worker-sprautað efni fær ALDREI Astro-scoped stíla
//   (data-astro-cid er ekki á keyrslutíma-HTML). Sjá [[karp-dev-verify]].
// ─────────────────────────────────────────────────────────────────────────────
import Layout from '../layouts/Layout.astro';
---
<Layout
  title="%%KARP_TITLE%%"
  description="%%KARP_DESC%%"
  canonical="%%KARP_CANON%%"
  ogTitle="%%KARP_OGTITLE%%"
  jsonLd={"%%KARP_JSONLD%%"}
  noindex={true}
>
  <main class="fa-wrap" data-pg="frettaadili">%%KARP_MAIN%%</main>

  <style is:global>
    .fa-wrap { max-width: 860px; margin: 0 auto; padding: 40px 20px 64px; }
    .fa-wrap h1 { font-size: 30px; margin: 0 0 6px; color: var(--ink); }
    .fa-kicker { font-size: 12px; letter-spacing: .14em; text-transform: uppercase; color: var(--faint); margin: 0 0 4px; }
    .fa-lead { color: var(--muted); font-size: 14.5px; line-height: 1.6; margin: 0 0 20px; }
    .fa-kpis { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; margin: 18px 0 24px; }
    .fa-kpi { background: rgba(255,255,255,.04); border: 1px solid rgba(255,255,255,.08); border-radius: 12px; padding: 12px 14px; }
    .fa-kpi .l { font-size: 12px; color: var(--muted); }
    .fa-kpi .v { font-size: 26px; font-weight: 800; color: var(--gold); margin-top: 2px; font-variant-numeric: tabular-nums; }
    .fa-kpi .s { font-size: 11px; color: var(--faint); margin-top: 2px; }
    .fa-wrap h2 { font-size: 18px; color: var(--ink); margin: 28px 0 8px; }
    .fa-sub { font-size: 13px; color: var(--muted); margin: 0 0 12px; line-height: 1.5; }
    .fa-row { display: grid; grid-template-columns: 132px 1fr 54px; gap: 12px; align-items: center; padding: 5px 0; font-size: 13px; border-bottom: 1px solid var(--line); }
    .fa-row .b { height: 10px; border-radius: 5px; background: rgba(255,255,255,.06); position: relative; }
    .fa-row .b i { position: absolute; left: 0; top: 0; bottom: 0; border-radius: 5px; background: var(--gold); }
    .fa-row .n { text-align: right; color: var(--muted); font-variant-numeric: tabular-nums; }
    .fa-news { list-style: none; padding: 0; margin: 8px 0 0; }
    .fa-news li { padding: 9px 0; border-bottom: 1px solid var(--line); }
    .fa-news a { color: var(--ink); text-decoration: none; font-size: 14px; font-weight: 600; line-height: 1.45; }
    .fa-news a:hover { color: var(--gold); }
    .fa-news .m { display: block; margin-top: 3px; font-size: 11.5px; color: var(--faint); }
    .fa-t { display: inline-block; width: 8px; height: 8px; border-radius: 50%; margin-right: 6px; vertical-align: middle; }
    .fa-t.p { background: #46e08a; } .fa-t.n { background: #ff6d7a; } .fa-t.h { background: #7e8ca6; }
    .fa-note { font-size: 12px; color: var(--faint); line-height: 1.6; margin-top: 22px; border-top: 1px solid var(--line); padding-top: 12px; }
    .fa-cta { display: inline-block; margin-top: 14px; color: var(--gold); font-weight: 700; text-decoration: none; font-size: 14px; }
    @media (max-width: 560px) { .fa-row { grid-template-columns: 100px 1fr 44px; } }
  </style>
</Layout>
