        if (gamaltSamtal) $('stj-samtal-texti').value = gamaltSamtal;
        const sm = $('stj-samtal'); if (sm) sm.scrollTop = sm.scrollHeight;
        teiknaViku();
        tengjaSamtal();
        tengjaGreinar();
      }
      // 🙋 Smellur á andlitið → veifa. Hylkið er sett AÐEINS þegar teikningin ber .av-hond, svo
