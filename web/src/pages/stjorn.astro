---
// /stjorn/ — STJÓRNBORÐ (admin-bakendi karp.is). Aðeins stjórnendur (is_admin).
// Sýnir notendur, áskriftir, keyptar skýrslur, tekjur og umferð beint úr D1
// gegnum worker /api/admin/overview (+ /api/u/burst). Fyrsti fasi hýbríð-flutnings
// stjórnborðsins: gögnin á Cloudflare, AI-agentarnir keyra áfram á Node og lesa sömu D1.
import Layout from '../layouts/Layout.astro';
const desc = 'Stjórnborð Karp — yfirlit notenda, áskrifta og reksturs. Aðeins stjórnendur.';
---
<Layout title="Stjórnborð — Karp" description={desc} canonical="https://karp.is/stjorn/" noindex={true}>
  <main data-pg="stjorn" class="stj-wrap">
    <div id="stj-gate" class="stj-gate">Sæki…</div>
    <div id="stj-body" hidden>
      <header class="stj-head">
        <h1>🛠️ Stjórnborð</h1>
        <span class="stj-sub">Rekstraryfirlit — aðeins stjórnendur</span>
      </header>

      <section class="stj-block" id="stj-bidur-wrap" hidden>
        <h2>Bíður þín <span class="stj-hola-n" id="stj-bidur-n"></span></h2>
        <div id="stj-bidur"></div>
      </section>

      <nav class="stj-rond" id="stj-rond" aria-label="Starfsfólk"></nav>
      <div id="stj-spjald" hidden></div>
      <div id="stj-forstofa">

      <section class="stj-cards" id="stj-cards"></section>

      <section class="stj-block" id="stj-heilsa-wrap" hidden>
        <h2 style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">🩺 Gagnaheilsa <span id="stj-heilsa-fresh" style="color:var(--faint);font-size:12px;font-weight:400"></span><button type="button" id="stj-refresh" class="stj-refresh" style="margin-left:auto">🔄 Sækja fersk gögn</button></h2>
        <div id="stj-heilsa-cov" class="stj-heilsa-cov"></div>
        <div id="stj-heilsa" class="stj-heilsa"></div>
      </section>

      <section class="stj-block" id="stj-voxtur-wrap" hidden>
        <div class="stj-grid2">
          <div><h2>📈 MRR-þróun</h2><div id="stj-mrr-chart"></div></div>
          <div><h2>🫧 Umbreytingar-trekt</h2><div id="stj-funnel"></div></div>
        </div>
      </section>

      <section class="stj-block">
        <details id="stj-notendur-d">
          <summary><h2 style="display:inline">👥 Viðskiptavinir (<span id="stj-ucount">0</span>)</h2></summary>
          <div class="stj-toolbar">
            <input type="search" id="stj-search" class="stj-search" placeholder="Leita — netfang, nafn eða kt…" autocomplete="off" />
            <div class="stj-filters" id="stj-filters">
              <button type="button" class="stj-chip on" data-f="all">Allir</button>
              <button type="button" class="stj-chip" data-f="paying">Borgandi</button>
              <button type="button" class="stj-chip" data-f="unverified">Óstaðfest</button>
              <button type="button" class="stj-chip" data-f="sub">Með áskrift</button>
              <button type="button" class="stj-chip" data-f="admin">Stjórnendur</button>
            </div>
          </div>
          <div class="stj-tablewrap">
            <table class="stj-table" id="stj-users">
              <thead><tr><th data-sort="id">#</th><th data-sort="email">Netfang</th><th>Tegund</th><th data-sort="name">Nafn</th><th data-sort="tier">Þrep</th><th>Áskriftir</th><th data-sort="reports">Skýrslur</th><th data-sort="verified">Staðf.</th><th data-sort="created">Skráð</th><th></th></tr></thead>
              <tbody></tbody>
            </table>
          </div>
        </details>
      </section>

      <section class="stj-grid2">
        <div class="stj-block"><h2>💳 Virkar áskriftir</h2><div id="stj-subs" class="stj-kv"></div></div>
        <div class="stj-block"><h2>📄 Seldar skýrslur</h2><div id="stj-reports" class="stj-kv"></div></div>
      </section>

      <section class="stj-block">
        <h2>⏳ Rennur út — endurnýjunarvakt</h2>
        <div id="stj-expiring" class="stj-kv"></div>
      </section>

      <section class="stj-block">
        <h2>🕐 Nýjustu skýrslukaup</h2>
        <div id="stj-recent" class="stj-kv"></div>
      </section>

      <section class="stj-block" id="stj-emails-wrap" hidden>
        <h2>✉️ Póstar sem kerfið sendir <span id="stj-emails-n" style="color:var(--faint);font-size:12px;font-weight:400"></span></h2>
        <p class="stj-note" style="margin:0 0 4px">Smelltu á póst til að skoða sniðmátið og breyta því. Vistuð breyting gildir strax á næsta pósti sem fer út; sjálfgefni textinn helst þar til þú vistar.</p>
        <div id="stj-emails"></div>
      </section>

      <section class="stj-block">
        <h2>🧾 Aðgerðaskrá <span style="color:var(--faint);font-size:12px;font-weight:400">— síðustu admin-aðgerðir</span></h2>
        <div id="stj-audit" class="stj-kv"></div>
      </section>

      </div>

      <!-- 🏛️ Moot — ráðsalur persónanna (Bobiverse). Salurinn (8 sæti + Arons-stóll) er byggður einu sinni á keyrslutíma úr
           avatarSvg() (fastir SVG-strengir úr personur.mjs); allt annað sem birtist hér kemur úr /api/admin/moot og fer gegnum esc(). -->
      <section class="stj-block" id="stj-moot-wrap">
        <h2>🏛️ Moot — ráðsalur <span id="stj-moot-sub" style="color:var(--faint);font-size:12px;font-weight:400"></span></h2>
        <p class="stj-note" style="margin:0 0 10px">Ráðið kemur saman um eitt mál í einu. Persónurnar eru AI-ráðgjöf — allt sem þær leggja til er tillaga; þú greiðir lokaatkvæði.</p>
        <div id="stj-moot-salur" class="stj-moot-salur"></div>
        <div id="stj-moot-kort" class="stj-moot-kort" hidden></div>
        <div class="stj-moot-toolbar">
          <select id="stj-moot-val" class="stj-moot-val"><option value="">— veldu opið mál —</option></select>
          <button type="button" class="stj-btn" id="stj-moot-halda" disabled>🏛️ Kalla saman Moot</button>
          <span id="stj-moot-stada" class="stj-moot-stada"></span>
          <span id="stj-moot-err" style="color:#c0392b;font-size:13px"></span>
        </div>
        <div id="stj-moot-svid" class="stj-moot-svid" hidden>
          <div id="stj-moot-innlegg" class="stj-moot-innlegg-list"></div>
          <button type="button" id="stj-moot-skip" class="stj-moot-skip" hidden>⏩ Hoppa á niðurstöðu</button>
          <div id="stj-moot-nidurstada"></div>
          <div id="stj-moot-gavel"></div>
          <div id="stj-moot-meta" class="stj-moot-meta"></div>
        </div>
      </section>

      <section class="stj-block" id="stj-tix-wrap">
        <h2>🎫 Hjálparbeiðnir &amp; póstur <span class="w-sub" id="stj-tix-sub" style="color:var(--faint);font-size:12px;font-weight:400"></span>
          <button type="button" class="stj-btn stj-btn-sm" id="stj-tix-rofi" style="float:right"></button></h2>
        <p class="stj-note" style="margin:0 0 10px">Þjónustufulltrúinn (AI) tekur við hverri beiðni á hjalp@karp.is: sendir staðfestingu, svarar þekktum spurningum orðrétt úr þekkingargrunni og leggur annars fram svar-tillögu eða CTO-brief sem bíður þín hér. Allur þráðurinn — inn og út — sést á hverri beiðni.</p>
        <div class="stj-cards" id="stj-tix-cards" style="margin-bottom:14px"></div>
        <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:10px">
          <label class="stj-note" style="margin:0"><input type="checkbox" id="stj-tix-allir"> sýna lokaðar</label>
          <button type="button" class="stj-btn stj-btn-sm" id="stj-tix-nyr">✉️ Nýr póstur</button>
          <button type="button" class="stj-btn stj-btn-sm" id="stj-tix-saekja" title="Les póst sem barst BEINT á hjalp@karp.is og býr til beiðnir. Keyrir líka sjálfkrafa á 3 klst fresti.">📥 Sækja póst</button>
          <span class="stj-note" id="stj-tix-postur" style="margin:0;align-self:center"></span>
        </div>
        <div id="stj-tix-compose" class="stj-tix-compose" hidden>
          <input id="stj-tix-c-til" placeholder="Netfang viðtakanda" type="email">
          <input id="stj-tix-c-efni" placeholder="Efni">
          <textarea id="stj-tix-c-texti" rows="5" placeholder="Texti — sendist frá hjalp@karp.is og verður ticket með fullum þræði"></textarea>
          <div style="display:flex;gap:8px"><button type="button" class="stj-btn" id="stj-tix-c-senda">Senda</button><button type="button" class="stj-btn stj-btn-sm" id="stj-tix-c-haetta">Hætta við</button><span id="stj-tix-c-err" style="color:#c0392b;font-size:13px"></span></div>
        </div>
        <div id="stj-tix"></div>
      </section>
    </div>
  </main>

  <!-- ⚠ is:global er NAUÐSYNLEGT: allt innihald stjórnborðsins er sett inn með innerHTML á
       keyrslutíma (spjöld/töflur/raðir/póst-listi). Astro-scoped stílar verða
       `.stj-x[data-astro-cid-…]` og keyrslutíma-hnútar fá ALDREI þá eigind → engir stílar
       giltu (þess vegna límdust „Fréttavélin2 klst" / „…á Karpsjálfgefið" saman).
       Allar reglur eru `stj-`-forskeyttar og skráin hleðst aðeins á /stjorn/ → enginn leki. -->
  <style is:global>
    .stj-wrap { max-width: 1100px; margin: 0 auto; padding: 22px 16px 60px; }
    /* 🎫 Hjálparbeiðnir & póstur */
    .stj-btn { background: var(--gold, #f6b13b); color: #0b0f1a; border: 0; border-radius: 8px; padding: 7px 14px; font-weight: 600; cursor: pointer; font-size: 13.5px; }
    .stj-btn:disabled { opacity: .5; cursor: default; }
    .stj-btn-sm { background: var(--panel); color: var(--muted); border: 1px solid var(--line); font-weight: 500; padding: 5px 10px; }
    .stj-tix-compose { display: grid; gap: 8px; padding: 12px; border: 1px solid var(--line); border-radius: 10px; background: var(--panel); margin-bottom: 12px; }
    .stj-tix-compose input, .stj-tix-compose textarea, .stj-tix-svar { width: 100%; box-sizing: border-box; background: var(--bg, #0b0f1a); color: var(--ink); border: 1px solid var(--line); border-radius: 8px; padding: 8px 10px; font: inherit; font-size: 13.5px; }
    .stj-tix-row { border: 1px solid var(--line); border-radius: 10px; margin-bottom: 8px; background: var(--panel); }
    .stj-tix-row > summary { list-style: none; cursor: pointer; padding: 10px 12px; font-size: 13.5px; color: var(--ink); display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
    .stj-tix-row > summary::-webkit-details-marker { display: none; }
    .stj-tix-nr { color: var(--gold); font-weight: 700; }
    .stj-tix-st { margin-left: auto; font-weight: 600; font-size: 12.5px; white-space: nowrap; }
    .stj-tix-body { padding: 4px 12px 12px; border-top: 1px solid var(--line); font-size: 13.5px; }
    .stj-msgs { display: grid; gap: 8px; margin: 10px 0; }
    .stj-msg { padding: 8px 10px; border-radius: 10px; max-width: 92%; white-space: pre-wrap; word-break: break-word; }
    .stj-msg-in { background: rgba(91,141,214,.12); border: 1px solid rgba(91,141,214,.35); justify-self: start; }
    .stj-msg-out { background: rgba(246,177,59,.10); border: 1px solid rgba(246,177,59,.35); justify-self: end; }
    .stj-msg-meta { font-size: 11.5px; color: var(--faint); margin-bottom: 4px; }
    .stj-tix-ai { margin: 8px 0; padding: 8px 10px; border-radius: 8px; background: rgba(70,224,138,.08); border: 1px solid rgba(70,224,138,.3); font-size: 13px; }
    .stj-tix-actions { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; margin-top: 8px; }
    .stj-tix-notur { margin-top: 8px; font-size: 12.5px; color: var(--muted); white-space: pre-wrap; border-left: 2px solid var(--line); padding-left: 8px; }
    .stj-gate { padding: 60px 20px; text-align: center; color: var(--muted); font-size: 15px; }
    .stj-head { display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; margin-bottom: 18px; }
    .stj-head h1 { font-size: 24px; margin: 0; color: var(--ink); }
    .stj-sub { color: var(--faint); font-size: 13px; }
    .stj-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; margin-bottom: 24px; }
    .stj-card { background: var(--surface); border: 1px solid var(--line); border-radius: 12px; padding: 14px 16px; }
    .stj-card .n { font-size: 26px; font-weight: 800; color: var(--gold); font-variant-numeric: tabular-nums; }
    .stj-card .l { font-size: 12px; color: var(--muted); margin-top: 2px; }
    .stj-card .s { font-size: 11px; color: var(--faint); margin-top: 4px; }
    .stj-block { background: var(--surface); border: 1px solid var(--line); border-radius: 12px; padding: 16px 18px; margin-bottom: 20px; }
    .stj-block h2 { font-size: 15px; margin: 0 0 12px; color: var(--ink); }
    .stj-grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
    @media (max-width: 640px) { .stj-grid2 { grid-template-columns: 1fr; } }
    .stj-tablewrap { overflow-x: auto; }
    .stj-table { width: 100%; border-collapse: collapse; font-size: 13px; }
    .stj-table th { text-align: left; color: var(--faint); font-size: 11px; text-transform: uppercase; letter-spacing: .04em; padding: 6px 10px; border-bottom: 1px solid var(--line); white-space: nowrap; }
    .stj-table td { padding: 8px 10px; border-bottom: 1px solid var(--line); color: var(--ink); white-space: nowrap; }
    .stj-table tr:hover td { background: var(--panel); }
    .stj-badge { display: inline-block; padding: 1px 7px; border-radius: 6px; font-size: 11px; font-weight: 600; background: var(--panel); color: var(--muted); margin: 0 2px 0 0; }
    .stj-badge.tier { background: rgba(246,177,59,.16); color: var(--gold); }
    .stj-badge.ok { color: #46e08a; }
    .stj-badge.admin { background: rgba(246,177,59,.16); color: var(--gold); }
    .stj-badge.test { background: rgba(150,160,175,.18); color: var(--faint); }
    .stj-test td { opacity: .5; }
    .stj-test:hover td { opacity: .8; }
    .stj-toolbar { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; margin-bottom: 12px; }
    .stj-search { flex: 1; min-width: 200px; background: var(--panel); border: 1px solid var(--line); border-radius: 8px; padding: 8px 12px; color: var(--ink); font: inherit; font-size: 13px; }
    .stj-filters { display: flex; gap: 6px; flex-wrap: wrap; }
    .stj-chip { background: var(--panel); border: 1px solid var(--line); border-radius: 999px; padding: 5px 12px; font-size: 12.5px; color: var(--muted); cursor: pointer; }
    .stj-chip.on { background: rgba(246,177,59,.16); border-color: rgba(246,177,59,.4); color: var(--gold); }
    .stj-table th[data-sort] { cursor: pointer; user-select: none; }
    .stj-table th[data-sort]:hover { color: var(--ink); }
    .stj-mng-btn { background: var(--panel); border: 1px solid var(--line); border-radius: 7px; padding: 3px 9px; cursor: pointer; color: var(--muted); font-size: 13px; }
    .stj-mng-btn:hover { color: var(--ink); border-color: var(--gold); }
    .stj-mng-row td { background: var(--panel); padding: 0; }
    .stj-mng { padding: 14px 16px; display: grid; gap: 16px; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); }
    .stj-mng h4 { margin: 0 0 8px; font-size: 11px; text-transform: uppercase; letter-spacing: .04em; color: var(--faint); }
    .stj-mng .row { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
    .stj-mng label.svc { display: flex; align-items: center; gap: 6px; font-size: 13px; color: var(--ink); white-space: nowrap; }
    .stj-mng .act { background: var(--surface); border: 1px solid var(--line); border-radius: 7px; padding: 6px 11px; cursor: pointer; color: var(--ink); font: inherit; font-size: 12.5px; }
    .stj-mng .act:hover { border-color: var(--gold); }
    .stj-mng .act.done { border-color: #46e08a; color: #46e08a; }
    .stj-mng select, .stj-mng input[type=number] { background: var(--surface); border: 1px solid var(--line); border-radius: 6px; padding: 5px 8px; color: var(--ink); font: inherit; font-size: 13px; }
    .stj-empty-row td { color: var(--faint); text-align: center; padding: 20px; }
    .stj-heilsa { display: grid; grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); gap: 2px 18px; }
    .stj-h-row { display: flex; align-items: center; gap: 8px; font-size: 13px; padding: 4px 0; }
    .stj-h-dot { width: 9px; height: 9px; border-radius: 50%; flex: none; }
    .stj-h-dot.ok { background: #46e08a; } .stj-h-dot.warn { background: #f6b13b; } .stj-h-dot.bad { background: #ef6a6a; } .stj-h-dot.unk { background: var(--faint); }
    .stj-h-row .l { color: var(--ink); flex: 1; }
    .stj-h-row .a { color: var(--muted); font-variant-numeric: tabular-nums; font-size: 12px; margin-left: auto; padding-left: 14px; white-space: nowrap; }
    .stj-refresh { background: var(--panel); border: 1px solid var(--line); border-radius: 8px; padding: 6px 12px; color: var(--ink); font: inherit; font-size: 12.5px; cursor: pointer; white-space: nowrap; }
    .stj-refresh:hover { border-color: var(--gold); color: var(--gold); }
    .stj-refresh:disabled { opacity: .6; cursor: default; }
    .stj-h-row.bad .a { color: #ef6a6a; }
    .stj-heilsa-cov { display: flex; gap: 18px; flex-wrap: wrap; margin-bottom: 12px; font-size: 13px; color: var(--muted); }
    .stj-heilsa-cov b { color: var(--gold); }
    .stj-fn-row { display: flex; align-items: center; gap: 14px; margin: 7px 0; font-size: 13px; }
    .stj-fn-l { width: 84px; color: var(--muted); flex: none; }
    .stj-fn-bar { flex: 1; height: 14px; background: var(--panel); border-radius: 7px; overflow: hidden; }
    .stj-fn-bar i { display: block; height: 100%; background: var(--gold); border-radius: 7px; }
    .stj-fn-n { width: 86px; text-align: right; color: var(--ink); font-variant-numeric: tabular-nums; flex: none; padding-left: 10px; }
    .stj-fn-n small { color: var(--faint); }
    /* Póst-skrá — RAÐIR, ekki spjöld: listinn er til að skanna, ekki safn eininga.
       Hópur: heiti + fjöldi + lína sem fyllir út → stigveldi án þess að hrópa. */
    .stj-em-grp { display: flex; align-items: baseline; gap: 10px; margin: 20px 0 8px; }
    .stj-em-grp:first-child { margin-top: 4px; }
    .stj-em-grp h3 { margin: 0; font-size: 12.5px; font-weight: 700; color: var(--muted); }
    .stj-em-grp .n { font-size: 11.5px; color: var(--faint); font-variant-numeric: tabular-nums; }
    .stj-em-grp .rule { flex: 1; height: 1px; background: var(--line); }
    .stj-em { border: 1px solid var(--line); border-radius: 10px; margin-bottom: 6px; background: var(--surface); }
    .stj-em.opin { border-color: rgba(246,177,59,.34); }
    .stj-em-hd { display: flex; align-items: center; gap: 12px; padding: 12px 14px; cursor: pointer; border-radius: 10px; }
    .stj-em-hd:hover { background: var(--panel); }
    .stj-em-hd:focus-visible { outline: 2px solid var(--gold); outline-offset: -2px; }
    .stj-em-chev { flex: none; color: var(--faint); font-size: 11px; transition: transform .18s cubic-bezier(.22,1,.36,1), color .18s; }
    .stj-em.opin .stj-em-chev { transform: rotate(90deg); color: var(--gold); }
    /* min-width:0 + flex:none á merkinu = talan/merkið límist ALDREI við efnislínuna */
    .stj-em-txt { flex: 1; min-width: 0; }
    .stj-em-nm { display: block; font-weight: 650; color: var(--ink); font-size: 13.5px; line-height: 1.3; }
    .stj-em-sub { display: block; margin-top: 4px; color: var(--muted); font-size: 12px; line-height: 1.4; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .stj-em-tag { flex: none; margin-left: 8px; font-size: 10.5px; padding: 3px 9px; border-radius: 999px; border: 1px solid var(--line); background: var(--panel); color: var(--muted); white-space: nowrap; }
    .stj-em-tag.on { border-color: rgba(246,177,59,.42); background: rgba(246,177,59,.14); color: var(--gold); }
    .stj-em-body { padding: 4px 16px 16px 40px; }   /* vinstri-inndráttur samsíða texta-dálki hausins */
    .stj-em-meta { display: grid; grid-template-columns: auto 1fr; gap: 5px 14px; font-size: 12.5px; margin: 6px 0 2px; }
    .stj-em-meta dt { color: var(--faint); white-space: nowrap; }
    .stj-em-meta dd { margin: 0; color: var(--muted); line-height: 1.5; }
    .stj-em-meta code { background: var(--panel); padding: 1px 6px; border-radius: 4px; color: var(--gold); font-size: 11.5px; }
    .stj-em-warn { margin-top: 12px; padding: 9px 11px; border: 1px solid rgba(246,177,59,.32); border-radius: 8px; background: rgba(246,177,59,.07); color: #f6b13b; font-size: 12px; line-height: 1.5; }
    .stj-em-note { margin-top: 12px; font-size: 12px; color: var(--faint); line-height: 1.5; }
    .stj-em-f { margin-top: 14px; }
    .stj-em-f label { display: block; font-size: 11px; text-transform: uppercase; letter-spacing: .04em; color: var(--faint); margin-bottom: 5px; }
    .stj-em-f input[type=text], .stj-em-f textarea { width: 100%; background: var(--panel); border: 1px solid var(--line); border-radius: 8px; color: var(--ink); font: inherit; font-size: 13px; padding: 8px 10px; resize: vertical; }
    .stj-em-f input[type=text]:focus, .stj-em-f textarea:focus { outline: none; border-color: rgba(246,177,59,.5); }
    .stj-em-f textarea { font-family: ui-monospace, Menlo, Consolas, monospace; font-size: 12px; line-height: 1.55; }
    .stj-em-actions { display: flex; gap: 8px; align-items: center; margin-top: 14px; padding-top: 12px; border-top: 1px solid var(--line); flex-wrap: wrap; }
    .stj-em-actions .act.aðal { border-color: rgba(246,177,59,.45); color: var(--gold); }
    .stj-em-err { color: #ef6a6a; font-size: 12.5px; flex: 1; min-width: 140px; }
    .stj-em-prev { background: #fff; color: #222; border-radius: 8px; padding: 12px 14px; margin-top: 12px; max-height: 280px; overflow: auto; }
    .stj-em-prev .pv-s { font-weight: 700; font-size: 13.5px; padding-bottom: 8px; margin-bottom: 10px; border-bottom: 1px solid #e6e6e6; }
    .stj-em-prev pre { white-space: pre-wrap; font-family: inherit; margin: 0; font-size: 13px; line-height: 1.55; }
    @media (prefers-reduced-motion: reduce) { .stj-em-chev { transition: none; } }
    .stj-type { background: var(--panel); color: var(--ink); border: 1px solid var(--line); border-radius: 6px; padding: 3px 6px; font: inherit; font-size: 12.5px; }
    .stj-type.stj-type-flash { outline: 2px solid #46e08a; }
    .stj-kv-row { display: flex; justify-content: space-between; gap: 14px; padding: 6px 0; border-bottom: 1px solid var(--line); font-size: 13.5px; color: var(--ink); }
    .stj-kv-row b { color: var(--gold); font-variant-numeric: tabular-nums; }
    .stj-kv-empty { color: var(--faint); font-size: 13px; }
    .stj-note { color: var(--faint); font-size: 12.5px; line-height: 1.6; margin-top: 8px; }
    .stj-denied { padding: 60px 20px; text-align: center; }
    .stj-denied h1 { font-size: 20px; color: var(--ink); }
    .stj-denied p { color: var(--muted); }
    .stj-denied a { color: var(--gold); }
    /* 🏛️ Moot — ráðsalur. Fastir hex-litir aðeins úr PERSONUR-palettu + #46e08a grænt, #ff6b6b rautt, #5b8dd6 blátt. */
    .stj-moot-salur { display: grid; grid-template-columns: repeat(auto-fit, minmax(84px, 1fr)); gap: 8px 4px; justify-items: center; padding: 10px 0 6px; }
    .stj-moot-seat { display: grid; justify-items: center; gap: 2px; padding: 6px 4px; border-radius: 12px; cursor: pointer; position: relative; transition: opacity .3s, filter .3s, transform .25s; text-align: center; }
    .stj-moot-seat:hover { background: var(--panel); }
    /* ⚠ Fókus MÁ EKKI vera eins og hover: fyrir 17.9 var outline slökkt og bæði eins, svo
       tab-lyklaborðið sá ekki hvaða sæti var valið. Gullið er tekið fyrir ræðumanninn. */
    .stj-moot-seat:focus-visible { background: var(--panel); outline: 2px solid #46e08a; outline-offset: 2px; }
    .stj-moot-seat svg { display: block; }
    .stj-moot-nafn { font-size: 12.5px; font-weight: 650; color: var(--ink); }
    .stj-moot-hlutverk { font-size: 10.5px; color: var(--faint); white-space: nowrap; }
    .stj-moot-seat--stjori .stj-moot-nafn { border-bottom: 2px solid var(--gold); }
    .stj-moot-seat--dofin { opacity: .4; filter: grayscale(.8); }
    .stj-moot-seat--komin { animation: stj-moot-koma .5s cubic-bezier(.22,1,.36,1) both; }
    .stj-moot-seat--talar { transform: scale(1.06); }
    .stj-moot-seat--talar svg { outline: 2px solid var(--gold); outline-offset: 2px; border-radius: 50%; animation: stj-moot-pulse 1.2s ease-in-out infinite; }
    .stj-moot-seat--aron .stj-moot-aron-stoll { stroke: var(--faint); }
    .stj-moot-seat--bidur .stj-moot-aron-stoll { stroke: var(--gold); animation: stj-moot-glow 1.4s ease-in-out infinite; }
    .stj-moot-seat--aron:hover { background: transparent; cursor: default; }
    .stj-moot-chip { position: absolute; right: 6px; top: 4px; font-size: 10px; font-weight: 700; padding: 1px 6px; border-radius: 999px; border: 1px solid var(--line); background: var(--surface); color: var(--muted); }
    .stj-moot-chip--med { color: #46e08a; border-color: rgba(70,224,138,.5); }
    .stj-moot-chip--moti { color: #ff6b6b; border-color: rgba(255,107,107,.5); }
    .stj-moot-chip--hja { color: var(--gold); border-color: rgba(246,177,59,.5); }
    .stj-moot-chip--aron { color: var(--gold); border-color: rgba(246,177,59,.5); }
    .stj-moot-innlegg .stj-moot-chip { position: static; margin-left: 6px; }
    .stj-moot-kort { display: grid; grid-template-columns: 120px 1fr; gap: 14px; padding: 14px; margin: 6px 0 10px; border-radius: 14px; border: 1px solid var(--line); background: var(--surface); font-size: 13.5px; color: var(--ink); }
    .stj-moot-kort p { margin: 8px 0 6px; line-height: 1.5; }
    .stj-moot-kort i { color: var(--muted); }
    .stj-moot-toolbar { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; margin: 8px 0; }
    .stj-moot-val { flex: 1; min-width: 220px; background: var(--bg, #0b0f1a); color: var(--ink); border: 1px solid var(--line); border-radius: 8px; padding: 7px 10px; font: inherit; font-size: 13.5px; }
    .stj-moot-stada { font-size: 13px; color: var(--muted); min-height: 18px; }
    .stj-moot-svid { margin-top: 12px; border-top: 1px solid var(--line); padding-top: 10px; }
    .stj-moot-innlegg-list { display: grid; gap: 8px; }
    .stj-moot-innlegg { display: grid; grid-template-columns: 32px 1fr; gap: 10px; align-items: start; padding: 8px 10px; border-radius: 10px; background: var(--panel); border: 1px solid var(--line); border-left: 3px solid var(--p, var(--line)); animation: stj-moot-koma .35s both; }
    .stj-moot-innlegg-hd { font-size: 12.5px; display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
    .stj-moot-innlegg-hd b { color: var(--ink); }
    .stj-moot-innlegg-txt { font-size: 13.5px; color: var(--ink); white-space: pre-wrap; margin-top: 3px; line-height: 1.5; }
    .stj-moot-skip { margin-top: 8px; background: var(--panel); border: 1px solid var(--line); color: var(--muted); border-radius: 8px; padding: 5px 10px; font-size: 12.5px; cursor: pointer; }
    .stj-moot-nidurstada { display: grid; grid-template-columns: 64px 1fr; gap: 12px; margin-top: 12px; padding: 12px; border-radius: 12px; border: 1px solid rgba(246,177,59,.4); background: rgba(246,177,59,.07); animation: stj-moot-koma .4s both; }
    .stj-moot-adgerd { font-size: 10.5px; text-transform: uppercase; letter-spacing: .05em; color: var(--gold); font-weight: 700; }
    .stj-moot-merki { font-size: 10.5px; padding: 2px 8px; border-radius: 999px; border: 1px solid var(--line); color: var(--muted); }
    .stj-moot-merki--samhljoda { color: #46e08a; border-color: rgba(70,224,138,.5); }
    .stj-moot-merki--fyrirvarar { color: var(--gold); border-color: rgba(246,177,59,.5); }
    .stj-moot-merki--klofid { color: #ff6b6b; border-color: rgba(255,107,107,.5); }
    .stj-moot-vidv--gul { color: var(--gold); border-color: rgba(246,177,59,.45); }
    .stj-moot-innlegg--stjori { border-left-color: var(--gold); background: rgba(246,177,59,.05); }
    .stj-moot-flag--osent { color: #5b8dd6; border-color: rgba(91,141,214,.5); }
    .stj-moot-merki--ha { color: #ff6b6b; border-color: rgba(255,107,107,.5); }
    .stj-moot-skref { font-size: 13px; color: var(--muted); margin-top: 6px; }
    .stj-moot-drog-hd { font-size: 11.5px; color: var(--faint); margin-top: 8px; }
    .stj-moot-drog { white-space: pre-wrap; font-family: inherit; background: var(--panel); border: 1px solid var(--line); border-radius: 8px; padding: 8px 10px; margin: 4px 0 0; font-size: 13px; color: var(--ink); }
    .stj-moot-vidv { margin-top: 8px; padding: 7px 10px; border-radius: 8px; border: 1px solid rgba(255,107,107,.45); color: #ff6b6b; font-size: 12.5px; }
    .stj-moot-fotur { font-size: 11px; color: var(--faint); margin-top: 8px; }
    .stj-moot-gavel { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; margin-top: 10px; padding-top: 10px; border-top: 1px solid var(--line); animation: stj-moot-koma .4s both; }
    .stj-moot-ja { background: #2e8b57; color: #fff; }
    .stj-moot-nei { color: #ff6b6b; border-color: rgba(255,107,107,.4); }
    .stj-moot-atkvaedi { display: flex; gap: 8px; align-items: center; margin-top: 10px; font-size: 13.5px; color: var(--gold); }
    .stj-moot-meta { font-size: 11.5px; color: var(--faint); margin-top: 8px; }
    .stj-moot-thread-line { font-size: 12.5px; color: var(--muted); padding: 6px 10px; border: 1px dashed rgba(246,177,59,.35); border-radius: 8px; justify-self: stretch; }
    .stj-moot-thread-line a { color: var(--gold); }
    .stj-moot-thread-line--aron { color: var(--gold); }
    .stj-moot-thread-line--fall { color: var(--faint); }
    .stj-moot-flag { font-size: 11px; color: var(--gold); border: 1px solid rgba(246,177,59,.4); border-radius: 999px; padding: 1px 7px; margin-left: 6px; }
    .stj-msg-meta .stj-moot-av { display: inline-block; vertical-align: middle; margin-right: 4px; }
    @keyframes stj-moot-koma { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
    @keyframes stj-moot-pulse { 0%, 100% { outline-color: rgba(246,177,59,.35); } 50% { outline-color: #f6b13b; } }
    @keyframes stj-moot-glow { 0%, 100% { stroke-opacity: .3; } 50% { stroke-opacity: 1; } }
    @media (max-width: 640px) { .stj-moot-salur { grid-template-columns: repeat(3, 1fr); } .stj-moot-kort { grid-template-columns: 1fr; } }
    /* 🙋 Svipbrigði og látbragð — knúið af klösum sem personur.mjs gefur út (av-haus ×2, av-lithimna,
       av-munnur, av-brun-v/h, av-hond, av-lok, av-likami). Engin auðkenni og ekkert url(#): SVG-ið er
       sett inn með innerHTML og margfaldast á einni síðu. Aðeins MÁLAÐAR persónur bera þessa klasa,
       svo reglurnar eru óvirkar á hinum sjö og kosta þær ekkert.
       ⚠ transform-box: view-box, EKKI fill-box — av-haus er TVEIR hópar (hár-bakið verður að liggja á
       undan öxlunum í z-röð en fylgja samt höfðinu) og með fill-box fengju þeir sinn hvorn
       snúningspunkt og hárið rynni af höfðinu. */
    .av-haus, .av-hond, .av-lithimna, .av-munnur, .av-brun-v, .av-brun-h, .av-likami { transform-box: view-box; }
    .av-haus { transform-origin: 32px 45px; }        /* hálsinn */
    .av-hond { transform-origin: 45px 58px; }        /* olnboginn */
    .av-munnur { transform-origin: 32px 38.6px; }
    .av-brun-v { transform-origin: 27px 26.5px; }
    .av-brun-h { transform-origin: 37px 26.5px; }
    .av-lok { transform-box: fill-box; transform-origin: 50% 0; }
    /* ⚠⚠ ENGIN VIÐVARANDI HREYFING. Fyrsta útgáfan hafði andardrátt og blikk á
       `.stj-moot-av`, sem er klasi SVG-RÓTARINNAR sjálfrar — svo þau hittu HVERT Sigrúnar-merki á
       síðunni: andlitaröndina og hvert 20px merki í skilaboðalistanum, eitt per agent-svar. Þrír
       rýnar mældu það sjálfstætt: tugir óendanlegra samstilltra blikka á síðu sem hefur staðandi
       reglu gegn blikkandi stöðumerkjum. Andardrátturinn var auk þess 0,25 einingar, sem er
       ómælanlegt í 64px. Hvíldarstaðan er nú alveg kyrr og blikkið lifir aðeins inni í veifunni. */
    /* smellur á andlitið á spjaldinu → veifa. Hylkið er sett af teiknaSpjald AÐEINS þegar
       teikningin ber .av-hond, svo stýringin er til nákvæmlega þegar eitthvað getur hreyfst. */
    .stj-av-smellur { display: inline-block; line-height: 0; border-radius: 50%; cursor: pointer; }
    .stj-av-smellur:focus-visible { outline: 2px solid #46e08a; outline-offset: 3px; }
    .stj-av-smellur.v-veifa .av-hond { animation: stj-av-veifa 1.55s cubic-bezier(.22,1,.36,1); }
    @keyframes stj-av-veifa {
      0%   { transform: translateY(28px) rotate(0); }
      16%  { transform: translateY(0) rotate(-15deg); }
      32%, 56%, 80% { transform: translateY(0) rotate(13deg); }
      44%, 68% { transform: translateY(0) rotate(-15deg); }
      88%  { transform: translateY(0) rotate(0); }
      100% { transform: translateY(28px) rotate(0); }
    }
    .stj-av-smellur.v-veifa .av-haus { animation: stj-av-halli 1.55s ease-in-out; }
    @keyframes stj-av-halli { 0%, 100% { transform: rotate(0); } 30%, 70% { transform: rotate(-3.5deg); } }
    .stj-av-smellur.v-veifa .av-munnur { animation: stj-av-bros 1.55s ease-in-out; }
    @keyframes stj-av-bros { 0%, 100% { transform: scaleY(1); } 45% { transform: scaleY(1.85) translateY(-.15px); } }
    .stj-av-smellur.v-veifa .av-lok { animation: stj-av-blikk .5s ease-in-out .12s; }

    /* 🙋 VIÐBRÖGÐ VIÐ RAUNVERULEGUM ATBURÐUM. Hvert viðbragð er EIN hreyfing sem klárast —
       ekkert lykkjast. Kveikt í `vidbragd()` eftir að aðgerð skilar ok, og spilað EFTIR boot()
       því boot() teiknar spjaldið upp á nýtt og myndi drepa hreyfingu sem kviknaði á undan.
       ⚠ Afmarkað við `.stj-av-smellur` (hylkið á spjaldinu), ALDREI við rót-klasann
       `.stj-moot-av` — sú villa lét blikkið hitta hvert Sigrúnar-merki á síðunni 17.9. */
    .stj-av-smellur.v-kinka .av-haus { animation: stj-av-kinka .78s ease-in-out; }
    @keyframes stj-av-kinka { 0%, 100% { transform: translateY(0) rotate(0); } 30% { transform: translateY(1.6px) rotate(4deg); } 62% { transform: translateY(.3px) rotate(1deg); } }
    .stj-av-smellur.v-hrista .av-haus { animation: stj-av-hrista .72s ease-in-out; }
    @keyframes stj-av-hrista { 0%, 100% { transform: rotate(0); } 22% { transform: rotate(-5deg); } 50% { transform: rotate(5deg); } 76% { transform: rotate(-3deg); } }
    .stj-av-smellur.v-brosa .av-munnur { animation: stj-av-bros 1.1s ease-out; }
    .stj-av-smellur.v-brosa .av-lok { animation: stj-av-hylla 1.1s ease-out; }
    @keyframes stj-av-hylla { 0%, 100% { transform: scaleY(0); } 45% { transform: scaleY(.34); } }
    .stj-av-smellur.v-efi .av-brun-h { animation: stj-av-brun-upp 1.4s ease-out; }
    .stj-av-smellur.v-efi .av-haus { animation: stj-av-halli-efi 1.4s ease-out; }
    @keyframes stj-av-brun-upp { 0%, 100% { transform: translateY(0) rotate(0); } 30%, 70% { transform: translateY(-1.3px) rotate(-6deg); } }
    @keyframes stj-av-halli-efi { 0%, 100% { transform: rotate(0); } 30%, 70% { transform: rotate(2.6deg); } }
    .stj-av-smellur.v-lita .av-brun-v, .stj-av-smellur.v-lita .av-brun-h { animation: stj-av-brunir-upp .9s ease-out; }
    @keyframes stj-av-brunir-upp { 0%, 100% { transform: translateY(0); } 40% { transform: translateY(-.9px); } }
    .stj-av-smellur.v-snua .av-haus { animation: stj-av-snua 1.6s cubic-bezier(.22,1,.36,1); }
    .stj-av-smellur.v-snua .av-lithimna { animation: stj-av-lita-hlid 1.6s cubic-bezier(.22,1,.36,1); }
    @keyframes stj-av-snua { 0%, 100% { transform: rotate(0) translateX(0); } 25%, 70% { transform: rotate(4deg) translateX(1.4px); } }
    @keyframes stj-av-lita-hlid { 0%, 100% { transform: translate(0, 0); } 25%, 70% { transform: translate(1.5px, 0); } }
    .stj-av-smellur.v-dapur .av-brun-v, .stj-av-smellur.v-dapur .av-brun-h { animation: stj-av-brunir-nidur 1.2s ease-out; }
    .stj-av-smellur.v-dapur .av-munnur { animation: stj-av-flatur 1.2s ease-out; }
    @keyframes stj-av-brunir-nidur { 0%, 100% { transform: translateY(0); } 40%, 70% { transform: translateY(.8px); } }
    @keyframes stj-av-flatur { 0%, 100% { transform: scaleY(1); } 45%, 70% { transform: scaleY(.15); } }
    /* „Hugsar" meðan beiðni til hennar er í gangi: HALDIN STELLING, ekki lykkja. Hylkið fær
       klasann í byrjun beiðnar og missir hann í `finally`; transition ber hana inn og út.
       Getur ekki fest: boot() býr til nýjan hnút án klasans. */
    .stj-av-smellur .av-haus, .stj-av-smellur .av-lithimna, .stj-av-smellur .av-brun-v, .stj-av-smellur .av-brun-h { transition: transform .5s cubic-bezier(.22,1,.36,1); }
    .stj-av-smellur.v-hugsar .av-haus { transform: rotate(-5.5deg) translateY(-.4px); }
    .stj-av-smellur.v-hugsar .av-lithimna { transform: translate(-.9px, -1.1px); }
    .stj-av-smellur.v-hugsar .av-brun-v, .stj-av-smellur.v-hugsar .av-brun-h { transform: translateY(-.5px); }
    /* talar meðan svarið hennar birtist — klasinn fer af eftir tímamörk sem ráðast af lengd svarsins */
    .stj-av-smellur.v-talar .av-munnur { animation: stj-av-tal .3s steps(2, end) 11; }   /* endanlegt: CSS tryggir stöðvun (3,3 s) þótt JS bregðist */
    @keyframes stj-av-tal { 0%, 100% { transform: scaleY(1); } 50% { transform: scaleY(2.2); } }
    @keyframes stj-av-blikk { 0%, 100% { transform: scaleY(0); } 45% { transform: scaleY(1.06); } }
    @media (prefers-reduced-motion: reduce) { .stj-moot-seat--komin, .stj-moot-innlegg, .stj-moot-nidurstada, .stj-moot-gavel, .stj-moot-seat--talar svg, .stj-moot-seat--bidur .stj-moot-aron-stoll,
      .av-haus, .av-hond, .av-munnur, .av-brun-v, .av-brun-h, .av-lithimna, .av-lok, .av-likami,
      .stj-andlit svg
        { animation: none !important; transition: none !important; } }
    /* 🚪 Forstofa + andlitarönd (Task 8) — hluti af sömu global-blokk: bæði eru sett með innerHTML á keyrslutíma. */
    .stj-rond { display: flex; gap: 10px; flex-wrap: wrap; margin: 18px 0 22px; }
    .stj-andlit { position: relative; display: flex; flex-direction: column; align-items: center; gap: 2px; padding: 10px 14px; border: 1px solid var(--line); border-radius: 12px; text-decoration: none; color: inherit; background: var(--card); transition: border-color .15s, transform .15s; }
    .stj-andlit:hover { border-color: var(--gold); transform: translateY(-2px); }
    .stj-andlit--virkt { border-color: var(--gold); box-shadow: 0 0 0 1px var(--gold) inset; }
    .stj-andlit--virkt svg { transform: scale(1.18); }
    /* dofnar MYNDIN, ekki nafnið — 0,55 á öllu spjaldinu lækkaði birtuskil nafnanna (rýnin 21.9) */
    .stj-andlit svg { transition: transform .22s cubic-bezier(.22,1,.36,1), opacity .22s; }
    .stj-rond:has(.stj-andlit--virkt) .stj-andlit:not(.stj-andlit--virkt) svg { opacity: .5; }
    .stj-rond:has(.stj-andlit--virkt) .stj-andlit:not(.stj-andlit--virkt):hover svg { opacity: 1; }
    .stj-andlit-nafn { font-weight: 600; font-size: 14px; }
    .stj-andlit-hlutverk { font-size: 11px; color: var(--faint); }
    .stj-andlit-tala { position: absolute; top: 6px; right: 8px; min-width: 20px; height: 20px; padding: 0 6px; border-radius: 10px; background: #c0392b; color: #fff; font-size: 12px; font-weight: 700; display: grid; place-items: center; }
