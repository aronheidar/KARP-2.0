      // skýrslur
      const repEntries = Object.entries(s.reportsByType);
      $('stj-reports').innerHTML = repEntries.length ? repEntries.map(([k, v]) => `<div class="stj-kv-row"><span>${esc(REP[k] || k)}</span><b>${v}</b></div>`).join('') : '<div class="stj-kv-empty">Engar seldar skýrslur enn.</div>';
      // nýjustu skýrslukaup
      const rec = ov.recentReports || [];
      $('stj-recent').innerHTML = rec.length ? rec.map((r) => {
        const t = String(r.key || '').split(':')[0];
        return `<div class="stj-kv-row"><span>${esc(REP[t] || t)} <span style="color:var(--faint)">· ${esc(r.email || '—')}</span></span><b style="font-weight:600;color:var(--muted)">${dIS(r.granted)}</b></div>`;
      }).join('') : '<div class="stj-kv-empty">Engin skýrslukaup enn.</div>';

      // ⏳ Endurnýjunarvakt — áskriftir/þrep sem renna út næstu 30 daga (rautt ≤7 daga)
      const exp = ov.expiringList || [];
      $('stj-expiring').innerHTML = exp.length ? exp.map((e) => {
        const days = Math.max(0, Math.round((e.until - ov.now) / 86400));
        const what = e.kind === 'tier' ? ('Þrep: ' + esc(e.what || '')) : esc(SVC[e.what] || e.what);
        return `<div class="stj-kv-row"><span>${what} <span style="color:var(--faint)">· ${esc(e.email || '—')}</span></span><b style="font-weight:600;color:${days <= 7 ? '#f6b13b' : 'var(--muted)'}">eftir ${days} d</b></div>`;
      }).join('') : '<div class="stj-kv-empty">Ekkert rennur út næstu 30 daga. 🎉</div>';

      // ✉️ Póst-skrá — allar tegundir sem kerfið sendir + ritill (yfirskriftir vistast í D1)
      (function () {
        const wrap = $('stj-emails-wrap'), host = $('stj-emails');
        const list = ov.emails || [];
        if (!wrap || !host || !list.length) { if (wrap) wrap.hidden = true; return; }
        wrap.hidden = false;
        const nBreytt = list.filter((e) => e.breytt).length;
        $('stj-emails-n').textContent = '— ' + list.length + ' tegundir' + (nBreytt ? ' · ' + nBreytt + ' með eigin texta' : ' · allar sjálfgefnar');
        const FIELD = { subject: 'Efnislína', html: 'Meginmál (HTML)', intro: 'Inngangur — á undan listanum', footer: 'Fótur — á eftir listanum' };
        let html = '';
        for (const grp of ['Auðkenning', 'Vaktir & yfirlit', 'Innri']) {
          const items = list.filter((e) => e.hopur === grp);
          if (!items.length) continue;
          html += '<div class="stj-em-grp"><h3>' + esc(grp) + '</h3><span class="n">' + items.length + '</span><span class="rule"></span></div>';
          for (const e of items) {
            const fields = (e.ritanlegt || ['subject']).map((f) => {
              const val = e[f] == null ? '' : e[f];
              const big = f !== 'subject';
              return '<div class="stj-em-f"><label>' + FIELD[f] + '</label>'
                + (big ? '<textarea data-f="' + f + '" rows="' + (f === 'html' ? 9 : 3) + '">' + esc(val) + '</textarea>'
                       : '<input type="text" data-f="' + f + '" value="' + esc(val) + '">') + '</div>';
            }).join('');
            const vars = (e.breytur || []).map((v) => '<code>{{' + esc(v) + '}}</code>').join(' ');
            const krafist = (e.krafist || []).length
              ? '<div class="stj-em-warn">⚠ Sniðmátið verður að innihalda ' + e.krafist.map((k) => '<code>{{' + esc(k) + '}}</code>').join(', ') + ' — án hennar kemst notandinn ekki í gegn. Vistun er hafnað ef hún vantar.</div>' : '';
            const ekkiRit = e.flokkur === 'kvikur' && !(e.ritanlegt || []).includes('intro')
              ? '<div class="stj-em-note">ⓘ Meginmálið er byggt sjálfkrafa úr gögnum — aðeins efnislínan er ritanleg.</div>' : '';
            html += '<div class="stj-em" data-em="' + e.id + '">'
              + '<div class="stj-em-hd" data-emtoggle="' + e.id + '" role="button" tabindex="0" aria-expanded="false">'
              +   '<span class="stj-em-chev" aria-hidden="true">▶</span>'
              +   '<span class="stj-em-txt"><span class="stj-em-nm">' + esc(e.label) + '</span><span class="stj-em-sub">' + esc(e.subject) + '</span></span>'
              +   '<span class="stj-em-tag' + (e.breytt ? ' on' : '') + '">' + (e.breytt ? '✎ eigin texti' : 'sjálfgefið') + '</span>'
              + '</div>'
              + '<div class="stj-em-body" hidden>'
              +   '<dl class="stj-em-meta"><dt>Sendist</dt><dd>' + esc(e.hvenaer) + '</dd>'
              +   '<dt>Viðtakandi</dt><dd>' + esc(e.vidtakandi) + '</dd>'
              +   (vars ? '<dt>Breytur</dt><dd>' + vars + '</dd>' : '') + '</dl>'
              +   (e.ath ? '<div class="stj-em-note">ⓘ ' + esc(e.ath) + '</div>' : '') + krafist + ekkiRit
              +   fields
              +   '<div class="stj-em-actions"><button type="button" class="act aðal" data-emsave="' + e.id + '">Vista breytingar</button>'
              +   '<button type="button" class="act" data-emprev="' + e.id + '">Forskoða</button>'
              +   (e.breytt ? '<button type="button" class="act" data-emreset="' + e.id + '">Sjálfgefið aftur</button>' : '')
              +   '<span class="stj-em-err" data-emerr="' + e.id + '"></span></div>'
              +   '<div class="stj-em-prev" data-empv="' + e.id + '" hidden></div>'
              + '</div></div>';
          }
        }
        host.innerHTML = html;
        if (host.dataset.wired) return; host.dataset.wired = '1';
        const patchOf = (id) => { const o = {}; host.querySelectorAll('[data-em="' + id + '"] [data-f]').forEach((el) => { o[el.dataset.f] = el.value; }); return o; };
        const emToggle = (id) => {
          const row = host.querySelector('[data-em="' + id + '"]'); if (!row) return;
          const b = row.querySelector('.stj-em-body'), hd = row.querySelector('.stj-em-hd');
          const opna = b.hidden;
          b.hidden = !opna; row.classList.toggle('opin', opna);
          if (hd) hd.setAttribute('aria-expanded', opna ? 'true' : 'false');
        };
        host.addEventListener('keydown', (ev) => {   // lyklaborð: hausinn er role=button → Enter/Bil opna
          const hd = ev.target.closest('[data-emtoggle]');
          if (!hd || (ev.key !== 'Enter' && ev.key !== ' ')) return;
          ev.preventDefault(); emToggle(hd.dataset.emtoggle);
        });
        host.addEventListener('click', async (ev) => {
          const tg = ev.target.closest('[data-emtoggle]');
          if (tg) { emToggle(tg.dataset.emtoggle); return; }
          const pv = ev.target.closest('[data-emprev]');
          if (pv) {   // forskoðun: fyllir breytur með sýnigildum svo textinn sjáist eins og hann fer út
            const id = pv.dataset.emprev, p = patchOf(id), box = host.querySelector('[data-empv="' + id + '"]');
            const demo = { hlekkur: 'https://karp.is/…', kt: '5411850389', nafn: 'Jón Jónsson', fjoldi: '3', lysing: '3 ný mál', flokkur: 'Reikningar' };
            const fill = (s) => String(s || '').replace(/\{\{(\w+)\}\}/g, (m, k) => (demo[k] != null ? demo[k] : m));
            box.hidden = false;
            box.innerHTML = '<div class="pv-s">' + esc(fill(p.subject)) + '</div>'
              + (p.html ? fill(p.html) : '<pre>' + esc([fill(p.intro), '• (dæmi um færslu úr gögnum)', fill(p.footer)].filter(Boolean).join('\n\n')) + '</pre>');
            return;
          }
          const sv = ev.target.closest('[data-emsave]'), rs = ev.target.closest('[data-emreset]');
          if (!sv && !rs) return;
          const id = (sv || rs).dataset.emsave || (sv || rs).dataset.emreset;
          const btn = sv || rs, errEl = host.querySelector('[data-emerr="' + id + '"]');
          if (rs && !confirm('Endurstilla þennan póst á sjálfgefinn texta?')) return;
          errEl.textContent = ''; const orig = btn.textContent; btn.disabled = true; btn.textContent = '…';
          const body = rs ? { id, reset: true } : { id, patch: patchOf(id) };
          const r = await fetch('/api/admin/email', { method: 'POST', credentials: 'include', headers: { 'content-type': 'application/json' }, body: JSON.stringify(body) }).then((x) => x.json()).catch(() => null);
          btn.disabled = false; btn.textContent = orig;
          if (r && r.ok) { btn.classList.add('done'); setTimeout(() => { btn.classList.remove('done'); boot(); }, 700); }
          else errEl.textContent = (r && r.villa) ? r.villa : 'Villa — reyndu aftur.';
        });
      })();

      // 🧾 Aðgerðaskrá — síðustu admin-aðgerðir (audit)
      const aud = ov.audit || [];
      const emailById = (id) => { const uu = (ov.users || []).find((x) => x.id === id); return uu ? uu.email : ('#' + id); };
      $('stj-audit').innerHTML = aud.length ? aud.slice(0, 30).map((a) => {
        const tgt = a.target ? esc(emailById(a.target)) : '';
        return `<div class="stj-kv-row"><span><b style="font-weight:600;color:var(--ink)">${esc(a.action)}</b>${a.detail ? ' <span style="color:var(--faint)">' + esc(a.detail) + '</span>' : ''}${tgt ? ' → ' + tgt : ''} <span style="color:var(--faint)">· ${esc(a.by)}</span></span><b style="font-weight:600;color:var(--muted)">${dIS(a.ts)}</b></div>`;
      }).join('') : '<div class="stj-kv-empty">Engar skráðar aðgerðir enn.</div>';

      // 🎫 Hjálparbeiðnir & póstur — ticket-flæði þjónustufulltrúans (D1 tickets + ticket_msgs)
      renderTickets(ov.tickets || { list: [], open: 0, by: {}, off: false });
      // 🏛️ Moot — ráðsalurinn (sama tickets-listi; moot_bida = mál sem bíða atkvæðis Arons)
      renderMoot(ov.tickets || { list: [], moot_bida: [], moot_osent: [] });

      // 🚪 Forstofa: „Bíður þín" (EIN uppspretta, bidur_thin.mjs) + andlitaröndin sem skiptir yfir í spjald.
      sidastaSvar = ov;   // svarið úr /api/admin/overview, sótt í Promise.all ofar í boot()
      sidustuBilanir = await fetch('/api/admin/bilanir', { credentials: 'include' }).then((r) => r.json()).catch(() => ({ ok: false, bilanir: [] }));
      sidastaMarkads = await fetch('/api/admin/markadsefni', { credentials: 'include' }).then((r) => r.json()).catch(() => ({ ok: false }));
      sidastaFjarmal = await fetch('/api/admin/fjarmal', { credentials: 'include' }).then((r) => r.json()).catch(() => ({ ok: false }));
      const bidur = bidurThin({ tickets: ov.tickets || {}, bilanir: sidustuBilanir.bilanir || [], markads: sidastaMarkads, fjarmal: sidastaFjarmal, now: ov.now || Math.floor(Date.now() / 1000) });

      // EIN uppspretta með spjöldunum (bidurRod, spjald.mjs) — hér fylgir andlit eigandans með.
      $('stj-bidur').innerHTML = bidur.map((r) => {
        const p = persona(r.starfsmadur) || { nafn: '', emoji: '' };
        return bidurRod(r, { andlit: p.emoji + ' ' + p.nafn });
      }).join('');
      $('stj-bidur-n').textContent = bidur.length ? String(bidur.length) : '';
      $('stj-bidur-wrap').hidden = !bidur.length;

      $('stj-rond').innerHTML = STARFSMENN.map((id) => {
        const p = persona(id), n = bidur.filter((r) => r.starfsmadur === id).length;
        return `<a class="stj-andlit" href="#${id}" data-id="${id}" title="${esc(p.nafn)} — ${esc(p.hlutverk)}">`
          + avatarSvg(id, { size: 64 })
          + `<span class="stj-andlit-nafn">${esc(p.nafn)}</span>`
          + `<span class="stj-andlit-hlutverk">${esc(p.hlutverk)}</span>`
          + (n ? `<span class="stj-andlit-tala">${n}</span>` : '') + '</a>';
      }).join('');

      syna(location.hash);
    }

    const TIX_STADA = { nytt: ['Nýtt', 'var(--gold)'], stadfest: ['Bíður svars', 'var(--gold)'], svarad: ['Svarað', '#2e8b57'], cto: ['Hjá CTO', '#5b8dd6'], tillaga: ['Tillaga bíður þín', '#c0392b'], samthykkt: ['Samþykkt — merge & deploy í gangi', '#5b8dd6'], lagad: ['Lagað', '#2e8b57'], lokad: ['Lokað', 'var(--faint)'], hafnad: ['Hafnað', 'var(--faint)'] };
    const TIX_TEGUND = { villa: '🐞 villa', spurning: '❓ spurning', adgangur: '🔑 aðgangur', reikningur: '💳 reikningur', osk: '💡 ósk', annad: '📄 annað' };
    // 🙋 VIÐBRÖGÐ SIGRÚNAR — hreyfingarnar tengdar raunverulegum atburðum.
    // boot() teiknar spjaldið upp á nýtt eftir hverja aðgerð, og hreyfing sem kviknaði á undan
    // myndi deyja í endurteikningunni. Því er viðbragðið GEYMT hér og spilað af veifuhylki()
    // þegar nýja hylkið er til. Gamalt viðbragð (> 8 s) fellur niður svo það spilist ekki á
    // óskyldri endurteikningu síðar.
    let _bidandiVidbragd = null;
    const sigrunHylki = () => { const s = $('stj-spjald'); return s && !s.hidden ? s.querySelector('.stj-av-smellur') : null; };
    const spilaVidbragd = (h, v) => {
      if (!h || !v) return;
      const klasar = String(v).split(' ').filter(Boolean).map((x) => 'v-' + x);
      h.classList.remove(...klasar); void h.offsetWidth; h.classList.add(...klasar);
    };
    const vidbragdEftirBoot = (v) => { _bidandiVidbragd = { v, t: Date.now() }; };
    const takaBidandiVidbragd = () => {
      const b = _bidandiVidbragd; _bidandiVidbragd = null;
      return b && Date.now() - b.t < 8000 ? b.v : '';
    };
    // Haldin stelling meðan beðið er eftir svari frá henni. `finally` tryggir að hún sleppi,
    // og ef boot() teiknaði á meðan er nýi hnúturinn hvort eð er án klasans.
    const hugsarMedan = async (fn) => {
      const h = sigrunHylki(); if (h) h.classList.add('v-hugsar');
      try { return await fn(); }
      finally { const h2 = sigrunHylki(); if (h2) h2.classList.remove('v-hugsar'); }
    };
    // SAMTALIÐ lifir í minni síðunnar, yfir endurteikningu spjaldsins — ekki í D1 og ekki í
    // vafrageymslu. Efni miðanna eru persónuupplýsingar viðskiptavina og eiga ekki að sitja víðar
    // en nauðsyn krefur. Endurhleðsla hreinsar samtalið; miðarnir sjálfir standa.
    let samtalSaga = [];
    // ⚠ Í gangi-flagg í MINNI, ekki `disabled` á hnappi: boot() teiknar hnappana upp á nýtt sem virka
    //   á meðan beiðni er í gangi, og Ctrl+Enter spurði aldrei um hnappinn (rýnin 21.9).
    let _samtalIGangi = false, _lokunIGangi = false;
    const endurteiknaSamtal = () => { const sm = $('stj-samtal'); if (!sm) return; sm.innerHTML = samtalHtml(samtalSaga); sm.scrollTop = sm.scrollHeight; };
    // Hún „talar" meðan svarið birtist — hreyfing sem hættir sjálf, lengd eftir lengd svarsins.
    const talar = (texti) => {
      const h = sigrunHylki(); if (!h) return;
      h.classList.add('v-talar');
      setTimeout(() => { const h2 = sigrunHylki(); if (h2) h2.classList.remove('v-talar'); }, Math.min(3200, 500 + String(texti || '').length * 22));
    };
    const svarFra = (r) => {
      if (!r || !r.ok) return { hver: 'sigrun', texti: r && r.error === 'unconfigured' ? 'Ég næ ekki sambandi — ANTHROPIC_API_KEY vantar í worker.' : 'Ég náði ekki að svara núna. Reyndu aftur eftir smá stund.' };
      return { hver: 'sigrun', texti: String(r.svar || '').trim() || 'Ég hef ekkert að segja um þetta.', ...(r.tillaga ? { tillaga: r.tillaga } : {}) };
    };
    async function spyrja(beidni) {
      const r = await hugsarMedan(() => tixPost(beidni));
      const m = svarFra(r);
      samtalSaga = hreinsaSogu([...samtalSaga, m]);
      endurteiknaSamtal();
      if (r && r.ok) talar(m.texti); else spilaVidbragd(sigrunHylki(), 'dapur');
      if (m.tillaga) spilaVidbragd(sigrunHylki(), 'lita');
    }
    function tengjaSamtal() {
      const t = $('stj-samtal-texti'), b = $('stj-samtal-senda');
      if (!t || !b) return;
      const senda = async () => {
        const texti = t.value.trim();
        if (texti.length < 2 || _samtalIGangi) return;
        _samtalIGangi = true;
        const sagaUndan = samtalSaga;
        samtalSaga = hreinsaSogu([...samtalSaga, { hver: 'aron', texti }]);
        t.value = ''; endurteiknaSamtal();
        b.disabled = true;
        try { await spyrja({ action: 'sigrun_spjall', texti, saga: sagaUndan }); }
        finally { _samtalIGangi = false; const b2 = $('stj-samtal-senda'); if (b2) b2.disabled = false; }
      };
      b.onclick = senda;
      t.onkeydown = (e) => { if (e.key === 'Enter' && (e.ctrlKey || e.metaKey)) { e.preventDefault(); senda(); } };
      const tt = $('stj-taka-til');
      if (tt) tt.onclick = async () => {
        if (_samtalIGangi) return;
        _samtalIGangi = true;
        tt.disabled = true;
        samtalSaga = hreinsaSogu([...samtalSaga, { hver: 'aron', texti: 'Geturðu tekið til í miðunum?' }]);
        endurteiknaSamtal();
        try { await spyrja({ action: 'sigrun_tillaga' }); }
        finally { _samtalIGangi = false; const t2 = $('stj-taka-til'); if (t2) t2.disabled = false; }
      };
      // 📚 Leit að spurningum sem endurtaka sig. Svarið kemur í samtalið, tillögurnar í hlutann fyrir neðan.
      const kl = $('stj-kb-leita');
      if (kl) kl.onclick = async () => {
        if (_samtalIGangi) return;
        _samtalIGangi = true;
        kl.disabled = true;
        samtalSaga = hreinsaSogu([...samtalSaga, { hver: 'aron', texti: 'Eru einhverjar spurningar sem endurtaka sig?' }]);
        endurteiknaSamtal();
        try {
          const r = await hugsarMedan(() => tixPost({ action: 'sigrun_kb_leita' }));
          const n = r && r.ok ? (Array.isArray(r.hopar) ? r.hopar.length : 0) : -1;
          const FJ = ['', 'eina spurningu', 'tvær spurningar', 'þrjár spurningar', 'fjórar spurningar', 'fimm spurningar'];
          const texti = n < 0
            ? (r && r.error === 'unconfigured' ? 'Ég næ ekki sambandi, ANTHROPIC_API_KEY vantar í worker.' : 'Ég náði ekki að leita núna. Reyndu aftur eftir smá stund.')
            : n === 0 ? 'Ég fann enga spurningu sem hefur borist þrisvar eða oftar síðustu 60 daga.'
              : 'Ég fann ' + (FJ[n] || n + ' spurningar') + ' sem ' + (n === 1 ? 'hefur' : 'hafa') + ' borist þrisvar eða oftar. Tillögurnar eru hér fyrir neðan.';
          samtalSaga = hreinsaSogu([...samtalSaga, { hver: 'sigrun', texti }]);
          endurteiknaSamtal();
          if (n > 0) { vidbragdEftirBoot('lita'); boot(); }   // tillögurnar berast með yfirlitinu
          else if (n === 0) talar(texti);
          else spilaVidbragd(sigrunHylki(), 'dapur');
        } finally { _samtalIGangi = false; const k2 = $('stj-kb-leita'); if (k2) k2.disabled = false; }
      };
      // Tillaga: „Loka völdum" kallar loka_margt EINU SINNI. Þjónninn metur regluna AFTUR á þeirri
      // stundu og sleppir því sem hefur breyst (t.d. notandi skrifaði aftur). Aron smellir; hún ekki.
      $('stj-samtal').onclick = async (e) => {
        const kassi = e.target.closest('.stj-tillaga'); if (!kassi) return;
        const i = Number(kassi.dataset.lykill);
        if (e.target.closest('.stj-tillaga-nei')) {
          if (samtalSaga[i]) delete samtalSaga[i].tillaga;
          samtalSaga = hreinsaSogu([...samtalSaga, { hver: 'sigrun', texti: 'Allt í lagi, ég læt þá vera.' }]);
          endurteiknaSamtal(); return;
        }
        if (!e.target.closest('.stj-tillaga-ja')) return;
        const ids = [...kassi.querySelectorAll('input[type=checkbox]:checked')].map((x) => Number(x.dataset.id)).filter((n) => Number.isInteger(n) && n > 0);
        if (!ids.length || _lokunIGangi) return;
        _lokunIGangi = true;
        // úr sögunni STRAX: boot() á meðan gæti annars teiknað virka hnappa og annar smellur sent aftur
        if (samtalSaga[i]) delete samtalSaga[i].tillaga;
        endurteiknaSamtal();
        // EITT kall. `stada` skilar alltaf ok (setTicket gleypir villur), svo lykkja á því gæti sagt
        // „ég lokaði" um mið sem stendur enn opinn. loka_margt les aftur og telur aðeins það sem lokaðist.
        let r = null;
        try { r = await tixPost({ action: 'loka_margt', ids }); } finally { _lokunIGangi = false; }
