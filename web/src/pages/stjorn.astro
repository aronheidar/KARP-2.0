---
// /stjorn/ — STJÓRNBORÐ (admin-bakendi karp.is). Aðeins stjórnendur (is_admin).
// Sýnir notendur, áskriftir, keyptar skýrslur, tekjur og umferð beint úr D1
// gegnum worker /api/admin/overview (+ /api/u/burst). Fyrsti fasi hýbríð-flutnings
// stjórnborðsins: gögnin á Cloudflare, AI-agentarnir keyra áfram á Node og lesa sömu D1.
import Layout from '../layouts/Layout.astro';
const desc = 'Stjórnborð Karp — yfirlit notenda, áskrifta og reksturs. Aðeins stjórnendur.';
---
<Layout title="Stjórnborð — Karp" description={desc} canonical="https://karp.is/stjorn/" noindex={true}>
  <main data-pg="stjorn" class="stj-wrap">
    <div id="stj-gate" class="stj-gate">Sæki…</div>
    <div id="stj-body" hidden>
      <header class="stj-head">
        <h1>🛠️ Stjórnborð</h1>
        <span class="stj-sub">Rekstraryfirlit — aðeins stjórnendur</span>
      </header>

      <section class="stj-cards" id="stj-cards"></section>

      <section class="stj-block" id="stj-heilsa-wrap" hidden>
        <h2 style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">🩺 Gagnaheilsa <span id="stj-heilsa-fresh" style="color:var(--faint);font-size:12px;font-weight:400"></span><button type="button" id="stj-refresh" class="stj-refresh" style="margin-left:auto">🔄 Sækja fersk gögn</button></h2>
        <div id="stj-heilsa-cov" class="stj-heilsa-cov"></div>
        <div id="stj-heilsa" class="stj-heilsa"></div>
      </section>

      <section class="stj-block" id="stj-voxtur-wrap" hidden>
        <div class="stj-grid2">
          <div><h2>📈 MRR-þróun</h2><div id="stj-mrr-chart"></div></div>
          <div><h2>🫧 Umbreytingar-trekt</h2><div id="stj-funnel"></div></div>
        </div>
      </section>

      <section class="stj-block">
        <h2>👥 Notendur (<span id="stj-ucount">0</span>)</h2>
        <div class="stj-toolbar">
          <input type="search" id="stj-search" class="stj-search" placeholder="Leita — netfang, nafn eða kt…" autocomplete="off" />
          <div class="stj-filters" id="stj-filters">
            <button type="button" class="stj-chip on" data-f="all">Allir</button>
            <button type="button" class="stj-chip" data-f="paying">Borgandi</button>
            <button type="button" class="stj-chip" data-f="unverified">Óstaðfest</button>
            <button type="button" class="stj-chip" data-f="sub">Með áskrift</button>
            <button type="button" class="stj-chip" data-f="admin">Stjórnendur</button>
          </div>
        </div>
        <div class="stj-tablewrap">
          <table class="stj-table" id="stj-users">
            <thead><tr><th data-sort="id">#</th><th data-sort="email">Netfang</th><th>Tegund</th><th data-sort="name">Nafn</th><th data-sort="tier">Þrep</th><th>Áskriftir</th><th data-sort="reports">Skýrslur</th><th data-sort="verified">Staðf.</th><th data-sort="created">Skráð</th><th></th></tr></thead>
            <tbody></tbody>
          </table>
        </div>
      </section>

      <section class="stj-grid2">
        <div class="stj-block"><h2>💳 Virkar áskriftir</h2><div id="stj-subs" class="stj-kv"></div></div>
        <div class="stj-block"><h2>📄 Seldar skýrslur</h2><div id="stj-reports" class="stj-kv"></div></div>
      </section>

      <section class="stj-block">
        <h2>⏳ Rennur út — endurnýjunarvakt</h2>
        <div id="stj-expiring" class="stj-kv"></div>
      </section>

      <section class="stj-block">
        <h2>🕐 Nýjustu skýrslukaup</h2>
        <div id="stj-recent" class="stj-kv"></div>
      </section>

      <section class="stj-block">
        <h2>🧾 Aðgerðaskrá <span style="color:var(--faint);font-size:12px;font-weight:400">— síðustu admin-aðgerðir</span></h2>
        <div id="stj-audit" class="stj-kv"></div>
      </section>

      <section class="stj-block" id="stj-ops-wrap" hidden>
        <h2>🤖 Rekstur stjórnborðsins <span class="w-sub" id="stj-ops-fresh" style="color:var(--faint);font-size:12px;font-weight:400"></span></h2>
        <div class="stj-cards" id="stj-ops-cards" style="margin-bottom:16px"></div>
        <div class="stj-grid2">
          <div><h3 style="font-size:13px;color:var(--muted);margin:0 0 8px">✅ Bíður samþykktar</h3><div id="stj-appr" class="stj-kv"></div></div>
          <div><h3 style="font-size:13px;color:var(--muted);margin:0 0 8px">🛟 Opnar hjálparbeiðnir</h3><div id="stj-tickets" class="stj-kv"></div></div>
        </div>
      </section>

      <p class="stj-note">🤖 AI-stjórnendurnir (COO/CFO/CMO o.fl.) keyra á Node-hýsli, lesa þessa sömu gagnagrunn (raun-tekjur/notendur) og ýta rekstrar-samantekt hingað á 5 mín fresti. Samþykktir, tickets og herferðir eru afgreidd í sjálfu stjórnborðinu.</p>
    </div>
  </main>

  <style>
    .stj-wrap { max-width: 1100px; margin: 0 auto; padding: 22px 16px 60px; }
    .stj-gate { padding: 60px 20px; text-align: center; color: var(--muted); font-size: 15px; }
    .stj-head { display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; margin-bottom: 18px; }
    .stj-head h1 { font-size: 24px; margin: 0; color: var(--ink); }
    .stj-sub { color: var(--faint); font-size: 13px; }
    .stj-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; margin-bottom: 24px; }
    .stj-card { background: var(--surface); border: 1px solid var(--line); border-radius: 12px; padding: 14px 16px; }
    .stj-card .n { font-size: 26px; font-weight: 800; color: var(--gold); font-variant-numeric: tabular-nums; }
    .stj-card .l { font-size: 12px; color: var(--muted); margin-top: 2px; }
    .stj-card .s { font-size: 11px; color: var(--faint); margin-top: 4px; }
    .stj-block { background: var(--surface); border: 1px solid var(--line); border-radius: 12px; padding: 16px 18px; margin-bottom: 20px; }
    .stj-block h2 { font-size: 15px; margin: 0 0 12px; color: var(--ink); }
    .stj-grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
    @media (max-width: 640px) { .stj-grid2 { grid-template-columns: 1fr; } }
    .stj-tablewrap { overflow-x: auto; }
    .stj-table { width: 100%; border-collapse: collapse; font-size: 13px; }
    .stj-table th { text-align: left; color: var(--faint); font-size: 11px; text-transform: uppercase; letter-spacing: .04em; padding: 6px 10px; border-bottom: 1px solid var(--line); white-space: nowrap; }
    .stj-table td { padding: 8px 10px; border-bottom: 1px solid var(--line); color: var(--ink); white-space: nowrap; }
    .stj-table tr:hover td { background: var(--panel); }
    .stj-badge { display: inline-block; padding: 1px 7px; border-radius: 6px; font-size: 11px; font-weight: 600; background: var(--panel); color: var(--muted); margin: 0 2px 0 0; }
    .stj-badge.tier { background: rgba(246,177,59,.16); color: var(--gold); }
    .stj-badge.ok { color: #46e08a; }
    .stj-badge.admin { background: rgba(246,177,59,.16); color: var(--gold); }
    .stj-badge.test { background: rgba(150,160,175,.18); color: var(--faint); }
    .stj-test td { opacity: .5; }
    .stj-test:hover td { opacity: .8; }
    .stj-toolbar { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; margin-bottom: 12px; }
    .stj-search { flex: 1; min-width: 200px; background: var(--panel); border: 1px solid var(--line); border-radius: 8px; padding: 8px 12px; color: var(--ink); font: inherit; font-size: 13px; }
    .stj-filters { display: flex; gap: 6px; flex-wrap: wrap; }
    .stj-chip { background: var(--panel); border: 1px solid var(--line); border-radius: 999px; padding: 5px 12px; font-size: 12.5px; color: var(--muted); cursor: pointer; }
    .stj-chip.on { background: rgba(246,177,59,.16); border-color: rgba(246,177,59,.4); color: var(--gold); }
    .stj-table th[data-sort] { cursor: pointer; user-select: none; }
    .stj-table th[data-sort]:hover { color: var(--ink); }
    .stj-mng-btn { background: var(--panel); border: 1px solid var(--line); border-radius: 7px; padding: 3px 9px; cursor: pointer; color: var(--muted); font-size: 13px; }
    .stj-mng-btn:hover { color: var(--ink); border-color: var(--gold); }
    .stj-mng-row td { background: var(--panel); padding: 0; }
    .stj-mng { padding: 14px 16px; display: grid; gap: 16px; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); }
    .stj-mng h4 { margin: 0 0 8px; font-size: 11px; text-transform: uppercase; letter-spacing: .04em; color: var(--faint); }
    .stj-mng .row { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
    .stj-mng label.svc { display: flex; align-items: center; gap: 6px; font-size: 13px; color: var(--ink); white-space: nowrap; }
    .stj-mng .act { background: var(--surface); border: 1px solid var(--line); border-radius: 7px; padding: 6px 11px; cursor: pointer; color: var(--ink); font: inherit; font-size: 12.5px; }
    .stj-mng .act:hover { border-color: var(--gold); }
    .stj-mng .act.done { border-color: #46e08a; color: #46e08a; }
    .stj-mng select, .stj-mng input[type=number] { background: var(--surface); border: 1px solid var(--line); border-radius: 6px; padding: 5px 8px; color: var(--ink); font: inherit; font-size: 13px; }
    .stj-empty-row td { color: var(--faint); text-align: center; padding: 20px; }
    .stj-heilsa { display: grid; grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); gap: 2px 18px; }
    .stj-h-row { display: flex; align-items: center; gap: 8px; font-size: 13px; padding: 4px 0; }
    .stj-h-dot { width: 9px; height: 9px; border-radius: 50%; flex: none; }
    .stj-h-dot.ok { background: #46e08a; } .stj-h-dot.warn { background: #f6b13b; } .stj-h-dot.bad { background: #ef6a6a; } .stj-h-dot.unk { background: var(--faint); }
    .stj-h-row .l { color: var(--ink); flex: 1; }
    .stj-h-row .a { color: var(--muted); font-variant-numeric: tabular-nums; font-size: 12px; margin-left: auto; padding-left: 14px; white-space: nowrap; }
    .stj-refresh { background: var(--panel); border: 1px solid var(--line); border-radius: 8px; padding: 6px 12px; color: var(--ink); font: inherit; font-size: 12.5px; cursor: pointer; white-space: nowrap; }
    .stj-refresh:hover { border-color: var(--gold); color: var(--gold); }
    .stj-refresh:disabled { opacity: .6; cursor: default; }
    .stj-h-row.bad .a { color: #ef6a6a; }
    .stj-heilsa-cov { display: flex; gap: 18px; flex-wrap: wrap; margin-bottom: 12px; font-size: 13px; color: var(--muted); }
    .stj-heilsa-cov b { color: var(--gold); }
    .stj-fn-row { display: flex; align-items: center; gap: 14px; margin: 7px 0; font-size: 13px; }
    .stj-fn-l { width: 84px; color: var(--muted); flex: none; }
    .stj-fn-bar { flex: 1; height: 14px; background: var(--panel); border-radius: 7px; overflow: hidden; }
    .stj-fn-bar i { display: block; height: 100%; background: var(--gold); border-radius: 7px; }
    .stj-fn-n { width: 86px; text-align: right; color: var(--ink); font-variant-numeric: tabular-nums; flex: none; padding-left: 10px; }
    .stj-fn-n small { color: var(--faint); }
    .stj-type { background: var(--panel); color: var(--ink); border: 1px solid var(--line); border-radius: 6px; padding: 3px 6px; font: inherit; font-size: 12.5px; }
    .stj-type.stj-type-flash { outline: 2px solid #46e08a; }
    .stj-kv-row { display: flex; justify-content: space-between; gap: 14px; padding: 6px 0; border-bottom: 1px solid var(--line); font-size: 13.5px; color: var(--ink); }
    .stj-kv-row b { color: var(--gold); font-variant-numeric: tabular-nums; }
    .stj-kv-empty { color: var(--faint); font-size: 13px; }
    .stj-note { color: var(--faint); font-size: 12.5px; line-height: 1.6; margin-top: 8px; }
    .stj-denied { padding: 60px 20px; text-align: center; }
    .stj-denied h1 { font-size: 20px; color: var(--ink); }
    .stj-denied p { color: var(--muted); }
    .stj-denied a { color: var(--gold); }
  </style>

  <script>
    import { loadUser } from '../lib/auth.js';
    const $ = (id) => document.getElementById(id);
    const esc = (s) => String(s == null ? '' : s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
    const dIS = (ts) => { try { const d = new Date(ts * 1000); return d.getUTCDate() + '.' + (d.getUTCMonth() + 1) + '. ' + String(d.getUTCFullYear()).slice(2); } catch (e) { return ''; } };
    const SVC = { kvoti: 'Kvótavaktin', utbod: 'Útboðsvaktin', frettir: 'Fjölmiðlavakt', fasteign: 'Fasteignavakt', thingskyrslur: 'Þingmannaskýrslur' };
    const REP = { fyrirtaeki: 'Fyrirtækjaskýrslur', eigendur: 'Eigendaskýrslur', areidanleiki: 'Áreiðanleikamat', fasteign: 'Fasteignamöt', thingmadur: 'Þingmannaskýrslur' };

    function card(n, l, s) { return `<div class="stj-card"><div class="n">${n}</div><div class="l">${l}</div>${s ? '<div class="s">' + s + '</div>' : ''}</div>`; }
    // Tegund-veljari (kerfisstjóri/notandi (frítt)/notandi/nemandi) — x.free/x.nemandi koma úr adminOverviewHandler (A6).
    function typeSelect(x) {
      const t = x.admin ? 'admin' : (x.free ? 'free' : (x.nemandi ? 'nemandi' : 'user'));
      const opt = (v, label) => `<option value="${v}"${t === v ? ' selected' : ''}>${label}</option>`;
      return `<select class="stj-type" data-id="${x.id}" data-cur="${t}">${opt('admin', 'Kerfisstjóri')}${opt('free', 'notandi (frítt)')}${opt('user', 'notandi')}${opt('nemandi', 'Nemandi')}</select>`;
    }

    async function boot() {
      const main = document.querySelector('main[data-pg="stjorn"]'); if (!main) return;
      const u = await loadUser().catch(() => null);
      const gate = $('stj-gate');
      if (!u || !u.loggedIn) { gate.innerHTML = '<div class="stj-denied"><h1>Innskráning</h1><p>Skráðu þig inn til að opna stjórnborðið.</p><p><a href="/innskra/?redirect_to=' + encodeURIComponent(location.href) + '">Skrá inn →</a></p></div>'; return; }
      if (!u.isAdmin) { gate.innerHTML = '<div class="stj-denied"><h1>Aðgangur bannaður</h1><p>Stjórnborðið er aðeins fyrir stjórnendur.</p><p><a href="/mitt-svaedi/">Fara á Mitt svæði →</a></p></div>'; return; }
      const [ov, burst, heilsa] = await Promise.all([
        fetch('/api/admin/overview', { credentials: 'include' }).then((r) => r.json()).catch(() => null),
        fetch('/api/u/burst', { credentials: 'include' }).then((r) => r.json()).catch(() => null),
        fetch('/gogn/heilsa.json?t=' + Date.now(), { cache: 'no-store' }).then((r) => (r.ok ? r.json() : null)).catch(() => null),
      ]);
      if (!ov || !ov.ok) { gate.innerHTML = '<div class="stj-denied"><h1>Villa</h1><p>Náði ekki í yfirlit.</p></div>'; return; }
      gate.hidden = true; $('stj-body').hidden = false;
      const s = ov.stats;
      // spjöld
      const kr = (n) => (n || 0).toLocaleString('is-IS') + ' kr';
      $('stj-cards').innerHTML =
        card(s.total, 'Notendur', '+' + s.new7 + ' síðustu 7 daga' + (s.excludedTest ? ' · ' + s.excludedTest + ' prufa ekki talin' : '')) +
        card(kr(s.mrr), 'Áætl. mánaðartekjur', s.tierUsers + ' þrep · ' + s.activeSubs + ' þjónustur') +
        card(kr(s.reportRevenue), 'Skýrslutekjur (alls)', s.reportsTotal + ' seldar (990 kr)') +
        card(s.watchers + ' / ' + s.digestSubs, 'Virkir notendur', 'með vakt / vikuyfirlit') +
        (s.expiring ? card(s.expiring.d30 || 0, 'Rennur út (30d)', (s.expiring.d7 || 0) + ' innan 7 daga' + (s.churn && s.churn.renewalRate != null ? ' · ' + s.churn.renewalRate + '% endurnýjun' : '')) : '') +
        card(s.verified, 'Staðfest netföng', s.admins + ' stjórnendur') +
        (burst && burst.available ? card((burst.week.pageviews || 0).toLocaleString('is-IS'), 'Jaðar-beiðnir (7d)', '⚠ öll umferð m/vélmennum — ekki manntalning') : '');
      // 🩺 Gagnaheilsa — ferskleiki lykil-veita + þekja (úr /gogn/heilsa.json; stale = pípa brotin)
      (function () {
        const H = heilsa, wrap = $('stj-heilsa-wrap');
        if (!wrap) return;
        if (!H || !Array.isArray(H.freshness)) { wrap.hidden = true; return; }
        wrap.hidden = false;
        const nowMs = Date.now();
        const bucket = (iso, maxAge) => {
          if (!iso) return { cls: 'unk', txt: 'óþekkt' };
          const t = Date.parse(iso); if (isNaN(t)) return { cls: 'unk', txt: 'óþekkt' };
          const age = nowMs - t, h = age / 3600000;
          return { cls: age > maxAge ? 'bad' : (age > maxAge * 0.6 ? 'warn' : 'ok'), txt: h < 1 ? 'nýtt' : h < 36 ? Math.round(h) + ' klst' : Math.round(h / 24) + ' d' };
        };
        const bad = H.freshness.filter((f) => bucket(f.iso, f.maxAge).cls === 'bad').length;
        $('stj-heilsa-fresh').textContent = bad ? '· ⚠ ' + bad + ' veitu' + (bad > 1 ? 'r' : '') + ' úreltar' : '· allt ferskt ✓';
        $('stj-heilsa').innerHTML = H.freshness.map((f) => {
          const b = bucket(f.iso, f.maxAge);
          return `<div class="stj-h-row ${b.cls}"><span class="stj-h-dot ${b.cls}"></span><span class="l">${esc(f.label)}</span><span class="a">${b.txt}</span></div>`;
        }).join('');
        const cov = H.coverage || {}, parts = [];
        if (cov.arsreikningar) parts.push('Ársreikningar: <b>' + cov.arsreikningar.pct + '%</b> með lykiltölur (' + cov.arsreikningar.withKpi + '/' + cov.arsreikningar.total + ')' + (cov.arsreikningar.scanned ? ' · ' + cov.arsreikningar.scanned + ' skönnuð' : ''));
        if (cov.eigendur) parts.push('Eigendaskýrslur byggðar: <b>' + cov.eigendur.total + '</b>');
        if (H.builtAt) { const bm = Math.round((nowMs - Date.parse(H.builtAt)) / 60000); parts.push('<span style="color:var(--faint)">mælt fyrir ' + (bm < 60 ? Math.max(0, bm) + ' mín' : Math.round(bm / 60) + ' klst') + '</span>'); }
        $('stj-heilsa-cov').innerHTML = parts.map((p) => '<span>' + p + '</span>').join('');
      })();
      // 🔄 „Sækja fersk gögn" — ræsir refresh-data pípuna (worker → GitHub repository_dispatch)
      (function () {
        const btn = $('stj-refresh'); if (!btn || btn.dataset.wired) return; btn.dataset.wired = '1';
        btn.addEventListener('click', async () => {
          if (!confirm('Ræsa gagna-uppfærslu núna? Tekur ~15–30 mín; veiturnar ferskast jafnóðum.')) return;
          const orig = btn.textContent; btn.disabled = true; btn.textContent = 'Ræsi…';
          const r = await fetch('/api/admin/refresh', { method: 'POST', credentials: 'include' }).then((x) => x.json()).catch(() => null);
          if (r && r.ok) { btn.textContent = '✓ Keyrsla hafin'; setTimeout(() => { btn.textContent = orig; btn.disabled = false; }, 10000); }
          else { btn.textContent = (r && r.error === 'unconfigured') ? 'Vantar GitHub-token' : 'Villa — reyndu aftur'; setTimeout(() => { btn.textContent = orig; btn.disabled = false; }, 4000); }
        });
      })();
      // 📈 Vöxtur — MRR-þróun (sparkline; safnast daglega) + umbreytingar-trekt
      (function () {
        const wrap = $('stj-voxtur-wrap'); if (!wrap) return;
        const hist = ov.mrrHistory || [], f = s.funnel;
        wrap.hidden = false;
        const el = $('stj-mrr-chart');
        if (hist.length >= 2) {
          const vals = hist.map((p) => p.mrr || 0), mx = Math.max.apply(null, vals.concat(1)), mn = Math.min.apply(null, vals.concat(0)), rng = (mx - mn) || 1;
          const W = 260, Hh = 56;
          const pts = vals.map((v, i) => (i / (vals.length - 1) * W).toFixed(1) + ',' + (Hh - (v - mn) / rng * Hh).toFixed(1)).join(' ');
          const first = vals[0], last = vals[vals.length - 1], chg = first ? Math.round((last - first) / first * 100) : 0;
          el.innerHTML = '<div style="font-size:24px;font-weight:800;color:var(--gold);font-variant-numeric:tabular-nums">' + last.toLocaleString('is-IS') + ' kr</div>'
            + '<div style="font-size:12px;color:var(--muted);margin-bottom:8px">' + hist.length + ' daga saga · ' + (chg >= 0 ? '+' : '') + chg + '%</div>'
            + '<svg viewBox="0 0 ' + W + ' ' + Hh + '" width="100%" height="56" preserveAspectRatio="none"><polyline points="' + pts + '" fill="none" stroke="#f6b13b" stroke-width="2" vector-effect="non-scaling-stroke"/></svg>';
        } else {
          el.innerHTML = '<div style="font-size:24px;font-weight:800;color:var(--gold)">' + (s.mrr || 0).toLocaleString('is-IS') + ' kr</div><div style="font-size:12px;color:var(--faint);margin-top:4px">Þróun byrjar að safnast — eitt gildi á dag við hverja heimsókn.</div>';
        }
        if (f) {
          const top = f.signups || 1;
          $('stj-funnel').innerHTML = [['Nýskráðir', f.signups], ['Staðfestir', f.verified], ['Virkjaðir', f.activated], ['Borgandi', f.paying]].map((r) => {
            const pct = Math.round((r[1] || 0) / top * 100);
            return '<div class="stj-fn-row"><span class="stj-fn-l">' + r[0] + '</span><span class="stj-fn-bar"><i style="width:' + pct + '%"></i></span><span class="stj-fn-n">' + (r[1] || 0) + ' <small>' + pct + '%</small></span></div>';
          }).join('');
        }
      })();
      // ── notendur: leit + síun + röðun + stjórn-spjald per notanda ──
      const utable = $('stj-users'), utbody = utable.querySelector('tbody');
      const SVC_LIST = ['kvoti', 'utbod', 'frettir', 'fasteign', 'thingskyrslur'];
      const TIERS = [['', '— ekkert —'], ['grunnur', 'Grunnur'], ['fyrirtaeki', 'Fyrirtæki'], ['fyrirtaeki_plus', 'Fyrirtæki+']];
      const ust = utable.__st = utable.__st || { sort: { key: 'id', dir: 1 }, filter: 'all', q: '' };
      ust.all = ov.users;
      $('stj-ucount').textContent = ust.all.length;
      const passFilter = (x) => ust.filter === 'paying' ? (!!x.tier || (x.subs && x.subs.length)) : ust.filter === 'unverified' ? !x.verified : ust.filter === 'sub' ? (x.subs && x.subs.length > 0) : ust.filter === 'admin' ? x.admin : true;
      const passQuery = (x) => !ust.q || (String(x.email || '') + ' ' + String(x.name || '') + ' ' + String(x.kt || '')).toLowerCase().includes(ust.q);
      const sortUsers = (list) => list.slice().sort((a, b) => { const k = ust.sort.key, d = ust.sort.dir; let va = a[k], vb = b[k]; if (k === 'tier') { va = va || ''; vb = vb || ''; } return typeof va === 'string' ? d * va.localeCompare(vb || '') : d * ((va || 0) - (vb || 0)); });
      function mngPanel(x) {
        const uAudit = (ov.audit || []).filter((a) => a.target === x.id).slice(0, 5);
        const tierOpts = TIERS.map(([v, l]) => `<option value="${v}"${(x.tier || '') === v ? ' selected' : ''}>${l}</option>`).join('');
        const svcBoxes = SVC_LIST.map((sv) => `<label class="svc"><input type="checkbox" data-svc="${sv}"${(x.subs || []).indexOf(sv) >= 0 ? ' checked' : ''}> ${esc(SVC[sv] || sv)}</label>`).join('');
        const supportBtns = (x.verified ? '' : '<button type="button" class="act" data-act="verify">Staðfesta netfang</button><button type="button" class="act" data-act="resend_verify">Endursenda staðf.</button>')
          + '<button type="button" class="act" data-act="reset_pw">Senda endurstillingu</button>';
        return `<tr class="stj-mng-row" data-mng="${x.id}" hidden><td colspan="10"><div class="stj-mng">`
          + `<div><h4>Þrep</h4><div class="row"><select data-act="tier">${tierOpts}</select><input type="number" data-months min="1" max="60" value="12" style="width:58px" title="mánuðir"><span style="color:var(--faint);font-size:12px">mán</span></div></div>`
          + `<div><h4>Þjónustu-áskriftir</h4><div class="row">${svcBoxes}</div></div>`
          + `<div><h4>Skýrslu-kvóti</h4><div class="row"><button type="button" class="act" data-act="reset_reports">Núllstilla mánaðar-kvóta</button></div></div>`
          + `<div><h4>Stuðningur</h4><div class="row">${supportBtns}</div></div>`
          + `<div><h4>Prufu-aðgangur</h4><div class="row"><label class="svc"><input type="checkbox" data-act="test"${x.test ? ' checked' : ''}> Ekki talinn með í samantekt</label></div></div>`
          + `<div style="grid-column:1/-1"><h4>Innri nóta</h4><textarea data-note rows="2" placeholder="Innri athugasemd (sést aðeins stjórnendum)…" style="width:100%;resize:vertical;background:var(--surface);border:1px solid var(--line);border-radius:6px;color:var(--ink);font:inherit;font-size:13px;padding:6px 8px">${esc((ov.notes || {})[x.id] || '')}</textarea><div class="row" style="margin-top:6px"><button type="button" class="act" data-act="note">Vista nótu</button></div></div>`
          + (uAudit.length ? `<div style="grid-column:1/-1"><h4>Nýlegar aðgerðir á þessum notanda</h4><div style="font-size:12px;color:var(--muted);line-height:1.7">${uAudit.map((a) => '<b style="color:var(--ink);font-weight:600">' + esc(a.action) + '</b>' + (a.detail ? ' ' + esc(a.detail) : '') + ' · ' + esc(a.by) + ' · ' + dIS(a.ts)).join('<br>')}</div></div>` : '')
          + `</div></td></tr>`;
      }
      function renderUsers() {
        const list = sortUsers(ust.all.filter((x) => passFilter(x) && passQuery(x)));
        if (!list.length) { utbody.innerHTML = '<tr class="stj-empty-row"><td colspan="10">Enginn notandi passar við leit/síu.</td></tr>'; return; }
        utbody.innerHTML = list.map((x) =>
          `<tr${x.test ? ' class="stj-test"' : ''} data-uid="${x.id}"><td>${x.id}</td><td>${esc(x.email)}${x.admin ? ' <span class="stj-badge admin">admin</span>' : ''}${x.test ? ' <span class="stj-badge test">prufa · ekki talin</span>' : ''}</td><td>${typeSelect(x)}</td><td>${esc(x.name)}</td>`
          + `<td>${x.tier ? '<span class="stj-badge tier">' + esc(x.tier) + '</span>' : '—'}</td>`
          + `<td>${x.subs.length ? x.subs.map((sv) => '<span class="stj-badge">' + esc(SVC[sv] || sv) + '</span>').join('') : '—'}</td>`
          + `<td>${x.reports || '—'}</td><td>${x.verified ? '<span class="stj-badge ok">✓</span>' : '—'}</td><td>${dIS(x.created)}</td>`
          + `<td><button type="button" class="stj-mng-btn" data-toggle="${x.id}" title="Stjórna notanda">⚙</button></td></tr>`
          + mngPanel(x)
        ).join('');
      }
      ust.render = renderUsers;
      renderUsers();

      // Víra EINU SINNI (tbody endurgerist í boot(), en <table>-hnúturinn + st lifa → forðast tvöfalt viðhengi).
      if (!utable.dataset.wired) {
        utable.dataset.wired = '1';
        const S = () => utable.__st;
        const post = (body) => fetch('/api/admin/user', { method: 'POST', credentials: 'include', headers: { 'content-type': 'application/json' }, body: JSON.stringify(body) }).then((r) => r.json()).catch(() => null);
        const okFlash = (el, r) => { if (!r || !r.ok) { alert('Villa kom upp — reyndu aftur.'); return false; } el.classList.add('done'); setTimeout(() => el.classList.remove('done'), 1100); return true; };
        $('stj-search').addEventListener('input', (e) => { S().q = e.target.value.trim().toLowerCase(); S().render(); });
        $('stj-filters').addEventListener('click', (e) => { const b = e.target.closest('.stj-chip'); if (!b) return; S().filter = b.dataset.f; $('stj-filters').querySelectorAll('.stj-chip').forEach((c) => c.classList.toggle('on', c === b)); S().render(); });
        utable.querySelectorAll('th[data-sort]').forEach((th) => th.addEventListener('click', () => { const k = th.dataset.sort, s = S(); s.sort = { key: k, dir: s.sort.key === k ? -s.sort.dir : 1 }; s.render(); }));
        // smellir: opna/loka stjórn-spjaldi + hnappa-aðgerðir (verify/resend/reset_pw/reset_reports)
        utable.addEventListener('click', async (e) => {
          const tg = e.target.closest('[data-toggle]');
          if (tg) { const row = utable.querySelector('tr[data-mng="' + tg.dataset.toggle + '"]'); if (row) row.hidden = !row.hidden; return; }
          const act = e.target.closest('.act[data-act]');
          if (!act) return;
          const mng = act.closest('.stj-mng-row'); const id = +mng.dataset.mng;
          const body = { id, action: act.dataset.act };
          if (act.dataset.act === 'note') { const ta = mng.querySelector('textarea[data-note]'); body.note = ta ? ta.value : ''; }
          const orig = act.textContent; act.disabled = true; act.textContent = '…';
          const r = await post(body);
          act.disabled = false; act.textContent = orig; okFlash(act, r);
        });
        // breytingar: tegund-veljari (set-type) + þrep + þjónustu-reitir + prufu-reitur
        utable.addEventListener('change', async (e) => {
          const type = e.target.closest('select.stj-type');
          if (type) {
            const prev = type.dataset.cur || type.value; type.disabled = true;
            const r = await fetch('/api/admin/set-type', { method: 'POST', credentials: 'include', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ id: +type.dataset.id, type: type.value }) }).then((res) => res.json()).catch(() => null);
            type.disabled = false;
            if (r && r.ok) { type.dataset.cur = type.value; type.classList.add('stj-type-flash'); setTimeout(() => type.classList.remove('stj-type-flash'), 900); }
            else if (r && r.error === 'last-admin') { alert('Get ekki fjarlægt síðasta admin'); type.value = prev; }
            else { alert('Villa kom upp — reyndu aftur.'); type.value = prev; }
            return;
          }
          const mng = e.target.closest('.stj-mng-row'); if (!mng) return;
          const id = +mng.dataset.mng, months = +mng.querySelector('[data-months]').value || 12;
          const tierSel = e.target.closest('select[data-act="tier"]');
          if (tierSel) { okFlash(tierSel, await post({ id, action: 'tier', tier: tierSel.value, months })); return; }
          const svc = e.target.closest('input[data-svc]');
          if (svc) { const r = await post({ id, action: 'service', service: svc.dataset.svc, on: svc.checked, months }); if (!r || !r.ok) { alert('Villa kom upp — reyndu aftur.'); svc.checked = !svc.checked; } return; }
          const test = e.target.closest('input[data-act="test"]');
          if (test) { const r = await post({ id, action: 'test', on: test.checked }); if (!r || !r.ok) { alert('Villa kom upp — reyndu aftur.'); test.checked = !test.checked; } return; }
        });
      }
      // áskriftir
      const subEntries = Object.entries(s.subsByService);
      $('stj-subs').innerHTML = subEntries.length ? subEntries.map(([k, v]) => `<div class="stj-kv-row"><span>${esc(SVC[k] || k)}</span><b>${v}</b></div>`).join('') : '<div class="stj-kv-empty">Engar virkar áskriftir enn.</div>';
      // skýrslur
      const repEntries = Object.entries(s.reportsByType);
      $('stj-reports').innerHTML = repEntries.length ? repEntries.map(([k, v]) => `<div class="stj-kv-row"><span>${esc(REP[k] || k)}</span><b>${v}</b></div>`).join('') : '<div class="stj-kv-empty">Engar seldar skýrslur enn.</div>';
      // nýjustu skýrslukaup
      const rec = ov.recentReports || [];
      $('stj-recent').innerHTML = rec.length ? rec.map((r) => {
        const t = String(r.key || '').split(':')[0];
        return `<div class="stj-kv-row"><span>${esc(REP[t] || t)} <span style="color:var(--faint)">· ${esc(r.email || '—')}</span></span><b style="font-weight:600;color:var(--muted)">${dIS(r.granted)}</b></div>`;
      }).join('') : '<div class="stj-kv-empty">Engin skýrslukaup enn.</div>';

      // ⏳ Endurnýjunarvakt — áskriftir/þrep sem renna út næstu 30 daga (rautt ≤7 daga)
      const exp = ov.expiringList || [];
      $('stj-expiring').innerHTML = exp.length ? exp.map((e) => {
        const days = Math.max(0, Math.round((e.until - ov.now) / 86400));
        const what = e.kind === 'tier' ? ('Þrep: ' + esc(e.what || '')) : esc(SVC[e.what] || e.what);
        return `<div class="stj-kv-row"><span>${what} <span style="color:var(--faint)">· ${esc(e.email || '—')}</span></span><b style="font-weight:600;color:${days <= 7 ? '#f6b13b' : 'var(--muted)'}">eftir ${days} d</b></div>`;
      }).join('') : '<div class="stj-kv-empty">Ekkert rennur út næstu 30 daga. 🎉</div>';

      // 🧾 Aðgerðaskrá — síðustu admin-aðgerðir (audit)
      const aud = ov.audit || [];
      const emailById = (id) => { const uu = (ov.users || []).find((x) => x.id === id); return uu ? uu.email : ('#' + id); };
      $('stj-audit').innerHTML = aud.length ? aud.slice(0, 30).map((a) => {
        const tgt = a.target ? esc(emailById(a.target)) : '';
        return `<div class="stj-kv-row"><span><b style="font-weight:600;color:var(--ink)">${esc(a.action)}</b>${a.detail ? ' <span style="color:var(--faint)">' + esc(a.detail) + '</span>' : ''}${tgt ? ' → ' + tgt : ''} <span style="color:var(--faint)">· ${esc(a.by)}</span></span><b style="font-weight:600;color:var(--muted)">${dIS(a.ts)}</b></div>`;
      }).join('') : '<div class="stj-kv-empty">Engar skráðar aðgerðir enn.</div>';

      // 🤖 Rekstur stjórnborðsins (synced úr Node-appinu)
      const st = ov.stjorn;
      if (st) {
        $('stj-ops-wrap').hidden = false;
        const mins = Math.round((Date.now() / 1000 - (st.syncedAt || 0)) / 60);
        $('stj-ops-fresh').textContent = '· uppfært fyrir ' + (mins < 1 ? 'augnabliki' : mins + ' mín') + ' síðan';
        const led = st.ledger || {};
        $('stj-ops-cards').innerHTML =
          card((st.approvalsPending || []).length, 'Bíða samþykktar', '') +
          card((st.ticketsOpen || []).length, 'Opnar hjálparbeiðnir', '') +
          card((st.campaigns || []).length, 'Herferðir', (st.todosOpen || 0) + ' opin verk') +
          card(kr(led.stada || 0), 'Sjóðstaða (ledger)', kr(led.sala || 0) + ' sala · ' + kr(led.kostnadur || 0) + ' kostn.');
        const appr = st.approvalsPending || [];
        $('stj-appr').innerHTML = appr.length ? appr.slice(0, 10).map((a) => `<div class="stj-kv-row"><span>${esc(a.txt || a.kind || ('#' + a.id))}</span><b style="font-weight:600;color:var(--muted)">${esc(a.kind || '')}</b></div>`).join('') : '<div class="stj-kv-empty">Ekkert bíður samþykktar. 🎉</div>';
        const tix = st.ticketsOpen || [];
        $('stj-tickets').innerHTML = tix.length ? tix.slice(0, 10).map((t) => `<div class="stj-kv-row"><span>${esc(t.txt || t.who || ('#' + t.id))} <span style="color:var(--faint)">· ${esc(t.who || '')}</span></span><b style="font-weight:600;color:var(--gold)">${esc(t.stada || '')}</b></div>`).join('') : '<div class="stj-kv-empty">Engar opnar hjálparbeiðnir.</div>';
      }
    }
    if (document.readyState !== 'loading') boot(); else document.addEventListener('DOMContentLoaded', boot);
    document.addEventListener('astro:page-load', boot);
  </script>
</Layout>
