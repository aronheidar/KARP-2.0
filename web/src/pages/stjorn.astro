          : morgunkvedja({ nu: Math.max(nu, Math.floor(Date.now() / 1000)), sidast: sigrunSidast(), klst: new Date().getHours(), listi: tk.list || [], bida: (gogn.hjalp || []).length + (gogn.bidur || []).length });
