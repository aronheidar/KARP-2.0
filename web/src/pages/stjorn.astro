        $('stj-spjald').querySelector('.stj-spjald-haus').insertAdjacentHTML('afterend',
          '<p class="stj-kvedja" id="stj-kvedja">' + esc(kvedja) + '</p>'
          + hjalpHtml
          + '<section class="stj-hola stj-vikan" id="stj-sigrun-vika"><h3>Vikan hjá mér</h3><p class="stj-note">Tek saman…</p></section>'
