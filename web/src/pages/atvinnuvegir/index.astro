---
// Atvinnuvegir — yfirlit. Hver hlekkur ber EINA raun-tölu úr sömu gagnaskrá og undirsíðan flytur inn,
// svo spjaldið sé gagnaskjár en ekki nafnalisti (afvélvæðing fasi 4a, 14.9.2026). Hausinn er
// vinstrijafnaður eins og undirsíðurnar fimm: kicker → h1 → inngangur → datainfo, 860px.
import Layout from '../../layouts/Layout.astro';
import SiduHaus from '../../components/SiduHaus.astro';
import { groupThousands } from '@lib/format.mjs';
import VID from '@gogn/vidskipti.json';
import FERD from '@gogn/ferdathjonusta.json';
import LAND from '@gogn/landbunadur.json';
import STOR from '@gogn/storidja.json';
import ORKA from '@gogn/orka.json';
import HUGV from '@gogn/hugverk.json';
import GJ from '@gogn/gjaldthrot.json';
import SKPI from '../../../public/gogn/sector_kpi.json';
import { sectorsFromMap } from '../../lib/atvinnugrein.mjs';

const expItem = (n) => (((VID || {}).EXP || {}).items || []).find((x) => x.name === n) || null;
const sjav = expItem('Sjávarafurðir');
const orkaL = ((ORKA || {}).rows || []).slice(-1)[0] || null;
const nGreinar = sectorsFromMap(SKPI.map).length;   // 82 ÍSAT-lyklar hópast í 65 einkvæm heiti — sama talning og /atvinnugreinar/

// [slóð, heiti, tala, skýring] — tala null fellir töluna en heldur hlekknum (gögn mega vanta).
const subs = [
  ['/atvinnuvegir/sjavarutvegur/', 'Sjávarútvegur', sjav && groupThousands(sjav.value), sjav && 'ma.kr. útflutningur · 2025'],
  ['/atvinnuvegir/ferdathjonusta/', 'Ferðaþjónusta', FERD.kefL && groupThousands(FERD.kefL.v), FERD.kefL && `erlendir farþegar um Keflavík · ${FERD.kefL.t}`],
  ['/atvinnuvegir/landbunadur/', 'Landbúnaður', LAND.valL && groupThousands(LAND.valL.v), LAND.valL && `ma.kr. framleiðsluvirði · ${LAND.valL.y}`],
  ['/atvinnuvegir/storidja/', 'Stóriðja & orka', STOR.alL && groupThousands(Math.round(STOR.alL.al)), STOR.alL && `ma.kr. álútflutningur · ${STOR.alL.y}`],
  ['/orka/', 'Raforka', orkaL && groupThousands(orkaL.total), orkaL && `GWh framleidd · ${orkaL.y}`],
  ['/atvinnuvegir/hugverk/', 'Hugverk & tækni', HUGV.rdL && String(HUGV.rdL.v).replace('.', ',') + '%', HUGV.rdL && `af VLF í rannsóknir og þróun · ${HUGV.rdL.y}`],
  ['/gjaldthrot/', 'Gjaldþrot fyrirtækja', GJ.ytd && GJ.ytd.nu.virk != null && groupThousands(GJ.ytd.nu.virk), GJ.ytd && `gjaldþrot félaga með starfsemi · ${GJ.ytd.heiti}`],
  ['/atvinnugreinar/', 'Fjárhagur per grein', nGreinar ? String(nGreinar) : null, nGreinar ? 'ÍSAT-greinar með viðmið og stærstu félög' : null],
];
---
<Layout title="Atvinnuvegir | Karp" description="Sjávarútvegur, ferðaþjónusta, landbúnaður, stóriðja og hugverkaiðnaður — lykiltölur atvinnuveganna." canonical="https://karp.is/atvinnuvegir/">
  <main data-pg="atvinnuvegir">
    <SiduHaus kicker="Hagvísir Íslands · Atvinnuvegir" titill="Atvinnuvegir"
      tip="Yfirlit atvinnuvega: samsett af Karp úr útflutnings-, veltu- og vinnumarkaðstölum Hagstofunnar. Talan á hverju spjaldi er sú sama og efst á undirsíðunni.">
      <p>Lykiltölur atvinnuveganna — tölur frá Hagstofu um hverja grein. Sjá einnig <a href="/atvinnugreinar/">fjárhag og afkomu per ÍSAT-grein</a> ({nGreinar} greinar með viðmið + stærstu félög).</p>
    </SiduHaus>
    <div class="grid">
      {subs.map(([href, t, v, s]) => (
        <a class="c" href={href}>
          <b>{t}</b>
          {v && <span class="c-v">{v}</span>}
          {s && <span class="c-s">{s}</span>}
        </a>
      ))}
    </div>
  </main>
  <style>
    main { max-width: 860px; margin: 0 auto; padding: 44px 20px 64px; }
    p { color: var(--ink); } p a { color: var(--gold); }
    .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 10px; margin-top: 20px; }
    .c { display: flex; flex-direction: column; gap: 2px; background: rgba(255,255,255,.04); border: 1px solid rgba(255,255,255,.09); border-radius: 12px; padding: 14px 16px; color: var(--ink); text-decoration: none; }
    .c:hover { border-color: var(--gold); }
    .c b { font-size: 14.5px; }
    .c-v { font-size: 26px; font-weight: 700; color: var(--gold); line-height: 1.15; }
    .c-s { font-size: 12px; color: var(--muted); line-height: 1.4; }
  </style>
</Layout>
